# ---- Media storage (blob provider) ------------------------------------------
# UploadThing is the active blob storage provider — no files ever land on
# disk. App name on UploadThing: "central-chatting". See lib/blob-storage/.
UPLOADTHING_TOKEN='eyJhcGlLZXkiOiJza19saXZlXzZkYTQ3YTkyNjdkMzM1NjY1ZTBmNDdiYjZmYjlhNzViM2NiYjQyNGYzMjBlYzA2YTYyOTUxNWZjYTA2NTU2NjkiLCJhcHBJZCI6ImZkNW1sYWZlbGgiLCJyZWdpb25zIjpbInNlYTEiXX0='

# ---- Redis (BullMQ broker) --------------------------------------------------
# localhost:6380 when running `npm run dev` from the host; `redis:6379` (the
# docker service name) when the app runs inside docker.
REDIS_URL="redis://localhost:6380"

# Used as the base URL embedded in outgoing webhook payloads (`_links.*`).
# Set to your public URL in prod so n8n can call back without env juggling.
APP_PUBLIC_URL="http://localhost:3000"

# Browser Socket.io target. Post NestJS migration, Socket.io lives on the api
# process (:4000), not Next.js (:3000). Without this, the browser falls back
# to same-origin and the "Reconnecting…" banner sticks forever.
# Unset in prod when Caddy fronts both ports under the same hostname.

# Server-side target for Next.js' /api/* rewrite proxy. In docker-compose the
# default `http://api:4000` works (container DNS). For host-side dev (npm run
# dev) override to the host-mapped port — the `api` hostname doesn't resolve
# outside the docker network.


# Shared secret for the in-cluster cache-revalidate bridge: NestJS calls
# `POST /api/internal/revalidate` on Next.js when a catalog mutates so the
# data-cache flips instantly instead of waiting out the 60s revalidate
# window. Same value on both processes. Generate fresh per environment:
# `openssl rand -base64 32`. Optional in dev (the time-based revalidate
# still works); required in prod (validateEnv refuses to boot without it).
INTERNAL_BUS_SECRET="XpYoCG+fPc8/6msUXI43YhirZbfVXk1dFljVP2+Ip7g="

# Toggle the in-app `/api/dev/emit` route + the DevTools panel. Must NOT
# be set in production — the dev-emit endpoint lets any authenticated
# user spoof inbound webhook events. Set to "1" only on local dev boxes.
# ENABLE_DEV_TOOLS=1

# Override the per-request timeout for Meta Graph API fetches (ms).
# Default 15000. Bump only if you're seeing legitimate Meta-side slowness.
# META_FETCH_TIMEOUT_MS=15000

# --- appended by scripts/local-deploy-imitate.sh ---
NODE_ENV=production
INTERNAL_API_URL=http://api:4000
WEB_INTERNAL_URL=http://app:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
