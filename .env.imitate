# Local dev environment.
#
# `docker compose up -d postgres` is the minimum to run the app dev server
# against. Meta Cloud API is reached over the public internet, so no
# additional services are needed locally.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_DB=ccp
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Used by Prisma. localhost:5433 when running `npm run dev` from the host
# (5433 is the docker postgres mapped port — see docker-compose.yml);
# `postgres:5432` (the docker service name) when the app runs inside docker.
#
# NOTE: connection pooling is owned by the pg.Pool in code (Prisma 7 driver
# adapter @prisma/adapter-pg), NOT the URL. `connection_limit` / `pool_timeout`
# query params are IGNORED when an adapter is supplied — tune the pool via
# `max` in apps/api/src/db/db.service.ts (25) and apps/web/src/lib/db.ts (10).
DATABASE_URL="postgresql://app:app@localhost:5433/ccp?schema=public"

# ---- App --------------------------------------------------------------------
APP_PORT=3000
# Public origin of the app. Better Auth signs session cookies bound to this
# origin and uses it for the CSRF / trustedOrigins check on signin endpoints.
# Set to the real HTTPS URL in prod.
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="XpYoCG+fPc8/6msUXI43YhirZbfVXk1dFljVP2+Ip7g="
# Generated 2026-05-16 — used by lib/crypto/envelope.ts for at-rest encryption
# of per-team Meta secrets. See .env.example for rotation caveats.
ENCRYPTION_KEY="XpYoCG+fPc8/6msUXI43YhirZbfVXk1dFljVP2+Ip7g="


# ---- Meta WhatsApp Cloud API ------------------------------------------------
# META_VERIFY_TOKEN="20eaecbe5fe911716ef4e1eb2791eac3"
