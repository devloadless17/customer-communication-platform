# Copy to .env and fill in values for local dev.
#
# `docker compose up -d postgres` is the minimum to run the app dev server
# against. Meta Cloud API is reached over the public internet — no other
# services run locally.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_DB=ccp
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Used by Prisma. localhost:5433 when running `npm run dev` from the host
# (5433 is the docker postgres mapped port — see docker-compose.yml);
# `postgres:5432` (the docker service name) when the app runs inside docker.
#
# Connection pooling is owned by the pg.Pool in code (Prisma 7 driver adapter
# @prisma/adapter-pg), NOT the URL. `connection_limit` / `pool_timeout` query
# params are IGNORED when an adapter is supplied. Tune the pool via `max` in:
#   - apps/api/src/db/db.service.ts  (max: 50 — REST + Socket.io + workers)
#   - apps/web/src/lib/db.ts         (max: 10 — RSC reads + auth only)
# Two processes total → 60 max conns, under Postgres max_connections=120
# (compose raises it from the default 100). Scaling to a second api instance pushes the
# ceiling — bump those `max` values and Postgres max_connections together.
#
# Single pool per process: the api process previously kept two Prisma pools
# (NestJS `PrismaService` + a `lib/db.ts` singleton). They've been collapsed
# to a single shared instance — see apps/api/src/lib/db.ts for the Proxy
# pattern that enforces this.
DATABASE_URL="postgresql://app:app@localhost:5433/ccp?schema=public"

# ---- Native AI Assistant (SEPARATE from the n8n autopilot) ------------------
# Runs entirely on OpenAI: reasoning/auto-reply + voice (STT + TTS). The key is
# OPTIONAL — the feature is opt-in per team, and when it's missing the assistant
# simply stays disabled (no boot failure). Set it only for teams that turn the
# assistant on.
OPENAI_API_KEY=

# Model ids are env-configured (never hardcoded display names — correction #11).
# The config's replyModelTier (reply | reply_hard | cheap) maps to one of these;
# summaries + memory extraction use AI_MODEL_SUMMARY. Override per deployment.
AI_MODEL_REPLY=gpt-4o
AI_MODEL_REPLY_HARD=gpt-4o
AI_MODEL_CHEAP=gpt-4o-mini
AI_MODEL_SUMMARY=gpt-4o-mini

# OpenAI voice models. STT transcribes inbound voice notes; TTS renders voice
# replies. Arabic dialect quality is NOT guaranteed — the assistant always
# falls back to a text reply on any TTS/media failure (correction #12).
AI_STT_MODEL=gpt-4o-transcribe
AI_TTS_MODEL=gpt-4o-mini-tts

# Optional global kill switch for the whole subsystem (unset or 1 = on). When 0,
# no assistant job runs regardless of per-team config.
AI_ASSISTANT_ENABLED=1

# ---- App --------------------------------------------------------------------
APP_PORT=3000
# Better Auth uses this for the sign-in callback URL and as the default
# trustedOrigins entry. Must match the public origin in production exactly
# (scheme + host) — anything else fails the origin check on signin endpoints.
BETTER_AUTH_URL="http://localhost:3000"
# Required. Generate with: openssl rand -base64 32
# Used to sign session cookies + the in-cookie session cache. Rotating this
# value invalidates every active session — every user gets bounced to /login
# on their next request.
BETTER_AUTH_SECRET=""

# Required (api process). Generate with: openssl rand -base64 32
# AES-256-GCM key used by apps/api/src/lib/crypto/envelope.ts to encrypt
# stored secrets at rest: per-team Meta credentials (ChannelConnection.secrets),
# outbound-webhook signing secrets (OutboundWebhook.secret), and workflow
# secrets (incoming-webhook HMAC + http_request bearer/header credentials in
# the graph). (TeamApiKey stores a one-way tokenHash, not ciphertext.) Treat as
# write-once: rotating without re-encrypting every stored secret breaks every
# team's WhatsApp integration (decryptSecret THROWS in production on a row that
# wasn't written with this key). Only the api process reads this — the web
# container never decrypts, so it is NOT injected there.
#
# If a plaintext (un-prefixed) secret row ever reaches prod (raw-SQL backfill,
# restore of a pre-encryption dump), OR you must rotate the key, run the
# re-encryption tool from the api container (repo root in the image is /app):
#   # encrypt plaintext rows with the current key
#   docker compose exec --workdir /app api node -r @swc-node/register scripts/encrypt-secrets.ts
#   # rotate: decrypt with the old key, re-encrypt with the new ENCRYPTION_KEY
#   docker compose exec --workdir /app -e ENCRYPTION_KEY_OLD=<old-base64> api \
#     node -r @swc-node/register scripts/encrypt-secrets.ts
#   # preview without writing
#   docker compose exec --workdir /app api node -r @swc-node/register scripts/encrypt-secrets.ts --dry-run
# The simplest remediation for a single team is to re-paste its credentials in
# /settings/whatsapp, which rewrites them encrypted with the current key.
ENCRYPTION_KEY=""

# Superadmin (db:seed:superadmin, run on every deploy) + the DEV seed
# (npm run db:seed) both use hardcoded credentials — password "loadless".
# Change after first login. The dev seed hard-refuses NODE_ENV=production.

# ---- Meta WhatsApp Cloud API ------------------------------------------------
# Per-team credentials live on the Team row (envelope-encrypted via
# ENCRYPTION_KEY above). Admins onboard a team by pasting their
# accessToken / appSecret / verifyToken / phoneNumberId into
# /settings/whatsapp. No global META_* fallback exists.
#
# META_GRAPH_VERSION pins the Graph API version so Meta-side changes don't
# break the integration silently. Same version for every team.
META_GRAPH_VERSION="v25.0"

# ---- Media storage (Cloudflare R2) ------------------------------------------
# All inbound + outbound media (image/video/audio/document) + user avatars are
# uploaded to Cloudflare R2 (S3-compatible). The bucket is PRIVATE — nothing is
# public; browsers are served short-lived presigned URLs via /api/media/* and
# the avatar / template-header presign routes. Impl: lib/blob-storage/r2.ts
# (BlobStorageProvider). To swap providers later, add a new file there and point
# lib/blob-storage/index.ts at it.
#
# Create an R2 bucket + an S3 API token with "Object Read & Write" on it.
# Without these, EVERY inbound media message is silently swallowed.
R2_ACCOUNT_ID=""                 # <id> in <id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="central-ccp"
# Presigned-URL lifetime in seconds — used ONLY for the broadcast/template
# header link Meta fetches; browser media is streamed same-origin. Optional
# (default 3600, max 604800 = 7d).
#R2_PRESIGN_TTL_SECONDS="3600"
#
# BLOB_STORAGE_DRIVER — set to "local" to store blobs on the FILESYSTEM instead
# of R2 (lib/blob-storage/local.ts). For CI and offline dev only: the media
# paths (call recordings, attachments, exports) then run end-to-end without R2
# credentials, which CI cannot have — the only ones this repo holds are
# production's. Explicit opt-in by design; a missing R2 credential never falls
# back to it, and NODE_ENV=production refuses to boot with it set.
# Objects land in BLOB_LOCAL_DIR (default: <tmp>/ccp-blob-storage).
#BLOB_STORAGE_DRIVER="local"
#BLOB_LOCAL_DIR="/tmp/ccp-blob-storage"

# ---- Redis (BullMQ broker) --------------------------------------------------
# Required. Backs the workflow queue (apps/api/src/lib/workflows/queue.ts).
# localhost:6380 when running `npm run dev` from the host; `redis:6379` (the
# docker service name) when the app runs inside docker.
REDIS_URL="redis://localhost:6380"

# ---- NestJS API process ------------------------------------------------------
# apps/api process tuning. All have sensible defaults in code; uncomment to
# override.
#
# API_PORT — port the NestJS HTTP + Socket.io server binds. Default 4000.
#   Must match Caddy's upstream and INTERNAL_API_URL / NEXT_PUBLIC_API_URL.
# API_HOST — bind address. Default 0.0.0.0 (so docker / Caddy can reach it).
#   Set to 127.0.0.1 if you want host-loopback-only in a non-container setup.
# RUN_WORKER_INLINE — when "1" (default), the BullMQ workflow worker runs
#   inside the api process. Set to "0" only if you split a separate worker
#   container (not part of the pilot topology).
# WORKFLOW_WORKER_CONCURRENCY — max parallel workflow step executions per
#   worker instance. Default 5. Bump if step handlers are I/O bound and the
#   queue stalls; lower if a single step spikes the event loop.
#API_PORT=4000
#API_HOST=0.0.0.0
#RUN_WORKER_INLINE=1
#WORKFLOW_WORKER_CONCURRENCY=5
# WORKFLOW_PER_TEAM_CONCURRENCY — max concurrent steps PER TEAM. Default 2.
# Prevents one team's busy workflow from starving every other team's queue.
#WORKFLOW_PER_TEAM_CONCURRENCY=2
# BROADCAST_PER_TEAM_CONCURRENCY — max concurrent broadcast deliveries
# PER TEAM (in-process broadcast runner). Default 2. Same fairness shape
# as WORKFLOW_PER_TEAM_CONCURRENCY.
#BROADCAST_PER_TEAM_CONCURRENCY=2
# BROADCAST_PER_TEAM_RECIPIENT_CONCURRENCY — per-team cap on concurrent
# recipient sends WITHIN a single broadcast's lanes (distinct from the
# per-team concurrent-broadcast cap above). Default 5 (matches the global
# SEND_CONCURRENCY). Clamped to 1..50.
#BROADCAST_PER_TEAM_RECIPIENT_CONCURRENCY=5
# WEBHOOK_PER_TEAM_CONCURRENCY — per-team cap on outbound webhook
# deliveries in flight. Default 4. Tuned higher than workflows since
# each delivery is mostly network-bound on the partner.
#WEBHOOK_PER_TEAM_CONCURRENCY=4
# CONVERSATION_EVENT_RETENTION_DAYS — TTL on ConversationEvent (audit
# timeline) rows. Daily sweeper deletes anything older. Default 90.
#CONVERSATION_EVENT_RETENTION_DAYS=90
# WEBCHAT_VISITOR_RETENTION_DAYS — delete ANONYMOUS website-widget visitors (no
#   phone/email) idle this long, cascading their conversation + messages. Promoted
#   (identified) visitors are never touched. Bounds unbounded widget-row growth.
#WEBCHAT_VISITOR_RETENTION_DAYS=90
# WEBHOOK_WORKER_CONCURRENCY — outbound-webhook delivery concurrency.
# Default 10. Each delivery is one HTTP POST + idempotent retry on 5xx.
#WEBHOOK_WORKER_CONCURRENCY=10
# WEBHOOK_DELIVERY_RETENTION_DAYS — TTL on OutboundWebhookDelivery rows
# (audit log of outbound HTTPs). Daily sweeper deletes anything older.
# Default 30. Bump if you need a longer forensic window.
#WEBHOOK_DELIVERY_RETENTION_DAYS=30
# WEBHOOK_ORPHAN_GRACE_MS — sweeper rescues OutboundWebhookDelivery rows
# that were created but never enqueued (race between db.create and the
# BullMQ add). Default 5 minutes. Lower under flaky Redis to recover faster.
#WEBHOOK_ORPHAN_GRACE_MS=300000
# BLOB_ORPHAN_SWEEP_INTERVAL_MS — interval for the orphan-blob sweeper that
# garbage-collects R2 objects not referenced by any Message row.
# Default 6 hours (21_600_000). Lower for faster reclamation, higher to
# reduce R2 API pressure on big tenants.
#BLOB_ORPHAN_SWEEP_INTERVAL_MS=21600000
# WORKFLOW_WEBHOOK_REQUIRE_TIMESTAMP — require an X-Webhook-Timestamp header
# on incoming workflow-webhook posts and reject anything older than ~5 min
# (replay protection). Default 1. Set to 0 only for legacy senders that
# can't add the header.
#WORKFLOW_WEBHOOK_REQUIRE_TIMESTAMP=1
# INTEGRATIONS_ALLOW_PRIVATE_HOSTS — when set to 1, the safe-fetch helper
# permits 127.0.0.1 / 10.* / 172.16-31.* / 192.168.* / localhost targets
# for integrations + workflow webhooks. Default 0 (SSRF defense). Set 1
# ONLY in dev when hitting a local n8n / receiver.
#INTEGRATIONS_ALLOW_PRIVATE_HOSTS=0

# INTERNAL_BUS_SECRET — shared secret between apps/web and apps/api for
# internal calls (catalog revalidate, socket disconnect-on-logout). Generate
# with: openssl rand -base64 32. Both services must agree.
INTERNAL_BUS_SECRET=""

# Used in outgoing webhook payloads (`_links.*`). Set to your public URL in
# prod so n8n can call back without env juggling.
APP_PUBLIC_URL="http://localhost:3000"

# ---- Internal HTTP between apps/web and apps/api ----------------------------
# apps/web's RSC pages + server actions fetch from apps/api over this URL.
# Distinct from NEXT_PUBLIC_API_URL (browser target). In dev, both processes
# run on the host so 127.0.0.1 is correct. In docker, defaults to http://api:4000
# (the api service on the internal network); only override here if you're
# wiring a non-default topology.
INTERNAL_API_URL="http://127.0.0.1:4000"

# Browser Socket.io target. In dev set this to the api's URL so the browser
# can connect (same host, different port). In prod Caddy routes /socket.io/*
# to the api so leave blank and the browser uses the page's own origin.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Less-common knobs (sane defaults; override only with cause) ------------
# META_FETCH_TIMEOUT_MS — outbound HTTP timeout for Meta Graph API calls
# (sendText, sendTemplate, sendMedia, fetch media binary). Default 20000.
# Lower if you want a tighter SLA on the workflow worker; higher if your
# VPS-to-Meta latency spikes during peak hours.
#META_FETCH_TIMEOUT_MS=20000
#
# WHATSAPP_VOICE_IOS_PROFILE — fix for "This audio is no longer available" on
# iPhone recipients (voice notes play on Android + Mac but not iOS). ON by
# default: voice recordings are transcoded to mono + opus application=voip and
# sent as a WhatsApp voice note (voice:true) — the profile iOS needs to play
# them. NOTE: this is not yet verified against Meta's upload validator (a past
# session saw Meta reject mono+voip with #131053). ESCAPE HATCH: if voice notes
# start failing delivery, set this to 0 + restart the api to revert to the
# proven stereo profile. Watch journald for `audio uploadMedia failed` (#131053)
# when you first test on a real iPhone. See audio-transcode.ts for details.
#WHATSAPP_VOICE_IOS_PROFILE=0
#
# TRUSTED_PROXY_HOPS — how many reverse-proxy hops sit in front of the api.
# Express's req.ip walks back this many entries in X-Forwarded-For to
# identify the real client. In the pilot topology Caddy is the only hop,
# so 1. validateEnv() enforces 0..10 in prod.
#TRUSTED_PROXY_HOPS=1
#
# ENABLE_DEV_TOOLS — when "1", exposes POST /api/dev/emit (lets any
# authenticated user inject synthetic Meta webhook events for testing).
# MUST be unset or "0" in production — main.ts hard-crashes on boot if
# this is "1" with NODE_ENV=production. Set "1" only on local dev boxes
# when exercising the inbound pipeline without a real Meta send.
#ENABLE_DEV_TOOLS=0
#
# ANTHROPIC_API_KEY — powers the composer "Translate" button (Claude API).
# Get a key at https://console.anthropic.com/. Optional — if unset, the
# Translate button returns a "not configured" message and nothing else breaks.
#ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Outbound email (Brevo)
#
# Sends signup verification codes + password-reset codes (from the WEB process,
# where Better Auth lives) and invite links (from the API). BOTH processes send.
#
# Set MAIL_FROM plus exactly ONE credential group. With neither, the mail seam
# STUBS — every message is written to the log and never sent — and production
# refuses to boot, because a signup whose code never arrives can never use the
# product (the API refuses unverified sessions).
#
#   MAIL_SMTP_*    Preferred in PRODUCTION. A Brevo SMTP key (`xsmtpsib-…`) can
#                  only send mail; a Brevo API key CANNOT be scoped and grants
#                  full account access (contacts, campaigns, settings). Needs
#                  outbound 587 and the server's static IP allowlisted under
#                  Brevo → Settings → Security → Authorized IPs.
#
#   BREVO_API_KEY  HTTP over 443 (`xkeysib-…`). Preferred LOCALLY: no port-587
#                  dependency, and Brevo's learning phase tolerates a dynamic
#                  home IP instead of hard-blocking it (SMTP answers
#                  `525 5.7.1 Unauthorized IP address` and has no learning phase).
#
# HTTP wins when both are present. Verify either with: pnpm mail:check
# (connects and authenticates but never sends — costs nothing against the quota).
# ---------------------------------------------------------------------------
MAIL_FROM="no-reply@yourdomain.com"
MAIL_FROM_NAME="Your Product"
BREVO_API_KEY=""
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="587"
MAIL_SMTP_USER=""
MAIL_SMTP_PASSWORD=""
