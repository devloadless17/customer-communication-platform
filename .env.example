# Copy to .env and fill in values for local dev.
#
# `docker compose up -d postgres` is the minimum to run the app dev server
# against. Meta Cloud API is reached over the public internet — no other
# services run locally.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_DB=ccp
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Used by Prisma. localhost:5433 when running `npm run dev` from the host
# (5433 is the docker postgres mapped port — see docker-compose.yml);
# `postgres:5432` (the docker service name) when the app runs inside docker.
DATABASE_URL="postgresql://app:app@localhost:5433/ccp?schema=public"

# ---- App --------------------------------------------------------------------
APP_PORT=3000
NEXTAUTH_URL="http://localhost:3000"
# Required. Generate with: openssl rand -base64 32
# Auth.js v5 reads AUTH_SECRET first, then falls back to NEXTAUTH_SECRET.
# Set both so middleware (Edge), the handler (Node), and the Socket.io
# handshake all sign/verify the same JWTs.
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Default seeded users sign in with password "loadless" — change after first
# login. See prisma/seed.ts.

# ---- Meta WhatsApp Cloud API ------------------------------------------------
# META_VERIFY_TOKEN     — any random string. Pasted into the Meta dashboard's
#   "Verify token" field; the GET handler echoes back the challenge only when
#   the dashboard sends this exact value. Generate with: openssl rand -hex 16
# META_APP_SECRET       — from the Meta app's Basic Settings page. Used to
#   verify the X-Hub-Signature-256 HMAC on every incoming POST.
# META_PHONE_NUMBER_ID  — id of the phone number in WhatsApp Manager (sends).
# META_ACCESS_TOKEN     — system user token with whatsapp_business_messaging.
# META_GRAPH_VERSION    — pin the Graph API version so Meta-side changes don't
#   break the integration silently.
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_GRAPH_VERSION="v21.0"

# ---- Media storage ----------------------------------------------------------
# Filesystem path for inbound + outbound media (image/video/audio/document).
# Defaults to ./storage in dev. In docker-compose this is overridden to a
# named volume so files survive container restarts.
# MEDIA_STORAGE_PATH="./storage"
