# Copy to .env and fill in values for local dev.
#
# `docker compose up -d postgres redis` is the minimum to run the app dev
# server against; Evolution can be started separately when you're ready to
# pair the burner phone.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_DB=ccp
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Used by Prisma. localhost:5433 when running `npm run dev` from the host
# (5433 is the docker postgres mapped port — see docker-compose.yml);
# `postgres:5432` (the docker service name) when the app runs inside docker.
DATABASE_URL="postgresql://app:app@localhost:5433/ccp?schema=public"

# ---- App --------------------------------------------------------------------
APP_PORT=3000
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ---- Evolution API ----------------------------------------------------------
# Reachable from the app over the internal docker network.
EVOLUTION_BASE_URL="http://evolution:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME=""
EVOLUTION_WEBHOOK_SECRET=""
EVOLUTION_LOG_LEVEL=WARN
