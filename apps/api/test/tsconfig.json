{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../packages/tsconfig/nest.json",
  "compilerOptions": {
    "noEmit": true,
    // Some specs assert on browser-shaped payloads (widget bootstraps, web
    // socket frames) alongside the Node globals — same reasoning as
    // tests/tsconfig.json.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    // Specs import api domain code directly (`@/lib/...`), so the app's own
    // path aliases have to resolve from here too.
    "paths": {
      "@/*": ["../src/*"],
      "@ccp/config": ["../../../packages/config/src/index.ts"],
      "@ccp/shared/*": ["../../../packages/shared/src/*"]
    },
    // Specs legitimately keep unused fixtures and params around.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
