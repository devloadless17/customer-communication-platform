{
  "name": "customer-communication-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "web:dev": "pnpm --filter @ccp/web dev",
    "web:start": "pnpm --filter @ccp/web start",
    "api:dev": "pnpm --filter @ccp/api dev",
    "api:start": "pnpm --filter @ccp/api start",
    "api:typecheck": "pnpm --filter @ccp/api typecheck",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:seed:superadmin": "tsx prisma/seed-superadmin.ts",
    "db:seed:long": "tsx scripts/seed-long-thread.ts",
    "db:seed:closed": "tsx scripts/seed-closed-window-chats.ts",
    "db:fix:phones": "tsx scripts/fix-phone-duplicates.ts",
    "db:studio": "prisma studio",
    "prod:local": "docker compose up --build",
    "prod:local:detached": "docker compose up -d --build",
    "prod:local:logs": "docker compose logs -f app",
    "prod:local:down": "docker compose down",
    "prod:local:nuke": "docker compose down -v",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ccp/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "@tanstack/react-virtual": "^3.13.24",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.11",
    "bullmq": "^5.76.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "ioredis": "^5.10.1",
    "libphonenumber-js": "^1.12.43",
    "lucide-react": "^0.469.0",
    "next": "^15.5.16",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.5",
    "uploadthing": "^7.7.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
