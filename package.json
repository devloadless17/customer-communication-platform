{
  "name": "customer-communication-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "web:dev": "pnpm --filter @ccp/web dev",
    "web:start": "pnpm --filter @ccp/web start",
    "api:dev": "pnpm --filter @ccp/api dev",
    "api:start": "pnpm --filter @ccp/api start",
    "api:typecheck": "pnpm --filter @ccp/api typecheck",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:seed:superadmin": "tsx prisma/seeds/seed-superadmin.ts",
    "db:seed:long": "tsx prisma/seeds/seed-long-thread.ts",
    "db:seed:closed": "tsx prisma/seeds/seed-closed-window-chats.ts",
    "db:studio": "prisma studio",
    "prod:local": "docker compose up --build",
    "prod:local:detached": "docker compose up -d --build",
    "prod:local:logs": "docker compose logs -f app",
    "prod:local:down": "docker compose down",
    "prod:local:nuke": "docker compose down -v",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.13.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.11.10",
    "turbo": "^2.3.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "@ffmpeg-installer/ffmpeg",
      "@ffmpeg-installer/linux-x64"
    ]
  }
}
