{
  "name": "customer-communication-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "web:dev": "pnpm --filter @ccp/web dev",
    "web:start": "pnpm --filter @ccp/web start",
    "api:dev": "pnpm --filter @ccp/api dev",
    "api:start": "pnpm --filter @ccp/api start",
    "api:typecheck": "pnpm --filter @ccp/api typecheck",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:seed:superadmin": "tsx prisma/seeds/seed-superadmin.ts",
    "db:seed:long": "tsx prisma/seeds/seed-long-thread.ts",
    "db:seed:closed": "tsx prisma/seeds/seed-closed-window-chats.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "db:studio": "prisma studio",
    "prod:local": "docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env.local-docker --profile local up --build",
    "prod:local:detached": "docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env.local-docker --profile local up -d --build",
    "prod:local:logs": "docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env.local-docker --profile local logs -f caddy app api",
    "prod:local:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env.local-docker --profile local down",
    "prod:local:nuke": "docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env.local-docker --profile local down -v",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.13.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "turbo": "^2.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "effect": "^3.20.0",
      "ws": "^8.21.0",
      "hono": "^4.12.25"
    }
  }
}
