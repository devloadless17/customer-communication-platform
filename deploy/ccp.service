[Unit]
Description=WhatsApp Multi-Agent Shared Inbox (ccp)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ccp
EnvironmentFile=/opt/ccp/.env
# NODE_OPTIONS=--max-old-space-size=4096 is set on the Node process inside
# the container via Dockerfile's ENV — systemd env vars on this host shell
# don't propagate through `docker compose up`. Don't add Environment=
# NODE_OPTIONS here; it would be inert and misleading.

ExecStartPre=/usr/bin/docker compose -f /opt/ccp/docker-compose.yml pull --quiet
ExecStart=/usr/bin/docker compose -f /opt/ccp/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f /opt/ccp/docker-compose.yml down
TimeoutStartSec=180
TimeoutStopSec=60

Restart=on-failure
RestartSec=3
# 5 restarts inside 60s → unit gives up so an operator notices.
StartLimitIntervalSec=60
StartLimitBurst=5

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccp

[Install]
WantedBy=multi-user.target
