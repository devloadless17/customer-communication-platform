[Unit]
Description=WhatsApp Multi-Agent Shared Inbox (ccp)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ccp
EnvironmentFile=/opt/ccp/.env
# NODE_OPTIONS=--max-old-space-size=4096 is set on the Node process inside
# the container via Dockerfile's ENV — systemd env vars on this host shell
# don't propagate through `docker compose up`. Don't add Environment=
# NODE_OPTIONS here; it would be inert and misleading.

ExecStartPre=/usr/bin/docker compose -f /opt/ccp/docker-compose.yml pull --quiet
ExecStart=/usr/bin/docker compose -f /opt/ccp/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f /opt/ccp/docker-compose.yml down
TimeoutStartSec=180
# Must exceed BullMQ lockDuration (90s, see lib/workflows/worker.ts) plus a
# safety margin for the sweeper-stop → queue-close tail. Lower than ~100s and
# a SIGKILL can land while a step is still draining — Redis releases the lock
# 90s later and the next process re-executes the job (irreversible Meta sends
# double-fire). Don't reduce this without first lowering lockDuration in code.
TimeoutStopSec=120

# `always` matches operational intent — "if the process is gone, bring it
# back" — and survives the (rare) clean-exit case. NestJS/Next.js never
# exit 0 voluntarily, so this is identical to `on-failure` in practice,
# but `always` is the one we'd want if anyone ever adds a graceful-exit
# code path. StartLimitBurst still throttles a crash loop so an operator
# notices a flapping deploy.
Restart=always
RestartSec=3
# 5 restarts inside 60s → unit gives up so an operator notices.
StartLimitIntervalSec=60
StartLimitBurst=5

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccp

[Install]
WantedBy=multi-user.target
