# Caddy reverse proxy — TEMPLATE.
#
# This file is NOT installed directly. The deploy workflow
# (.github/workflows/deploy.yml) renders it on every deploy:
#
#   __DOMAIN__       → ${{ secrets.APP_DOMAIN }}
#   __ADMIN_EMAIL__  → ${{ secrets.ADMIN_EMAIL }}
#
# The rendered result is scp'd to /etc/caddy/Caddyfile on the VPS and
# `systemctl reload caddy` is run. Editing /etc/caddy/Caddyfile directly on
# the VPS works for a single deploy but the next deploy will overwrite it —
# changes belong in this template, committed to git.
#
# -----------------------------------------------------------------------------
# Section guide (for quick orientation when editing)
# -----------------------------------------------------------------------------
#
#   - Global options block         → ACME contact + explicit HTTP/3 protocols
#   - Compression (`encode`)       → zstd → gzip, scoped OFF for /api/*
#                                    (small JSON bodies aren't worth the CPU)
#   - Security headers             → HSTS, nosniff, X-Frame-Options SAMEORIGIN,
#                                    Referrer-Policy, Permissions-Policy.
#                                    No CSP yet — would need to thread the
#                                    SSR thread-bottom-snap nonce through here.
#   - Static asset caching         → /_next/static/* hashed by Next at build,
#                                    safe for 1-year immutable Cache-Control.
#   - Routing rules (LOAD-BEARING) → order matters; first match wins.
#
# -----------------------------------------------------------------------------
# Two-upstream topology (post NestJS migration)
# -----------------------------------------------------------------------------
#
#   web   = Next.js     on :3000  → RSC pages, Better Auth pages, /api/auth/*,
#                                   /api/health, legacy Meta webhook proxy
#   api   = NestJS      on :4000  → REST controllers, Socket.io gateway,
#                                   webhook ingest, BullMQ workers, workflows
#
# Rule ordering inside the site block is LOAD-BEARING. Caddy evaluates
# `handle` blocks in source order — the first match wins. Two rules below
# look like they overlap but the order resolves which one fires:
#
#   `/api/auth/change-password*` is matched BEFORE `/api/auth/*`, so
#   change-password (which moved off Better Auth onto a NestJS controller
#   when the api process took ownership) reaches the api upstream. If you
#   ever flip these two blocks, change-password will silently 404 because
#   Next.js has no handler for that path anymore.
#
# -----------------------------------------------------------------------------
# HTTP/3 (QUIC) — operational note
# -----------------------------------------------------------------------------
# The `servers { protocols h3 h2 h1 }` directive below makes HTTP/3 explicit
# (Caddy 2.x auto-enables it when TLS is configured, but stating intent makes
# the deployment self-documenting). HTTP/3 runs over UDP, so the FIREWALL must
# allow inbound UDP/443 in addition to TCP/443. If the VPS provider's firewall
# (UFW / cloud security group) only opens TCP/443, browsers will silently fall
# back to HTTP/2 and you'll never know HTTP/3 isn't actually serving. Verify
# with `curl --http3 -I https://__DOMAIN__/` after rollout or check the
# `Alt-Svc` response header advertising `h3=":443"` on an HTTP/2 response.

{
	# ACME contact email. Let's Encrypt mails this address on renewal failure
	# and ~30 days before expiry. Use a real inbox — these are the warnings
	# you want before the cert silently expires.
	email __ADMIN_EMAIL__

	# Explicit protocol list. h3 (HTTP/3 over QUIC/UDP) first so clients that
	# advertise support via Alt-Svc upgrade on next request; h2/h1 fallback
	# for older clients. Caddy already does this implicitly when TLS is
	# configured, but writing it down means a future reader doesn't have to
	# infer from the absence of a directive.
	servers {
		protocols h3 h2 h1
	}
}

__DOMAIN__ {
	# Auto-HTTPS — Caddy provisions and renews via Let's Encrypt with no
	# config. HTTP requests get a 308 redirect to HTTPS automatically.

	# Compression for HTML / JS / RSC payloads. Order in the directive is
	# the negotiation preference: Caddy picks the FIRST encoding the client's
	# `Accept-Encoding` advertises, so zstd > gzip. No `br`: the standard
	# Caddy distribution ships zstd + gzip on-the-fly encoders only — it can
	# serve precompressed `.br` files but has no `http.encoders.br` module,
	# so `encode … br …` fails `caddy validate` ("module not registered:
	# http.encoders.br"). zstd + gzip already cover every real client.
	#
	# Scoped OFF for /api/* — the api upstream returns mostly small JSON
	# bodies (a few hundred bytes typical), where compression CPU + the
	# extra header bytes outweigh transfer savings. Socket.io frames ride
	# /api/socket/* and stay uncompressed (permessage-deflate is negotiated
	# end-to-end between the browser and the Socket.io gateway, not by the
	# proxy). The default route (RSC pages, /_next/*, HTML, JS chunks) is
	# where compression actually pays off.
	@compressible {
		not path /api/*
	}
	encode @compressible zstd gzip

	# Hardening headers complement the ones next.config.ts sets — Caddy
	# overrides anything the app emits, so keep these aligned with
	# next.config.ts's `headers()`.
	header {
		# No `preload` — that token signals you intend to submit the
		# domain to the HSTS preload list, which is very hard to undo. Add
		# it only after you've decided to commit and verified all
		# subdomains can serve HTTPS.
		#
		# THIS is the value production serves: Caddy's `header` replaces the
		# app's, so next.config.ts's 2-year value never reaches a browser
		# through the edge. 1 year is a sound production value; raising it
		# is a deliberate, hard-to-undo commitment, so it is left to a human
		# decision rather than drifting up by accident (audit 2026-08-11).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# DENY, matching next.config.ts's stated intent and the CSP the
		# app already serves on page routes (`frame-ancestors 'none'`,
		# apps/web/src/proxy.ts) — CSP has LANDED, so the "when CSP lands"
		# note this comment used to carry is settled: nothing may frame us.
		#
		# Caddy's `header` REPLACES the app's, so prod served SAMEORIGIN
		# while the app declared DENY — the two disagreed for real traffic
		# (audit 2026-08-11). Safe to tighten: the webchat widget embeds on
		# customer sites by INJECTING DOM (public/widget.js), never by
		# iframing this origin, so no legitimate embedder exists.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# microphone=(self) — voice notes in the inbox composer need
		# getUserMedia. geolocation=(self) — "Send location → My location"
		# in the composer needs navigator.geolocation. Empty allowlist `()`
		# policy-blocks even same-origin calls so the prompt grant is
		# useless. Browsers intersect Permissions-Policy headers from app +
		# proxy: both must allow — keep aligned with apps/web/next.config.ts.
		Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
		-Server
	}

	# Long-lived cache for hashed Next.js static assets. The build embeds a
	# content hash in every filename under /_next/static/* (e.g.
	# /_next/static/chunks/main-abc123.js), so a deploy that changes a chunk
	# changes the URL — `immutable` is therefore safe: browsers will never
	# refetch a given URL, and the new URL is fetched on the next page load.
	# `public` lets shared caches (CDN, ISP) store the response too. This
	# header is set in addition to whatever Next.js emits because Caddy's
	# `header` directive overrides on conflict — keep them in sync.
	@nextStatic {
		path /_next/static/*
	}
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	# Access logs to stdout → systemd-journald.
	log {
		output stdout
		format json
	}

	# Rate limiting is NOT enabled at the Caddy layer here. The standard
	# Caddy build doesn't ship the `rate_limit` directive — it requires
	# the github.com/mholt/caddy-ratelimit plugin compiled in via xcaddy.
	# Today the app handles per-user (300/min) and per-API-key (60/min)
	# throttling in-process (apps/api/src/common/rate-limit.interceptor.ts
	# — an APP_INTERCEPTOR — plus ip-rate-limit.middleware.ts for IP-based
	# limits and the API-key guard) which covers correctness for the
	# pilot scale.
	#
	# Add a proxy-layer cap when one of these triggers:
	#   - a single bad client at the /webhooks/meta/* path saturates the
	#     api process before the app-layer guard can throttle
	#   - we add multi-tenant Meta webhooks and need per-team caps that
	#     the in-process limiter (which keys on session.userId) can't
	#     enforce for unauthenticated requests
	# Upgrade path: rebuild Caddy with `xcaddy build --with github.com/
	# mholt/caddy-ratelimit`, swap the systemd-managed `caddy` package for
	# the custom binary, then add rate_limit blocks here.

	# -------------------------------------------------------------------------
	# Routing — order matters. See header comment for the rationale on the
	# change-password and legacy-meta-webhook blocks.
	# -------------------------------------------------------------------------

	# (1) /api/auth/change-password → api (NestJS). MUST come before the
	#     /api/auth/* catch-all below.
	handle /api/auth/change-password* {
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# (2) /api/auth/* → web (Next.js / Better Auth catch-all).
	handle /api/auth/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# (3) /api/health → web (Next.js). Legacy probe URL; the api process
	#     exposes its own /health on :4000 for direct probing.
	handle /api/health {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# (4) /api/internal/* — REFUSED at the edge. These routes are designed
	#      for internal-only callers (Next.js → NestJS over the private
	#      docker network, INTERNAL_API_URL=http://api:4000); exposing them
	#      publicly means a leaked INTERNAL_BUS_SECRET becomes a remote
	#      forced-logout / session-revoke primitive. The defense in code
	#      (secret check) is fine, but blocking at the edge means the
	#      attack surface is invisible to the internet entirely. The
	#      legitimate web→api call goes container-to-container on the docker
	#      network so it never traverses Caddy and stays unaffected.
	handle /api/internal/* {
		respond 404
	}

	# (5) /api/*, /webhooks/* → api (NestJS).
	#     The Socket.io client connects on `/api/socket/*` (see `SOCKET_PATH`
	#     in packages/shared/src/socket/events.ts) — that path is covered by
	#     `/api/*`, so no separate `/socket.io/*` matcher is needed. The
	#     bumped read/write timeouts below still apply to the WebSocket
	#     traffic since it rides the same `@apiBackend` handle.
	@apiBackend {
		path /api/* /webhooks/*
	}
	handle @apiBackend {
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_buffer 64KB
				write_buffer 64KB
				# Long-lived connections (websocket + SSE) shouldn't hit
				# the default 5-min idle cap.
				read_timeout 5m
				write_timeout 5m
				# Tight TCP dial — if NestJS is briefly down during a
				# restart, fail fast and let lb_try_duration retry below
				# rather than holding the client connection for seconds.
				dial_timeout 2s
			}
			# Tight health probing — Caddy notices the new container is up
			# within ~2s of post-deploy cutover instead of waiting a full
			# 10s tick. health_uri is cheap (just a JSON {ok:true}).
			health_uri /health
			health_interval 2s
			health_timeout 2s
			health_status 200
			# During the ~3s container-swap window, hold the request and
			# retry briefly instead of returning 502 immediately. WebSocket
			# upgrades skip retry (single-shot handshake), but HTTP gets a
			# seamless cutover for the user. Caps the retry budget at 5s
			# so a real outage still surfaces fast.
			#
			# `lb_retry_match { method GET HEAD OPTIONS }` restricts retries
			# to IDEMPOTENT methods only. POSTs are NOT retried: a POST
			# that the upstream partially processed before its connection
			# dropped (HMAC verified + row written, then container
			# SIGTERM'd before the 200 reply landed) would otherwise be
			# re-sent by Caddy on retry — same body, same processing,
			# duplicate side effects. Meta webhooks are dedupe-safe
			# (unique on external_id), but the workflow incoming-webhook
			# and a few /v1 mutating routes are NOT. Health-probed
			# upstreams already avoid sending new requests to a down
			# container; the retry was only ever for the brief cutover edge.
			lb_try_duration 5s
			lb_try_interval 250ms
			lb_retry_match {
				method GET HEAD OPTIONS
			}
		}
	}

	# (6) Default — everything else (`/`, `/_next/*`, RSC pages, static
	#     assets, login/register/inbox pages) → web (Next.js).
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 2s
			}
			# Probe Next.js's SHALLOW /api/health/web (db + process only, NO
			# api dependency) for upstream liveness. The deep /api/health
			# would mark THIS web upstream unhealthy during a routine api-only
			# restart / drain → 502 on /login + every RSC page even though
			# Next.js is fine. The shallow probe answers "is web alive?" so an
			# api blip never blacks out the login page. (The DEEP probe stays
			# the Docker HEALTHCHECK for operator data-plane visibility.)
			health_uri /api/health/web
			health_interval 2s
			health_timeout 2s
			health_status 200
			# Brief retry budget during cutover so a page load mid-deploy
			# doesn't 502; see api block above for rationale. Idempotent
			# methods only — same posture as the api block above.
			lb_try_duration 5s
			lb_try_interval 250ms
			lb_retry_match {
				method GET HEAD OPTIONS
			}
		}
	}
}
