// Schema for the WhatsApp Multi-Agent Shared Inbox.
//
// Mirrors lib/types.ts exactly so the UI and the DB stay in lockstep.
// Multi-tenancy is baked in: every domain row carries workspaceId.

generator client {
  provider        = "prisma-client-js"
  // `postgresqlExtensions` lets us declare the pg_trgm GIN indexes that the
  // search-heavy contact / conversation / team-chat queries depend on. Without
  // these declarations `prisma migrate dev` treats the hand-written indexes as
  // drift and silently generates a migration that DROPS them. The partial trgm
  // indexes on Contact.email / Contact.phoneNumber stay hand-written — Prisma's
  // DSL can't model partial indexes — but those don't trigger the drift
  // detector. (The old jsonb_path_ops GIN on Contact.customFields was dropped
  // in 20260611130200 — no query could use it; that also retired the
  // long-standing "single-permanent-diff" drift workaround.)
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // `plpgsql` is the default extension every Postgres install ships with; it
  // must be listed once `extensions = [...]` is non-empty so the introspector
  // doesn't flag it as drift.
  extensions = [pg_trgm, plpgsql]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Per-WORKSPACE role, carried on WorkspaceMember. superAdmin is no longer here —
// it moved to User.isSuperAdmin (platform-level, orthogonal to any workspace).
enum Role {
  // Per-workspace owner: full workspace management.
  admin
  // Conversation-level lead: same conversation powers as agent, plus
  // read-only visibility into /settings/team. No user management.
  manager
  agent
}

// Org-directory role, carried on User (one per user — a user belongs to exactly
// one Organization). Governs billing + the user directory + who can create
// workspaces / invite members. Distinct from the per-WORKSPACE Role above: an
// `owner`/`admin` here is implicitly `admin` in every workspace of the org.
enum OrgRole {
  owner
  admin
  member
}

// Subscription tier per team. Scaffolding only — every team is set to
// `starter` today and no features are gated yet. The feature → plan matrix
// will be wired in packages/shared/src/auth/plans.ts when ready. UI is
// intentionally hidden until that matrix exists.
enum Plan {
  free
  starter
  advanced
  enterprise
}

// Org lifecycle gate. A self-signed-up org lands as `pending` and CANNOT use
// the app until a superAdmin approves it (→ `active`). A superAdmin can revoke
// access at any time (→ `suspended`). superAdmins themselves bypass this gate
// (their team is just an anchor row). Default `pending` = secure-by-default:
// a brand-new org is locked until reviewed. The init migration backfills every
// PRE-EXISTING team to `active` so current customers aren't locked out.
enum OrgStatus {
  pending
  active
  suspended
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  in
  out
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

// Lifecycle of a MessageFlag — a triage marker raised on a single message.
//   open      — raised, still needs follow-up. The only state that counts
//               toward Conversation.openFlagCount and shows in the queue.
//   resolved  — it was a real complaint/request AND it was handled.
//   dismissed — it was NOT actually one (a mis-flag, or the AI got it wrong).
// The split between resolved and dismissed matters: "how many complaints did we
// get" must not count the ones that were never complaints. Additive by design —
// an in_progress / snoozed state can be appended later without a rewrite.
enum MessageFlagStatus {
  open
  resolved
  dismissed
}

// How an OUTBOUND message came to exist. `api` = sent through this platform
// (an agent, an automation/workflow, a broadcast, or the /v1 API) — the vast
// majority, and the value every legacy row defaults to. `business_app` = the
// message was sent from the WhatsApp Business App on the owner's PHONE and
// mirrored back to us via the Coexistence `smb_message_echoes` / `history`
// webhook (it has no authoring agent, so senderUserId is null too). The
// discriminator lets the inbox show "· via WhatsApp app" so the team can tell
// an owner's phone reply apart from a system/automation send (both agentless).
// Meaningless for inbound rows, which always carry `api`.
enum MessageOrigin {
  api
  business_app
}

// The messaging CHANNEL (the medium a conversation lives on). This is the
// single "where is this conversation from" discriminator — there is NO separate
// "provider/vendor" concept in the data model (a Meta-vs-Twilio distinction is
// an implementation detail of the MessagingProvider impl, not stored). Adding a
// channel = a new value here + a registered MessagingProvider + a
// ChannelConnection row. Meta Cloud serves both `whatsapp` and (future)
// `instagram` — they are DISTINCT channels even though one API delivers them.
// Live channels: whatsapp, messenger, instagram (each has a registered
// MessagingProvider + onboarding). telegram / email / sms are DESIGNED-FOR but
// NOT yet implemented — the enum value + capability/identity maps exist so the
// architecture is ready, but there is no provider/webhook/onboarding, so no row
// can ever carry these channels until a focused session ships them (see
// @ccp/shared LIVE_CHANNELS + lib/providers/README.md).
enum Channel {
  whatsapp
  messenger
  instagram
  telegram
  email
  sms
  // First-party embeddable website chat widget. Unlike the others it has no
  // external vendor — the org drops a <script> on their site, visitor messages
  // arrive over a public Socket.io namespace, and outbound is delivered by the
  // realtime fanout (see apps/api/src/webchatwidget/). Identity is `external`
  // (an opaque per-browser visitor id in Contact.externalContactId).
  webchatwidget
}

// Mirrors Meta's template review states. We cache every status so admins can
// see "pending" rows and understand why a template they just submitted isn't
// sendable yet — only `approved` rows are actually allowed through to send.
enum TemplateStatus {
  approved
  pending
  rejected
  paused
  disabled
  // Meta auto-archives a template after 12 months of inactivity (no create,
  // edit, send, appeal or unarchive). It cannot be sent — but unlike `disabled`
  // it is RECOVERABLE, and only for 28 days, after which Meta deletes it for
  // good. Folding it into `disabled` hid both facts: the operator saw a dead
  // template with no clock and no way back, and lost it permanently.
  archived
}

enum TemplateCategory {
  marketing
  utility
  authentication
}

// Lifecycle of a template broadcast.
//   queued    — created but the runner hasn't started yet (rare; created+started
//               are usually back-to-back inside the same POST).
//   running   — runner is iterating recipients.
//   completed — runner finished. `failedCount > 0` is possible (per-recipient
//               failures don't fail the whole job).
//   failed    — runner errored fatally (e.g. config disappeared mid-flight).
//   paused    — process was draining gracefully (deploy, restart) and stopped
//               the runner mid-flight. Boot reconciler auto-resumes by
//               flipping back to `queued` and calling startBroadcast(); the
//               CAS `queued→running` claim then takes over. Recipients
//               already `sent` stay `sent`; remaining `queued` rows get
//               picked up where the old runner left off.
enum BroadcastStatus {
  // Created with a future scheduledAt. A delayed BullMQ job (jobId =
  // broadcast id) flips it `scheduled` → `queued` and starts the runner at
  // that time. Cancelable while scheduled (removes the delayed job).
  scheduled
  // Recipients are being resolved + inserted asynchronously by the
  // broadcast-materialize worker (large audiences up to the 100k cap can't be
  // built inside the create HTTP request without blowing the tx budget). The
  // worker chunk-inserts BroadcastRecipient rows, then CAS-flips
  // `materializing` → `queued` and kicks the runner. Cancelable while
  // materializing (the worker checks the row status between batches).
  materializing
  queued
  running
  completed
  failed
  // Operator-initiated stop while queued or running. Recipients already
  // sent stay sent; remaining queued rows are skipped by the runner on
  // its next status check. Distinct from `failed` so the UI can show
  // "you canceled this" instead of "this broke."
  canceled
  paused
}

enum BroadcastRecipientStatus {
  queued
  sent
  failed
}

/// What happened to a broadcast message AFTER the send attempt — the delivery
/// truth Meta reports asynchronously via status webhooks.
///
/// DELIBERATELY SEPARATE from `BroadcastRecipientStatus`. That enum is
/// load-bearing in CAS predicates on the billed, irreversible send path (the
/// runner's `queued → sent` never-resend lock, the cancel-race reconcile,
/// cancel()'s `WHERE status='queued'` finalize, retryFailed()'s
/// `status='failed'` selector). Folding delivered/read/undelivered into it
/// would mean the first `WHERE status IN ('failed','undelivered')` written in
/// retryFailed() RE-SENDS to recipients Meta already billed us for. Two
/// owners, two columns: `status` = what the send attempt did (runner-owned,
/// effectively write-once); `deliveryState` = what happened afterwards
/// (webhook-owned). The reporting layer reads `deliveryState` ONLY.
enum BroadcastDeliveryState {
  /// Not sent yet (or the send is in flight).
  pending
  /// Meta rejected the send API call — the message never entered the network.
  /// Stamped by the runner, never by a webhook (a rejected send has no wamid).
  failed_at_send
  /// Meta accepted the send and issued a wamid. Stamped by the runner.
  sent
  /// Handset acknowledged receipt.
  delivered
  /// Read receipt received.
  read
  /// Meta accepted the send, then reported it undeliverable (handset off,
  /// number invalid, user blocked us, per-user marketing cap). THIS is the
  /// state that was previously invisible: such recipients stayed `sent` and
  /// were counted as successes, so "who never received it" answered wrongly.
  undelivered
  /// Meta accepted the send and issued a wamid, then HELD the message for a
  /// business-portfolio pacing quality assessment (`message_status:
  /// held_for_quality_assessment` in the send response). It is not en route: it
  /// is released in a later batch, or DROPPED outright if Meta's review finds
  /// suspicious activity (a `failed` webhook with code 135000).
  ///
  /// Exactly the failure mode `undelivered` above exists for: without this the
  /// recipient sits at `sent` and is counted a success while nothing has left
  /// Meta's queue. Ranked ALONGSIDE `sent`, not below it — a held message has
  /// already been accepted, so `delivered`/`read` still advance past it, and a
  /// later plain `sent` webhook must not erase the more specific fact.
  held
}

/// What a broadcast sends. `template` = a pre-approved WhatsApp template
/// (reaches contacts any time). `freeform` = a plain text message, allowed
/// only to contacts inside their free-form window — used for Messenger /
/// Instagram re-engagement (social has no approved-template catalog).
enum BroadcastKind {
  template
  freeform
}

/// Who a broadcast targets. `contact` (default, back-compat) = channel-scoped
/// Contacts on ONE channel — today's behavior, byte-identical. `customer` =
/// the unified PERSON: each Customer is reached ONCE on their best live channel
/// (resolved per-recipient via `bestChannelForCustomer`), so a person on
/// WhatsApp + Messenger + IG gets one message, not three. Customer-mode is
/// freeform-body based (no template) and spans mixed channels in one broadcast.
enum BroadcastTargetMode {
  contact
  customer
}

// Why a contact exists in our DB.
//   - inbound: created by a webhook ingest (a customer messaged us).
//   - manual: created by an agent — through the New Contact dialog or a CSV
//             import. Used to differentiate "people who reached out" vs
//             "people we added on our end" in the contacts list.
enum ContactSource {
  inbound
  manual
}

// What a ConversationEvent row records. The audit timeline reads these to
// show "Agent X assigned the conversation to Y at 10:14" etc. Adding a new
// value here is half the work — the write site (assign/status/tags route)
// needs to call recordConversationEvent with the matching `before`/`after`
// shape, documented per-kind in lib/inbox/events.ts.
enum ConversationEventKind {
  assigned
  status_changed
  tag_added
  tag_removed
  stage_changed
  note_added
  note_deleted
  // Message triage flags (MessageFlag). `after` carries
  // { flagId, messageId, definitionId, definitionName, status, source } —
  // definitionName is resolved at WRITE time so the timeline still reads
  // correctly after the definition is renamed or archived (same reason
  // tag_added/tag_removed snapshot the tag name). Rendered as inline timeline
  // pills by activity-entry.tsx.
  flag_added
  flag_reopened
  flag_resolved
  flag_removed
  // A website-widget visitor deliberately started a fresh conversation (the
  // "Start a new conversation" control). Written when the new conversation's
  // first message arrives carrying the client's `startedNew` flag, so an agent
  // opening the fresh thread knows the person chose to start over (new topic /
  // shared computer) rather than this being their first-ever contact. Rendered
  // as a normal timeline pill (activity-entry.tsx). Actor is the visitor → no
  // userId, so it reads as a self-contained "Visitor started…" line.
  visitor_started_conversation
  // AI Autopilot toggled off / on for this conversation (by a human in the
  // inbox, by the AI on escalation via /v1, or auto-paused on a human reply).
  // Rendered as an inline timeline pill, same as status/assignment.
  ai_paused
  ai_resumed
  // The workspace blocked / unblocked this contact at the provider (WhatsApp
  // Block Users API). Rendered as inline timeline pills (activity-entry.tsx)
  // so the thread explains WHY the reply box is locked. `after` carries
  // { contactId } only — the actor rides the standard userId/apiKeyId columns.
  contact_blocked
  contact_unblocked
  // Voice-call lifecycle audit rows. Written by the audit subscriber on every
  // terminal call state for the DB-only audit trail — they are NOT rendered as
  // timeline pills (activity-entry.tsx has no call_* case; the visible inline
  // element is the CallBubble built from the Call row itself). Kept distinct
  // from status/assignment pills for that reason. The thread-hydration events
  // window (conversations.ts) excludes these kinds so they don't consume the
  // ACTIVITY_WINDOW budget. Carries { callId, direction, durationSeconds } in
  // `after` for any future audit-feed reader.
  call_completed
  call_missed
  call_rejected
  call_failed
  // Ticket lifecycle, rendered as inline pills so an agent reading the thread
  // sees where one piece of work ended and the next began. `after` carries
  // { ticketId, number, subject, status } — snapshotted at write time, same
  // rule as tag_added, so the pill still reads correctly after a rename.
  // Deliberately a SMALL set: the full ticket history lives on TicketEvent;
  // only the boundaries that change what the thread means show up inline.
  ticket_opened
  ticket_solved
  ticket_reopened
  ticket_closed
  // Customer call-permission decisions — VISIBLE inline pills (unlike the
  // DB-only call_* rows above), because nothing else in the thread shows them:
  // the permission reply webhook is consumed whole into contact state, so
  // without a pill a weekend "request a callback" tap is invisible to the team.
  // `after` carries { contactId, contactName } (name snapshotted at write time,
  // same rule as tag_added) plus { isPermanent, expiresAt } on grants. Actor is
  // the CUSTOMER → no userId; rendered self-contained like
  // visitor_started_conversation.
  //   callback_requested      — automatic grant NOT explained by a call we have
  //                             on file = the customer tapped "request a
  //                             callback" (outside call hours / calls disabled).
  //   call_permission_granted — the customer answered our permission request
  //                             with Allow (user_action grant).
  //   call_permission_declined— the customer declined the request.
  // An automatic grant that accompanies a call we already ingested writes NO
  // pill — the CallBubble already tells that story.
  callback_requested
  call_permission_granted
  call_permission_declined
}

// WhatsApp Business Calling lifecycle. ringing → in_progress on first agent
// answer (CAS-gated); then exactly one terminal: completed (clean hangup),
// missed (incoming, no agent picked up), rejected (agent declined), or
// failed (signaling/media error). `missed` vs `rejected` is intentional —
// the future workflow trigger "On Missed Call" wants to differentiate
// nobody-at-the-desk from agent-actively-said-no.
enum CallStatus {
  ringing
  in_progress
  completed
  missed
  rejected
  failed
}

// Mirrors MessageDirection on purpose so the list-style UI patterns transfer
// (filters, badges, color choices) without a new vocabulary.
enum CallDirection {
  in
  out
}

// Lifecycle of a CallPermissionRequest row. `pending` is the state right
// after we SEND the request to Meta (the customer hasn't acted yet);
// `granted`/`denied` are stamped when Meta's permission_granted/_revoked
// webhook lands. The placeCall pre-flight only treats a `granted` row (still
// inside its 72h window) as live — a merely-`pending` request is NOT a pass,
// so an agent gets a clear "permission requested, waiting on the customer"
// state instead of a confusing provider_rejected.
enum CallPermissionStatus {
  pending
  granted
  denied
}

// Domain events workflows can subscribe to. Adding a new value is half the
// work — the dispatcher (lib/workflows/dispatcher.ts) needs the matching
// call site, and lib/workflows/conditions.ts needs to know which fields
// the payload carries for trigger-time filtering.
enum WorkflowTriggerEvent {
  // Inbox events
  message_received
  conversation_created
  conversation_opened
  conversation_closed
  conversation_assigned
  conversation_status_changed
  // Contact events
  contact_field_updated
  contact_tag_updated
  contact_lifecycle_updated
  // TICKET events — the work item, not the thread. Separate from the
  // conversation triggers because a ticket has its own lifecycle (many per
  // thread), its own SLA promise, and its own cross-department escalation, and
  // the automations people actually want are about THOSE: "urgent tickets go to
  // the on-call queue", "tell a manager when a promise is missed", "when Billing
  // is asked for help, notify their channel".
  ticket_created
  ticket_status_changed
  ticket_priority_changed
  ticket_assigned
  // The SLA sweeper flagged a missed promise. Fires exactly once per leg (the
  // breach write is CAS'd), so an automation here cannot spam.
  ticket_sla_breached
  // Escalated to another workspace in the organization.
  ticket_escalated
  // External / on-demand triggers
  manual_trigger
  incoming_webhook
}

// What a workflow step does when it runs. Steps are registered in
// lib/workflows/steps/index.ts — adding a value without a registered
// handler causes the runner to mark the step as failed. Control-flow
// steps (branch / wait / jump_to_step) are special-cased in the runner;
// everything else is a plain "do the thing, advance to next."
enum WorkflowStepType {
  // Messaging
  send_message
  send_template
  add_comment
  // Conversation state
  assign_to
  set_status
  open_conversation
  close_conversation
  // Contact mutations
  add_tag
  remove_tag
  update_field
  update_lifecycle
  // Control flow
  branch
  wait
  jump_to_step
  noop
  ask_question
  // Ticket state. These act on the conversation's ACTIVE ticket (or open one),
  // never on an arbitrary ticket id — a workflow runs in the context of one
  // conversation, and letting it name a ticket by id would let workflow A
  // silently reach into workflow B's work.
  create_ticket
  set_ticket_status
  set_ticket_priority
  assign_ticket
  // External
  http_request
  trigger_workflow
}

// Lifecycle of a single workflow execution.
//   queued     — enqueued in BullMQ, not yet picked up by a worker
//   running    — worker is currently executing a step
//   waiting    — paused at a `wait` step (resume job scheduled)
//   completed  — reached a terminal step or end-of-graph
//   failed     — exhausted retries on a non-recoverable step error
//   skipped    — workflow was disabled / deleted between dispatch and run,
//                or conditions later flipped
enum WorkflowRunStatus {
  queued
  running
  waiting
  completed
  failed
  skipped
}

// What happens to a conversation when the CUSTOMER hands off to a human
// (the n8n flow detects the word "human" and calls /v1/.../ai with
// applyHandoffPolicy:true). Only the customer-initiated path runs this —
// an agent's manual AI toggle / auto-pause-on-reply already has a human.
enum AiHandoffAction {
  none // just pause AI (legacy behavior)
  unassign // pause + clear assignee (lands in the Unassigned queue)
  assign_fixed // pause + assign to Workspace.aiHandoffAssigneeId
  round_robin // pause + rotate across eligible agents
}

// Who sends the very first greeting on a brand-new conversation, so the AI
// and a welcome workflow don't both reply to the first inbound.
enum FirstTouchGreeter {
  ai // AI greets (default); admin should NOT also run a welcome workflow
  workflow // a welcome workflow greets; the AI is suppressed on the first inbound only
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

// The tenant / billing root. Owns the user directory + one-or-more Workspaces.
// The org-approval gate, subscription plan, and the member seat-cap all live
// here (org-wide), lifted off the former `Workspace` (now `Workspace`).
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // The PLATFORM's own anchor row — not a customer.
  //
  // A super admin is a platform operator, not a tenant: they oversee every
  // organization and belong to none. But `User.organizationId` is required (a
  // user must hang off something), so the seed gives the operator an anchor
  // org. That anchor is an implementation detail of the FK — it is NOT an
  // organization in any sense the product means, and it must never be listed,
  // counted, billed, suspended or deleted as one. It was showing up in the
  // platform console as a customer called "Loadless" with its own workspace,
  // which is exactly the confusion this flag removes.
  //
  // A flag rather than making `organizationId` nullable: the column is read in
  // ~43 places that are all correctly typed non-null today, and every one would
  // need a null branch whose omission fails SILENTLY (an `undefined` in a Prisma
  // `where` does not narrow — it drops the filter). This is the minimal change
  // that fits the architecture (§17), and it mirrors the `isSuperAdmin: false`
  // exclusion the seat counts already use.
  //
  // Exactly one row carries this. Every customer-facing read filters it out;
  // see lib/queries/super-admin.ts.
  isPlatform Boolean @default(false)

  // Subscription tier. Default `starter` for every org — feature gating is not
  // wired up yet. See packages/shared/src/auth/plans.ts. UI hidden.
  plan Plan @default(starter)

  // How many WORKSPACES this organization may create. Set by a super admin per
  // org; enforced under a row lock on THIS org row at workspace-create.
  //
  // The SEAT cap is NOT here — it lives on each `Workspace.maxMembers`,
  // because a member belongs to a workspace rather than to the organization
  // as a whole. (The first three lines of this comment used to describe that
  // org-pooled member cap and were left stranded by the move; a reader
  // following them looked for enforcement on this field that never existed.)
  maxWorkspaces Int @default(2)

  // Org-approval gate (see `OrgStatus`). A new self-signup is `pending` until a
  // superAdmin approves it; `suspended` when access is revoked. Enforced at BOTH
  // chokepoints — the NestJS SessionGuard (every API request) and the Next.js
  // (app) layout (every page). superAdmins are exempt.
  status            OrgStatus @default(pending)
  statusReason      String?
  // Plain User id (no relation) so deleting the acting superAdmin never cascades
  // into / nulls a customer org's audit trail. Reads are display-only.
  statusUpdatedAt   DateTime?
  statusUpdatedById String?

  workspaces        Workspace[]
  users             User[]
  ticketShares      TicketShare[]
}

// A Workspace is the data-ISOLATION boundary (formerly `Workspace`): every one of
// the ~50 `workspaceId` columns scopes to exactly one workspace. It belongs to
// one Organization; a user joins it via `WorkspaceMember` with a per-workspace
// `Role`. Inbox/operational config + per-role permission overrides live here.
model Workspace {
  id             String       @id @default(cuid())
  name           String
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Per-workspace channel credentials live in `ChannelConnection`, one row per
  // (workspaceId, channel, externalAccountId). Adding a channel = insert a row,
  // not add a column-set. CLAUDE.md rule #6.

  // Contact panel built-in field visibility. JSON map of built-in field key →
  // boolean. Missing key = visible (preserves backwards compat: existing teams
  // see all built-ins until an admin explicitly hides one). Phone is never
  // hideable — it's the WhatsApp identity and always renders. Custom fields
  // have their own per-row `isVisible` on ContactFieldDefinition.
  //
  // Supported keys (canonical shape: packages/shared/src/types.ts
  // `ContactPanelBuiltins`): "firstName" | "lastName" | "email" | "location" |
  // "language" | "country" | "firstContacted". NOTE the key for the ISO
  // alpha-2 column is "country" (NOT "countryCode") — the short key keeps the
  // settings UI readable. Adding more built-ins later just means extending
  // that interface + rendering — no schema bump (missing key = visible).
  contactPanelBuiltins Json @default("{}")

  // Per-role capability overrides, set by a team admin. Sparse JSON of the
  // shape `{ manager?: { "<capability>": boolean }, agent?: {...} }`. Missing
  // key = the default in packages/shared/src/auth/permissions.ts (which
  // reproduces pre-feature behavior, so an un-configured team is unchanged).
  // admin/superAdmin are never stored here — they're always-allowed and not
  // editable, so the org owner can't be locked out of their own org.
  rolePermissions Json @default("{}")

  // Org-default working hours — the schedule every member inherits unless they
  // set `workHoursMode = "custom"` (or opt out with "off"). Null = the team has
  // no schedule, which is the default and reproduces pre-feature behavior
  // exactly: availability stays purely manual until an admin fills this in.
  // Shape: @ccp/shared/work-hours `WorkHours`.
  workHours Json?

  // Can an AGENT see the whole team's conversations, or only the ones assigned
  // to them?
  //
  //   "team"     — everyone sees everything (default; today's behavior).
  //   "assigned" — role `agent` sees ONLY conversations currently assigned to
  //                them. admin / manager / superAdmin always see everything.
  //
  // This is a RESTRICTION, so it is deliberately NOT modelled as a Capability:
  // that system is a grant matrix whose defaults are all-true to preserve
  // legacy behavior, and inverting one entry there would read backwards.
  //
  // Scoping keys on the CURRENT assignee, never on message authorship. That is
  // what makes a hand-off work: when an admin moves a thread from Ali to Sara,
  // Sara sees the ENTIRE history — every message, note and event, including
  // Ali's — and simply continues. Ali drops out of it at the same moment.
  agentConversationVisibility String @default("team")

  // AI Autopilot opt-in. OFF for every new org — the per-conversation AI
  // controls (the inbox toggle, auto-pause-on-human-reply, the activity pills)
  // only appear once an admin turns this on after wiring their AI/n8n flow.
  // When false the feature is invisible: no AI ever runs (no webhook anyway),
  // a human reply does NOT write an "AI paused" pill, and the header toggle is
  // hidden. The per-conversation `Conversation.aiEnabled` flag still exists
  // (default true) but is only meaningful when this team flag is on.
  aiAutopilotEnabled Boolean @default(false)

  // What to do with a conversation when the CUSTOMER hands off to a human
  // (the AI flow calls /v1/.../ai with applyHandoffPolicy:true). Only that
  // path applies this — pausing the AI is the critical action; the assignment
  // side-effect is best-effort and never fails the pause. See AiHandoffAction.
  aiHandoffAction          AiHandoffAction   @default(none)
  // Fixed assignee for aiHandoffAction = assign_fixed. SetNull on user delete
  // so removing that member degrades to "leave unassigned", not a broken FK.
  aiHandoffAssigneeId      String?
  // Round-robin rotation cursor (last user picked) for aiHandoffAction =
  // round_robin AND the workflow assign_to round_robin mode — both read/write
  // this same cursor via pickRoundRobinAssignee. Nullable = start of rotation.
  aiRoundRobinCursorUserId String?
  // Who greets at the start of a session. `workflow` suppresses the AI on the
  // first inbound of a session (the welcome workflow handles it); the rest of
  // the session still gets the AI. See FirstTouchGreeter.
  firstTouchGreeter        FirstTouchGreeter @default(ai)

  // ---- Ticketing ----
  // There is NO auto-open. A ticket is a deliberate act — raised by an agent
  // from the inbox or by a workflow's `create_ticket` step — never minted just
  // because a customer messaged. Auto-opening on every inbound made a ticket
  // mean the same thing as a conversation (the inbox already tracks every
  // thread), filling the board with work nobody raised. The toggle that used to
  // live here (`ticketAutoOpen`) was removed 2026-07-25.
  //
  // How long after a ticket is SOLVED a follow-up message reopens it instead of
  // opening a new one. This is the single most-debatable rule in ticketing —
  // too short and one issue becomes three tickets, too long and a genuinely new
  // question gets buried in resolved work — so it is a per-workspace setting,
  // not a constant. 72h is the helpdesk norm (Zendesk's default). 0 disables
  // reopening: every message after `solved` starts fresh.
  ticketReopenWindowHours             Int     @default(72)
  // Close the CONVERSATION when its last non-terminal ticket is solved.
  // OFF by default and deliberately so: conversation status and ticket status
  // are decoupled, because coupling them in both directions is exactly the
  // recursive event chain §18 forbids. When on, the write is a one-way,
  // idempotent CAS (ticket → conversation, never back).
  ticketCloseConversationOnLastSolved Boolean @default(false)

  // Users + invites belong to the ORGANIZATION now, not the workspace.
  // Membership of a user in THIS workspace is `WorkspaceMember` (per-workspace role).
  // Seat cap for THIS workspace. Set by a super admin. Default 2 matches the
  // old org-wide default, so a single-workspace org sees no change.
  maxMembers Int @default(2)

  members                 WorkspaceMember[]
  contacts                Contact[]
  customers               Customer[]
  conversations           Conversation[]
  messages                Message[]
  contactFieldDefinitions ContactFieldDefinition[]
  contactTransferJobs     ContactTransferJob[]
  contactStages           ContactStage[]
  messageTemplates        MessageTemplate[]
  broadcasts              Broadcast[]
  tags                    Tag[]
  messageFlagDefinitions  MessageFlagDefinition[]
  messageFlags            MessageFlag[]
  inboxViews              InboxView[]
  ticketViews             TicketView[]
  templateAnalytics       TemplateAnalyticsDaily[]
  tickets                 Ticket[]
  ticketEvents            TicketEvent[]
  ticketSlaPolicies       TicketSlaPolicy[]
  ticketFieldDefinitions  TicketFieldDefinition[]
  ticketNumberCounter     TicketNumberCounter?
  ticketSharesOut         TicketShare[]            @relation("TicketSharesOut")
  ticketSharesIn          TicketShare[]            @relation("TicketSharesIn")
  ticketAttachments       TicketAttachment[]
  ticketEventsActedIn     TicketEvent[]            @relation("TicketEventActorWorkspace")
  audienceGroups          AudienceGroup[]
  workflows               Workflow[]
  workflowRuns            WorkflowRun[]
  workflowContactStates   WorkflowContactState[]
  workflowAwaitingReplies WorkflowAwaitingReply[]
  apiKeys                 WorkspaceApiKey[]
  outboundWebhooks        OutboundWebhook[]
  snippets                Snippet[]
  conversationEvents      ConversationEvent[]
  internalNotes           InternalNote[]
  teamChannels            TeamChannel[]
  teamChannelMessages     TeamChannelMessage[]
  outboundEvents          OutboundEvent[]
  outboundSendAttempts    OutboundSendAttempt[]
  channelConnections      ChannelConnection[]
  whatsappPortfolios      WhatsappPortfolio[]
  whatsappBusinessAccounts WhatsappBusinessAccount[]
  webchatWidgets          WebchatWidget[]
  metaConnection          MetaConnection?
  calls                   Call[]
  callPermissionRequests  CallPermissionRequest[]
  customerIdentityEvents  CustomerIdentityEvent[]
  assignmentPolicies      AssignmentPolicy[]
  assignmentRules         AssignmentRule[]
  assignmentSettings      AssignmentSettings?
  aiHandoffAssignee       User?                    @relation("AiHandoffAssignee", fields: [aiHandoffAssigneeId], references: [id], onDelete: SetNull)

  // --- Native AI Assistant subsystem (SEPARATE from the legacy autopilot/n8n
  // fields above: aiAutopilotEnabled / aiHandoff* / firstTouchGreeter). Nothing
  // here is shared with that system; the ConversationAutomationClaim row is the
  // atomic arbiter that keeps the two from ever answering the same message.
  aiAssistantConfig       AiAssistantConfig?
  aiContextDocuments      AiContextDocument[]
  aiContextChunks         AiContextChunk[]
  aiConversationStates    AiConversationState[]
  aiAutomationClaims      ConversationAutomationClaim[]
  aiSessionSummaries      ConversationSessionSummary[]
  aiCustomerMemories      AiCustomerMemory[]
  aiMessageMetadata       AiMessageMetadata[]
  aiMessageTranscriptions AiMessageTranscription[]
  aiInteractions          AiAssistantInteraction[]
  aiReplySuggestions      AiReplySuggestion[]
  invites                 Invite[]

  @@index([organizationId])
}

// Join table: a user's membership + role in ONE workspace. A user (org-scoped)
// joins many workspaces, each with its own Role. This is the per-workspace
// authorization unit read by resolveSession to compute the active workspaceRole.
model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(agent)
  // Plain id, no relation (audit-trail discipline: deleting the actor never
  // cascades into a membership row).
  addedById   String?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

// Per-(workspace, channel, account) connection: credentials + settings for one provider.
// Replaces the flat `Workspace.meta*` columns so adding a channel = insert a row,
// not add a column-set. `config` holds non-secret values (phone number id,
// waba id, app id, verify token, display number); `secrets` holds the
// envelope-encrypted ciphertext per field (access token, app secret) — same
// crypto boundary as before, just relocated. One row per channel per team.
model ChannelConnection {
  id                String    @id @default(cuid())
  workspaceId       String
  channel           Channel
  // The PROVIDER's own id for this account: WhatsApp phoneNumberId, Messenger
  // pageId, Instagram igId. Promoted out of `config` into a top-level indexed
  // column so an inbound webhook resolves its account in ONE indexed lookup
  // instead of scanning JSON — the same move `WebchatWidget.publicKey` already
  // makes for the widget channel. This is what makes a workspace able to hold
  // SEVERAL accounts of one channel.
  externalAccountId String    @default("")
  // Human label shown to agents when a channel has more than one account
  // ("Sales line", "Support UK"). Mirrors WebchatWidget.name.
  label             String?
  // The account outbound-initiated sends and broadcasts default to when the
  // workspace has several on this channel. Exactly one per (workspace, channel).
  isDefault         Boolean   @default(false)
  // WhatsApp only. The WhatsappBusinessAccount (WABA) this number belongs to —
  // Meta's real hierarchy is portfolio → WABA → phone number, so the portfolio
  // link lives on the WABA, NOT here.
  //
  // Nullable because (a) Messenger/Instagram rows have no WABA and (b) the
  // settings pre-mint creates a credential-less placeholder before any WABA is
  // known. It is NOT "no opinion": every WhatsApp send guard treats a null WABA
  // as a hard refusal (`waba_unknown`), never as permission. Connecting a number
  // requires `wabaId` in the request.
  wabaAccountId     String?
  config            Json      @default("{}")
  secrets           Json      @default("{}")
  isActive          Boolean   @default(true)
  // Set when a send fails with Graph error 190 (access token expired/revoked) so
  // Settings can surface a "reconnect" banner and admins are prompted to re-issue
  // the token — per Meta's access-token best practice. Cleared on reconnect.
  needsReconnect    Boolean   @default(false)
  lastAuthErrorAt   DateTime?

  // WhatsApp COEXISTENCE: this business phone number is registered for Cloud API
  // AND still in use in the WhatsApp Business app (Meta's `is_on_biz_app` on the
  // phone-number node; `platform_type` reads CLOUD_API for both).
  //
  // Load-bearing for BROADCAST PACING, not decoration. Meta hard-caps a
  // simultaneously-app-used number at 20 messages/second — a fixed ceiling, not the
  // 80/1000 throughput ladder every other number follows. Pacing such a number at
  // the STANDARD target (75/s) is ~4x over it, which earns sustained 130429s
  // mid-campaign and drags down the quality rating of exactly the fragile numbers
  // Coexistence exists for (a small business's own handset).
  //
  // Null = not yet polled → treated as NOT coexistence, because the ordinary
  // ladder is the common case and `resolveSendRate`'s unknown-throughput baseline
  // already errs slow.
  isOnBusinessApp   Boolean?

  // ── WhatsApp messaging-health snapshot (whatsapp channel only) ────────────
  // Cached from Meta so large broadcasts can be gated BEFORE sending: WhatsApp
  // limits how many UNIQUE customers a business phone number may message in a
  // rolling 24h to its messaging-limit TIER, and quality/throughput govern how
  // fast and whether the number is healthy. Populated two ways (both best-effort,
  // both idempotent): (1) the `phone_number_quality_update` / `account_alerts` /
  // `business_capability_update` webhooks Meta pushes; (2) a periodic GET on the
  // phone-number node. All nullable — a connection with no snapshot yet is simply
  // ungated (the runner + Meta still enforce the real limit; the snapshot only
  // powers the pre-send warning + composer display). Stored as raw strings (not
  // enums) because Meta's tier/quality vocab churns and we never want a migration
  // just to track a new vendor value.
  //
  // NOTE: `messagingTier` / `messagingDailyCap` used to live here. They moved to
  // `WhatsappPortfolio` — since 2025-10-07 Meta's 24h messaging limit is scoped
  // to the BUSINESS PORTFOLIO and shared by every number in it, so holding the
  // cap per-number let a portfolio's true budget be counted once per number.
  // Quality + throughput below stay here: both are genuinely per-number.
  //
  // Quality rating band: "GREEN" | "YELLOW" | "RED". RED = degraded, at risk of
  // a tier downgrade — surfaced as a composer warning.
  qualityRating            String?
  // Throughput level: "STANDARD" (~80 msg/s) | "HIGH" (up to ~1000 msg/s). Drives
  // the runner's adaptive send pacing.
  throughputLevel          String?
  // When the snapshot above was last refreshed (webhook or poll).
  messagingHealthUpdatedAt DateTime?

  // Calling enforcement, mirrored from the provider's account webhooks.
  //
  // While a restriction is active, every call attempt AND every call-permission
  // request fails. Storing it turns "calling stopped working" into a dated,
  // explainable banner — without it a tenant sees a week of unexplained
  // rejections and support can't distinguish enforcement from a bug.
  // Null = unrestricted; otherwise the provider's own expiry.
  callingRestrictedUntil   DateTime?
  callingRestrictionType   String?
  callingRestrictionReason String?
  // The provider's EARLY warning that call quality is trending badly, sent
  // before any restriction bites. Actionable while it's still only a warning:
  // hiding call icons or narrowing call hours can head off the pause.
  callingQualityWarning    String?
  // A WhatsApp Business POLICY violation (`account_update` →
  // `ACCOUNT_VIOLATION`), e.g. "ALCOHOL". Distinct from the calling warning
  // above, which is the same webhook narrowed to CALLING violations — a
  // non-calling violation used to be parsed and then dropped on the floor.
  //
  // Meta's own docs name this webhook as the notification channel for policy
  // violations, and a restriction follows if it isn't addressed. Storing it is
  // what turns "our account got restricted out of nowhere" into a dated warning
  // the operator saw first.
  policyViolationType      String?
  policyViolationAt        DateTime?

  // ── Number identity, as Meta has verified it (WhatsApp only) ──────────────
  // `verifiedName` is the display name customers see; `nameStatus` is its
  // review state (Meta vocabulary, raw: APPROVED | AVAILABLE_WITHOUT_REVIEW |
  // DECLINED | EXPIRED | PENDING_REVIEW | NONE). Load-bearing beyond cosmetics:
  // a NONE/EXPIRED name means the number has no certificate and cannot be
  // registered for Cloud API, and a DECLINED rename silently keeps the old
  // name — both were invisible before these columns (the connect flow fetched
  // verified_name and threw it away). Written at connect and by the
  // `phone_number_name_update` webhook; NOT in `config` because settings saves
  // rebuild that JSON wholesale and would clobber webhook writes.
  verifiedName String?
  nameStatus   String?

  // The LAST account-level alert Meta sent that we have no dedicated field
  // for: an `account_update` event outside the parsed set (the class where
  // "app removed from WABA" will land) or an `account_alerts` envelope. One
  // slot, last-writer-wins — an operator needs the latest reason the account
  // went weird, not a ledger. Shape:
  //   { source: "account_update"|"account_alerts", event, detail, observedAt }
  // Written at WABA scope by ingest; cleared by a fresh connect save. Without
  // it these webhooks were warn-logged at info severity and lost.
  lastAccountAlert Json?

  // Template-categorization enforcement (Meta's "restrictions on businesses
  // misusing the template categorization system"). When Meta detects utility
  // templates that should be marketing, it escalates: rate-limiting utility
  // sends on the WABA, then recategorizing + blocking new utility templates.
  // Raw `restriction_type` (RATE_LIMITED_UTILITY_TEMPLATE_MESSAGING |
  // RESTRICTED_UTILITY_TEMPLATES) + Meta's own expiry. WABA-scoped like the
  // calling enforcement above; cleared by the *_UNBAN / *_RECOVERY webhook.
  // First-class (not just `lastAccountAlert`) because the composer must WARN
  // before an operator fires a utility campaign into a rate-limited WABA.
  utilityRestrictionType String?
  utilityRestrictedUntil DateTime?

  // Policy/spam MESSAGING enforcement (`account_update` → ACCOUNT_RESTRICTION /
  // DISABLED_UPDATE — the policy-enforcement guide's escalation ladder: 1/3-day
  // blocks on business-initiated template sends, 5/7/30-day blocks on ALL
  // messages, then an indefinite account lock or disable). Each direction gates
  // a different surface — business-initiated = broadcasts/templates/proactive,
  // customer-initiated = even replies inside the service window — so each is
  // its own (type, until) pair. The TYPE is the presence marker: an indefinite
  // lock/ban carries NO expiry, so a set type with a null `until` means "until
  // Meta reverses it on appeal". `WABA_BAN_*` values mirror
  // `ban_info.waba_ban_state` (REINSTATE clears both pairs). Surfaced as
  // ADVISORY warnings only (composer + health banner) — Meta is the
  // enforcement authority, and a stale local copy must never block a send
  // Meta would accept. WABA-scoped like the enforcement fields above.
  bizMessagingRestrictionType      String?
  bizMessagingRestrictedUntil      DateTime?
  customerMessagingRestrictionType String?
  customerMessagingRestrictedUntil DateTime?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wabaAccount   WhatsappBusinessAccount? @relation(fields: [wabaAccountId], references: [id], onDelete: SetNull)
  // Threads bound to this account. SetNull on the far side, so removing an
  // account never deletes conversation history.
  conversations Conversation[]
  broadcasts    Broadcast[]

  // One row per ACCOUNT, not per channel: a workspace may connect several
  // WhatsApp numbers / Pages / IG handles. `externalAccountId` is the provider's
  // own id, so re-connecting the same number updates rather than duplicates.
  @@unique([workspaceId, channel, externalAccountId])
  // EXACTLY ONE DEFAULT per (workspace, channel) is enforced by a PARTIAL unique
  // index Prisma can't express:
  //   ChannelConnection_one_default_per_channel ON (workspaceId, channel)
  //   WHERE "isDefault"
  // created in raw SQL by migration 20260723160000. A plain
  // @@unique([workspaceId, channel]) would forbid holding several accounts on
  // one channel — the whole point of this table. Load-bearing because every
  // read of the default is `findFirst({ isDefault: true })`: with two, which
  // number a broadcast sends from is whatever Postgres returns first.
  // "which accounts does this workspace have on channel X" — the connected-set
  // read on every send/route decision.
  @@index([workspaceId, channel])
  // Inbound resolution: payload account id → the owning connection.
  @@index([channel, externalAccountId])
  // "every number under this WABA" — the fan-out target for WABA-scoped
  // enforcement writes, and the credential fallback for a WABA whose own token
  // isn't set. Also backs the FK's SetNull scan on WABA delete.
  @@index([wabaAccountId])
}

/// A WhatsApp Business Account (WABA).
///
/// Meta's hierarchy is business portfolio → WABA → business phone number, and
/// this is the middle term that used to be a bare string column repeated on every
/// number (plus a duplicate copy inside `ChannelConnection.config`). It is the:
///   - TEMPLATE CATALOG boundary — numbers under one WABA share templates, so two
///     WABAs in one workspace may each hold a template of the same
///     (name, language);
///   - WEBHOOK SUBJECT for every `object:"whatsapp_business_account"` topic;
///   - unit a customer-scoped business token is issued for under Embedded Signup
///     (ONE per customer/WABA install, not one per phone number).
///
/// IT EXISTS WITH ZERO PHONE NUMBERS. Embedded Signup's `FINISH_ONLY_WABA` finish
/// event is a completed onboarding with no number attached, and that WABA's
/// template + account-level webhooks start arriving immediately. Any code that
/// assumes a WABA implies a ChannelConnection is wrong.
model WhatsappBusinessAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  /// Meta's WABA id. NOT NULL and GLOBALLY unique — not merely unique per
  /// workspace.
  ///
  /// TENANCY GUARD, not a tidiness constraint. Meta delivers a WABA's webhooks to
  /// whichever app is subscribed to it, so two workspaces both claiming one WABA
  /// means one of them silently receives nothing — and under the app-level
  /// callback (where the workspace is resolved FROM the payload, not the URL) it
  /// would route one tenant's messages into another tenant's inbox. This index is
  /// what makes payload → workspace a single indexed read, and what makes the
  /// second workspace's connect attempt fail loudly instead of quietly.
  externalWabaId    String    @unique
  /// The business portfolio that owns this WABA. Meta puts `owner_business_info`
  /// on the WABA node, so this is where the link belongs — hanging it off the
  /// phone number let the DB express a state Meta cannot produce (two numbers of
  /// one WABA in different portfolios) and forced a three-tier attribution
  /// heuristic to defend against it.
  ///
  /// Null until a token with `business_management` resolves it, or until Embedded
  /// Signup hands us `business_id` directly.
  portfolioId       String?
  /// Operator-facing label, for a workspace holding several WABAs.
  label             String?
  /// Envelope-encrypted (AES-256-GCM, ENCRYPTION_KEY) — same crypto boundary as
  /// ChannelConnection.secrets, never plaintext. Holds `{ accessToken }`: the
  /// customer-scoped business token Embedded Signup issues per (customer, WABA).
  /// Preferred over the per-connection token when present, so an ES tenant stores
  /// and rotates ONE token instead of one copy per number.
  secrets           Json      @default("{}")
  /// When `POST /{WABA_ID}/subscribed_apps` was last confirmed. Meta only
  /// delivers `object:"whatsapp_business_account"` webhooks for WABAs the app is
  /// explicitly subscribed to, and a dashboard re-save can silently reset it.
  subscribedAt      DateTime?
  /// When template analytics were switched on (`is_enabled_for_insights=true`).
  ///
  /// IRREVERSIBLE and one-time, so it is never fired implicitly by a fetch — an
  /// admin confirms it explicitly. Lives HERE because it is a field on the WABA
  /// node; it was previously stored per phone number, which meant N rows recording
  /// one WABA-wide fact.
  insightsEnabledAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  portfolio   WhatsappPortfolio?  @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  connections ChannelConnection[]
  templates   MessageTemplate[]

  @@index([workspaceId])
  @@index([portfolioId])
}

/// A Meta BUSINESS PORTFOLIO. Since 2025-10-07 the WhatsApp 24h messaging limit
/// (max unique recipients messaged outside a customer-service window) is scoped
/// here and SHARED by every phone number in the portfolio — it is no longer a
/// per-number budget. Throughput (msg/s) stays per-number on ChannelConnection.
model WhatsappPortfolio {
  id                       String    @id @default(cuid())
  workspaceId              String
  /// Meta's business-portfolio id. Null until we've read it from Graph.
  externalPortfolioId      String?
  /// Raw tier, e.g. "TIER_250" | "TIER_2K" | "TIER_10K" | "TIER_100K" | "TIER_UNLIMITED".
  messagingTier            String?
  /// Derived numeric 24h unique-recipient cap. Null = UNLIMITED or unknown
  /// (unknown deliberately means "ungated" rather than "blocked").
  messagingDailyCap        Int?
  /// Meta's `verification_status` for the portfolio, raw ("verified" |
  /// "not_verified" | "pending" | …). Null until read from Graph.
  ///
  /// Load-bearing for ONE thing: the TEMPLATE limit. Meta scopes it to the
  /// parent portfolio — an unverified portfolio caps each of its WABAs at 250
  /// templates, a verified one at up to 6,000. Stored raw (not a boolean) for
  /// the same reason as `messagingTier`: Meta's vocabulary churns and we never
  /// want a migration to track a new vendor value.
  verificationStatus       String?
  /// Where this row's identity came from. `local` is already derivable from a null
  /// `externalPortfolioId`, but the ES-vs-Graph split is not: Embedded Signup hands
  /// us `business_id` UNVERIFIED (the customer picked it in the flow), whereas
  /// `graph_discovered` was read back from `owner_business_info` on the WABA node.
  /// Also lets the UI say "not linked yet — grant business_management and re-save"
  /// instead of showing a null external id, which reads as a bug.
  source                   WhatsappPortfolioSource @default(local)
  /// Meta's `max_phone_numbers_per_business`. A NEW business portfolio is capped
  /// at 2 REGISTERED business phone numbers; business verification (or reaching a
  /// 2,000 messaging limit) raises it to 20, announced on the
  /// `business_capability_update` webhook. Null = unknown, which means UNGATED —
  /// same posture as `messagingDailyCap`.
  maxPhoneNumbers          Int?
  messagingHealthUpdatedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Portfolio → WABA → phone number. Numbers reach their portfolio through the
  /// WABA, which is where Meta actually records the ownership.
  wabaAccounts WhatsappBusinessAccount[]

  @@unique([workspaceId, externalPortfolioId])
  @@index([workspaceId])
}

/// How a WhatsappPortfolio row learned its identity. See `WhatsappPortfolio.source`.
enum WhatsappPortfolioSource {
  /// Embedded Signup returned `business_id` directly. Customer-asserted, not yet
  /// verified against Graph.
  embedded_signup
  /// Read back from `owner_business_info` on the WABA node.
  graph_discovered
  /// A local container minted by the health self-heal so a tier has somewhere to
  /// live; carries no external id and is garbage-collected when orphaned.
  local
}

// A single embeddable website chat widget. Unlike the Meta channels — where a
// team has exactly ONE ChannelConnection per channel — a team runs MANY named
// widgets (one per website they own: "Acme Store", "Support Portal", …), each
// with its own public site key, embed origins, and appearance. So widgets are
// their own rows, not a ChannelConnection: the `webchatwidget` channel is
// "connected" for a team iff it has ≥1 active WebchatWidget (see
// getWebchatwidgetSendConfig). Every webchatwidget Conversation is stamped with
// its source widget (Conversation.webchatWidgetId) so the inbox shows which
// website a chat came from.
model WebchatWidget {
  id              String   @id @default(cuid())
  workspaceId     String
  // Human name shown to agents ("which website is this chat from").
  name            String
  // Public site key embedded in the <script> tag (`wc_pk_<hex>`). Safe-in-HTML;
  // abuse is bounded by allowedOrigins + rate limits, not secrecy. Globally
  // unique so an anonymous visitor handshake resolves (team, widget) with ONE
  // indexed lookup instead of scanning JSON.
  publicKey       String   @unique
  // Origins allowed to embed this widget: "example.com" or "*.example.com".
  // EMPTY = permissive (any site), deliberately: a brand-new widget must work on
  // the customer's page before they've configured anything. See `firstSeenOrigin`
  // for how that gets closed without breaking first-run.
  allowedOrigins  String[] @default([])
  // Host of the FIRST non-loopback page that ever embedded this widget, recorded
  // write-once and only while `allowedOrigins` is still empty.
  //
  // The site key is public by design (it sits in the page source of every customer
  // site), so an unlocked widget can be lifted and embedded on a phishing page —
  // the visitor believes they're talking to the brand and the agent sees an
  // ordinary conversation. Requiring a domain up front would instead break every
  // widget before its first message, so we do trust-on-first-use: observe the real
  // domain, then let Settings offer a one-click lock at the moment the value is
  // obviously correct. Purely a SUGGESTION — it never gates a connection itself.
  firstSeenOrigin String?
  // Non-secret appearance + pre-chat config the widget fetches (theme,
  // welcomeMessage, headerTitle, suggestedQuestions, preChatFields, showBranding).
  config          Json     @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId])
}

// Shared Meta-app credentials for a team — the ONE App ID + App secret +
// system-user token + verify token that power all Meta channels (WhatsApp,
// Messenger, Instagram). Meta serves them from a single app behind a single
// callback URL, so these are set once here and every ChannelConnection sources
// them from this row (the per-channel `ChannelConnection.secrets` remain a
// fallback for connections created before this table). Page access tokens for
// Messenger/Instagram are derived from `systemUserToken` on demand. This is the
// exact record Embedded Signup will later populate from one Facebook-Login grant.
// `config` holds non-secret values (appId, verifyToken, graphVersion);
// `secrets` holds envelope-encrypted ciphertext (appSecret, systemUserToken).
model MetaConnection {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  config      Json      @default("{}")
  secrets     Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model User {
  id                  String    @id @default(cuid())
  // A user belongs to exactly one Organization. Per-workspace role lives on
  // WorkspaceMember; this is the org-directory role + the platform flag.
  organizationId      String
  orgRole             OrgRole   @default(member)
  // Platform-level operator (replaces the old Role.superAdmin). Bypasses the
  // org-approval gate and every workspace permission check.
  isSuperAdmin        Boolean   @default(false)
  name                String
  // Globally unique: a user belongs to one org, so one login = one identity.
  email               String    @unique
  // Has this person proven they control this inbox?
  //
  // Default FALSE as of 2026-07-23. It used to be true, which meant any string
  // matching an email regex created a working account — the signup flow was a
  // demo, not a product. A new password signup is now unverified until a 6-digit
  // OTP is confirmed, and `resolveSession` refuses to act for an unverified
  // user (the API is the boundary — a UI-only redirect would leave every
  // endpoint open to an unverified session).
  //
  // Two paths set it TRUE without an OTP, both because the address is already
  // proven: Google sign-in (the provider asserts a verified email) and invite
  // acceptance (the invite link landed in that inbox, which IS the proof).
  // Existing rows were backfilled to true by the migration — they were all
  // vouched for by the invite flow.
  emailVerified       Boolean   @default(false)
  // Mapped to Better Auth's `image` field via lib/auth/better-auth.ts so the
  // column name stays domain-meaningful while Better Auth sees the standard
  // field name in session payloads.
  avatarUrl           String?
  // Soft-disable: keeps FK history intact (authored messages, assignments).
  deactivatedAt       DateTime?
  // User-controlled availability. "available" is the implicit default for the
  // UI when null (kept nullable so the migration doesn't have to backfill
  // every existing row). "offline" hides the user from teammates' online dots
  // even while their socket is connected — they still receive events for when
  // they come back, but they appear away. Plain string column rather than a
  // Prisma enum so adding a new state (e.g. "in_a_meeting") is a non-migration
  // change; the Zod schema at the API boundary is the validation gate.
  //
  // NOTE since working hours landed: this pair is the EFFECTIVE status — what
  // teammates actually see. It equals the manual pick below when no schedule
  // applies, and the schedule-derived value once one does. Every reader (the
  // realtime gateway, round-robin, mapUser, every UI dot) reads THIS and never
  // recomputes the rule. Writers all go through lib/availability/apply.ts.
  availabilityStatus  String?   @default("available")
  // Optional free-form note teammates see ("Back at 3pm", "On a call").
  // Bounded to 100 chars at the API; column is short for sane payloads.
  availabilityMessage String?

  // --- Working hours & the manual pick behind the effective status ---
  //
  // What the person (or an admin acting for them) actually chose. Kept apart
  // from the effective pair so an off-shift stretch doesn't destroy the note
  // they typed — when the shift starts again their own pick is still here.
  availabilityManualStatus  String?
  availabilityManualMessage String?
  // "manual" | "admin" | "schedule" — who decided the effective status.
  availabilitySource        String?   @default("manual")
  // The admin who set it, when source = "admin". Plain id, NO relation: the
  // same discipline as Workspace.statusUpdatedById — deleting the acting admin must
  // never cascade into, or null out, a teammate's availability row.
  availabilitySetByUserId   String?
  // While in the future, the manual pick out-ranks the schedule. Set to the
  // next schedule boundary on every manual pick, so "set busy at 2pm and drive
  // home at 5" self-corrects at shift end instead of lasting forever. Null
  // when no schedule applies (the pick then holds indefinitely, as it always
  // did).
  availabilityOverrideUntil DateTime?
  // "inherit" (team default) | "custom" (own `workHours`) | "off" (no schedule).
  workHoursMode             String    @default("inherit")
  // Own schedule when mode = "custom". Shape: @ccp/shared/work-hours WorkHours
  // ({ timezone, weekly, exceptions }). JSON, not columns, because it's a
  // whole-value setting always read and written together — same reasoning as
  // AiAssistantConfig's opening hours.
  workHours                 Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceMemberships    WorkspaceMember[]
  authoredMsgs            Message[]                @relation("AuthoredMessages")
  authoredNotes           InternalNote[]
  createdMessageFlags     MessageFlag[]            @relation("CreatedMessageFlags")
  assignedMessageFlags    MessageFlag[]            @relation("AssignedMessageFlags")
  resolvedMessageFlags    MessageFlag[]            @relation("ResolvedMessageFlags")
  assignedTickets         Ticket[]                 @relation("AssignedTickets")
  resolvedTickets         Ticket[]                 @relation("ResolvedTickets")
  ticketEvents            TicketEvent[]
  ticketShares            TicketShare[]
  assignedTicketShares    TicketShare[]            @relation("TicketShareAssignee")
  ticketAttachments       TicketAttachment[]
  assignedConvos          Conversation[]           @relation("AssignedConversations")
  createdInvites          Invite[]                 @relation("InvitedBy")
  createdBroadcasts       Broadcast[]              @relation("CreatedBroadcasts")
  createdAudienceGroups   AudienceGroup[]          @relation("CreatedAudienceGroups")
  contactTransferJobs     ContactTransferJob[]     @relation("ContactTransferJobs")
  createdSnippets         Snippet[]                @relation("CreatedSnippets")
  // Saved inbox views. SetNull on the view side (not Cascade) so a SHARED view
  // survives its author leaving; personal views are cleaned up explicitly.
  createdInboxViews       InboxView[]              @relation("CreatedInboxViews")
  createdTicketViews      TicketView[]             @relation("CreatedTicketViews")
  // Audit-log authorship. Nullable on the event row + SetNull so deleting a
  // user keeps the audit trail; the timeline just renders "Removed user".
  authoredEvents          ConversationEvent[]
  // Workspace-chat (internal messaging between agents). All SetNull on user delete
  // so deactivating a teammate leaves their messages, reactions, pins, and
  // mentions in place with a "Removed user" actor label — same audit-trail
  // discipline as customer conversations.
  createdChannels         TeamChannel[]            @relation("CreatedChannels")
  authoredChannelMessages TeamChannelMessage[]     @relation("AuthoredChannelMessages")
  channelReactions        TeamChannelReaction[]    @relation("ChannelReactions")
  channelMentions         TeamChannelMention[]     @relation("ChannelMentions")
  pinnedChannelMessages   TeamChannelPin[]         @relation("PinnedMessages")
  channelReadReceipts     TeamChannelReadReceipt[]
  channelMemberships      TeamChannelMember[]      @relation("ChannelMemberships")
  addedChannelMembers     TeamChannelMember[]      @relation("AddedChannelMembers")
  // Outbound voice calls this user placed.
  initiatedCalls          Call[]                   @relation("InitiatedCalls")
  // Voice calls this user answered (CAS-won the "who answered first" race).
  // SetNull on user delete so call audit history survives deactivation, same
  // discipline as authoredMsgs / authoredNotes.
  answeredCalls           Call[]                   @relation("AnsweredCalls")
  sessions                Session[]
  accounts                Account[]
  // Teams that route customer-initiated AI handoffs to this user (assign_fixed
  // mode). SetNull on delete so removing the member degrades the team setting
  // to "leave unassigned" rather than orphaning the FK.
  aiHandoffForWorkspaces  Workspace[]              @relation("AiHandoffAssignee")
  assignmentMemberships   AssignmentPolicyMember[] @relation("AssignmentPolicyMemberships")

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Better Auth tables. Names + columns match the framework's expected schema
// (see @better-auth/core/db/get-tables.ts). DO NOT rename columns without
// also configuring the matching `fields` map in lib/auth/better-auth.ts —
// the adapter reads/writes by these exact names.
// ---------------------------------------------------------------------------

// One row per active sign-in. Cookie holds `token`; everything else is
// looked up server-side. Deleting a row signs the user out from that device.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Server-side truth for THIS device's active workspace. The `ccp.ws` cookie
  // carries a candidate, but it is client input and is never trusted raw —
  // resolveSession validates it against the user's WorkspaceMember set and
  // falls back to this column (then to the user's first membership). The
  // switch endpoint writes here so a workspace choice survives a cookie wipe
  // and stays per-device rather than global to the user.
  // NO FK on purpose: this is CANDIDATE data, validated on every read by
  // `resolveActiveWorkspaceId` + the beyond-membership rule — a dangling id
  // can never widen access, it just falls through to the next candidate.
  // Better Auth owns this hot table; dangling ids are re-pointed manually on
  // workspace delete (workspaces.service.ts).
  activeWorkspaceId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The daily auth cleanup deletes by `expiresAt < now()`. With only the userId
  // index that was a sequential scan of every session row — the table grows with
  // logins, so the sweep got slower forever while holding the sweeper mutex.
  @@index([expiresAt])
}

// Credential / OAuth account record. For our email+password users the row
// has providerId="credential", accountId=email, and password=<bcrypt hash>.
// OAuth providers (future) populate access/refresh/idToken instead.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived tokens for email verification, password reset, etc. Not used
// by our current invite flow (that's the separate Invite model) but Better
// Auth requires the table to exist for any verification-style endpoints.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Saved canned response. Agents trigger one in the reply box by typing
// `/<name>` — the picker filters by prefix, then the chosen snippet's body
// replaces the trigger text with `$var.contact.*` tokens already resolved
// against the active conversation's contact.
//
// Workspace-wide for v1: anyone can create / use / edit. Per-user (private)
// snippets are a later add-on; we'd add a nullable `ownerUserId` field then.
model Snippet {
  id          String   @id @default(cuid())
  workspaceId String
  // Lowercase, digits, underscores. Becomes the slash trigger:
  //   name = "welcome_new_user" → `/welcome_new_user` in the reply box.
  // Unique per-team so two snippets can't fight for the same trigger.
  name        String
  // Friendly title shown in the picker ("Welcome new customer"). Searchable.
  label       String
  // The text inserted into the reply. May contain `$var.contact.<field>`
  // tokens which the picker resolves at insertion time against the active
  // conversation's contact.
  body        String
  // Nullable + SetNull so deleting a teammate preserves the snippet they
  // authored (just shows "Removed user" in the UI). Cascading would delete
  // team-wide snippets just because their creator left, which is destroying
  // shared content.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CreatedSnippets", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId, label])
}

model Contact {
  id                    String        @id @default(cuid())
  workspaceId           String
  // Nullable so non-phone channels (Instagram, Telegram) can land contacts
  // without a phone number. WhatsApp contacts always populate it; the
  // existing webhook + manual-create + CSV-import paths still set it
  // explicitly. The compound unique below stays valid since Postgres treats
  // multiple NULLs as distinct.
  phoneNumber           String?
  // Channel this contact lives on. NOT NULL: every contact-create path
  // stamps it explicitly (WhatsApp ingest, manual create, CSV import, /v1,
  // workflow target, seeds). Channel filtering is a clean
  // `WHERE identityChannel = '<value>'` — no NULL handling.
  identityChannel       Channel
  // Native id on non-phone channels (Instagram scoped-user-id, Telegram
  // chat-id). NULL for WhatsApp where phone IS the identity. Combined with
  // `identityChannel` to form the compound unique below for non-phone dedup.
  externalContactId     String?
  // WhatsApp Business-Scoped User ID (BSUID) forward-compat (Meta 2026 privacy
  // rollout). Meta is moving WhatsApp identity from the raw phone number to an
  // opaque per-business id + an optional `@username`; a webhook may then omit
  // the phone. These nullable columns let ingest persist + resolve on the BSUID
  // when the phone is absent, so we don't drop those inbounds once Meta flips.
  // NULL for every contact today (phone stays the identity). See lib/identity/identity-service.ts.
  bsuid                 String?
  // The customer's public WhatsApp @username, when they've set one (2026). Kept
  // for display + as a softer future match key; NEVER auto-merged on (name/
  // username fuzzy matching is banned — strong keys only).
  username              String?
  // Canonical display name. Derived from `firstName + lastName` when both
  // are populated; otherwise whatever the create path stored (inbound
  // webhook profile name, manual UI, /v1 POST). Source of truth for inbox
  // rendering — first/last are split-offs maintained alongside on writes.
  name                  String
  // First/last names split from `name` at migration time. Webhook payloads
  // expose these as `first_name`/`last_name` for respond.io/n8n parity.
  // Updating `name` via PATCH does NOT auto-resplit (avoids clobbering an
  // agent's manual edit); updating `firstName`/`lastName` recomputes `name`.
  firstName             String?
  lastName              String?
  // BCP-47 tag (e.g. "ar", "en"). Drives WhatsApp template language selection.
  language              String?
  // ISO 3166-1 alpha-2 (e.g. "LB"). Derived from `phoneNumber` via libphonenumber
  // at inbound time. Optional — non-WhatsApp / unparseable numbers leave null.
  countryCode           String?
  avatarUrl             String?
  // Provider profile signals for social channels — Instagram exposes
  // follower_count / is_verified_user / is_user_follow_business /
  // is_business_follow_user on its user node (Messenger/WhatsApp expose none).
  // Captured at ingest, display-only context in the contact panel. JSON so any
  // future channel can stash its own signals without a schema change; never
  // queried/filtered. Null on channels without them. Shape: SocialProfile in
  // @ccp/shared/types.
  socialProfile         Json?
  // Optional profile fields surfaced in the right-rail contact panel.
  email                 String?
  location              String?
  // Bag of contact-level custom field values, keyed by field key.
  // - Keys defined in ContactFieldDefinition are the team-wide schema (always
  //   shown on every contact, even when blank).
  // - Keys NOT in the team schema are per-contact extras (one-offs added on
  //   a single contact). Both kinds are string-valued for now.
  // NOTE: customFields has NO search index. Quick-search hits it via
  // `customFields::text ILIKE` and field-filter via `->> key ILIKE` — neither
  // can use a JSONB GIN, so the old jsonb_path_ops GIN was dead write overhead
  // and was dropped (20260611130200). A full-text/tsvector index over the
  // VALUES is the right fix IF value-substring search ever shows up hot in
  // EXPLAIN (trigger: ~50k contacts/team); it bloats every contact write, so
  // don't add it preemptively.
  customFields          Json          @default("{}")
  // Customer-lifecycle stage. Per-team configurable list (managed in
  // /settings/stages). Defaulted to the team's `isDefault` stage at create
  // time — see ensureDefaultStage in lib/queries.ts. SetNull on delete so
  // removing a stage doesn't take its contacts with it; the bulk-move flow
  // in /api/team/stages/[id] DELETE empties this manually first.
  stageId               String?
  // UNIFIED CUSTOMER (§6 / lib/identity/identity-service.ts). A Contact is one channel identity;
  // the Customer it rolls up to is the PERSON, so an agent sees one profile
  // across all a person's channels. Nullable during rollout; the IdentityService
  // (called from ingest + manual create) ensures every contact gets one. Merge
  // re-points this FK (never deletes a contact); SetNull on customer delete.
  customerId            String?
  // How this row got into the DB. Defaulted to inbound because the webhook
  // ingest path uses the bare default; the manual create + CSV import paths
  // explicitly set 'manual'.
  source                ContactSource @default(inbound)
  createdAt             DateTime      @default(now())
  // Denormalized "most recent inbound message timestamp" for this contact.
  // Maintained on every inbound-message commit (see lib/providers/ingest.ts).
  // Used by:
  //   - getConversationWithRefs to render the 24h window chip without
  //     scanning the contact's full message history
  //   - the contacts-list "by-recency" sort
  // Nullable because contacts created via /contacts/new (manual or CSV)
  // have no inbound yet.
  lastInboundAt         DateTime?
  // ── Marketing consent ────────────────────────────────────────────────────
  // Set when the customer opts out: replies STOP (exact-match keyword scan on
  // inbound), or Meta's `user_preferences` webhook reports a marketing opt-out.
  // Cleared ONLY by that webhook's `resume`. Broadcast audience resolution
  // excludes these contacts from MARKETING sends automatically; utility /
  // transactional messages (order updates, OTPs) still deliver, and agents can
  // always reply 1:1 in the inbox.
  //
  // Deliberately opt-OUT only, with no `marketingOptInAt` counterpart: an
  // opt-in column would be NULL for every existing contact, making the entire
  // book un-messageable the moment suppression shipped. Do not "improve" this
  // into an opt-in model without a backfill plan.
  marketingOptOutAt     DateTime?
  // When this contact last hit Meta's PER-USER marketing cap (error 131049).
  //
  // Not an opt-out and deliberately a separate column: the person made no
  // choice about us. WhatsApp decided they have had enough marketing for now,
  // based on their own read rate and inbox activity, and it clears on its own.
  //
  // It is stamped so new MARKETING campaigns can skip them for 24h. Meta's rule
  // is explicit: resend sooner and you get more of the same error, and a WABA
  // that repeatedly retries capped users can have delivery to those users cut
  // off for up to 24 hours. Skipping also keeps campaign reporting honest —
  // those recipients were never reachable, so counting them as failures
  // misreports the campaign.
  // Indexed in SQL as a PARTIAL index (`WHERE ... IS NOT NULL`) — the audience
  // builder only ever asks who is CURRENTLY capped, a small recent slice. Prisma
  // can't express a partial index, so it is declared in the migration only and
  // deliberately has no `@@index` here (one would make the next `migrate dev`
  // create a second, full index beside it). Same pattern as
  // `Message_broadcastId_idx`.
  marketingCapReachedAt DateTime?
  /**
   * "stop_keyword" | "meta_preferences" | "agent" | "api"
   */
  marketingOptOutSource String?
  // ── Provider-level block (WhatsApp Block Users API) ──────────────────────
  // Set when the workspace blocked this contact on the business number: Meta
  // stops their inbounds entirely and rejects every outbound to them, so the
  // send internals refuse up front and broadcasts skip them. Distinct from
  // `marketingOptOutAt` (the CUSTOMER's choice, marketing-only) — a block is
  // the BUSINESS's choice and stops everything. Cleared by unblocking. The
  // actor is recorded on the ConversationEvent (contact_blocked), not here.
  // Meta constraint worth knowing at the schema: blocking requires the person
  // to have messaged within the last 24h; unblocking has no such window.
  blockedAt             DateTime?
  // Optimistic concurrency token. Every Contact write CAS-bumps this from
  // the value it just read; concurrent writers on the same row race to the
  // bump and exactly one wins, the other gets P2025 → 409 Conflict. Without
  // this, two simultaneous PATCHes editing different fields (or a workflow
  // step running while an agent is mid-edit) would do read-modify-write
  // races where one set of changes is silently lost. The conflict-park UI
  // in contact-panel surfaces 409s as a "teammate just edited this" banner
  // so the agent can choose to reload or overwrite.
  version               Int           @default(0)
  // Soft-delete tombstone. Deleting a contact is NON-destructive: the row + its
  // conversations/messages are PRESERVED (a contact delete must NOT take the
  // conversation with it). Set = hidden from the contacts DIRECTORY (list /
  // search / count / audience targeting / forward) but the conversation stays
  // in the inbox and by-id lookups still resolve. Cleared (re-activated) by the
  // ingest upsert when a tombstoned contact messages again. A true hard purge
  // (GDPR) is a separate explicit action that cascades.
  deletedAt             DateTime?

  // WhatsApp Business Calling — auto-revocation mirror.
  // Meta revokes calling permission after 4 consecutive unanswered outbound
  // calls; once revoked, placeCall returns an error until the customer
  // grants permission again. We mirror that state locally so the inbox can
  // (a) hide the Phone button when it's revoked and (b) show a warning at 3
  // unanswered before Meta strips permission. `consecutiveUnansweredOutCalls`
  // resets to 0 on any answered/completed outbound call.
  callPermissionRevokedUntil    DateTime?
  consecutiveUnansweredOutCalls Int       @default(0)

  workspace               Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage                   ContactStage?           @relation(fields: [stageId], references: [id], onDelete: SetNull)
  customer                Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversations           Conversation[]
  tickets                 Ticket[]
  broadcastRecipients     BroadcastRecipient[]
  workflowAwaitingReplies WorkflowAwaitingReply[]
  callPermissionRequests  CallPermissionRequest[]
  // Many-to-many: an agent tags a contact with one or more labels for
  // segmentation. Implicit join table — Prisma manages the link rows.
  // Tags live on Contact (NOT Conversation): one contact = one conversation
  // in this app's invariant (closed threads reopen rather than fragment),
  // so per-thread tagging would be dead complexity. See the
  // 20260516160000_revert_conversation_tags migration for the history of
  // why this lives here and not on Conversation.
  tags                    Tag[]
  // M2M with saved audience groups via manual membership. Dynamic membership
  // (by tag) doesn't materialize here — it's resolved at send time.
  audienceGroups          AudienceGroup[]         @relation("AudienceGroupContacts")
  // NOTE: a PARTIAL pg_trgm GIN index `Contact_phoneNumber_trgm_idx`
  // (USING GIN ("phoneNumber" gin_trgm_ops) WHERE "phoneNumber" IS NOT NULL)
  // is hand-written in the init migration. Phone search is a substring
  // match (LIKE/ILIKE '%digits%') in all three call sites (contacts list,
  // conversation list, global contact search); the btree `(workspaceId,
  // phoneNumber)` above CAN'T serve a leading-wildcard match, so without the
  // trgm index those scans were full seq-scans of Contact. It's NOT declared
  // here because Prisma can't express the `WHERE phoneNumber IS NOT NULL`
  // partial predicate — Prisma can't model the `WHERE phoneNumber IS NOT NULL`.
  // (A JSONB GIN `Contact_customFields_gin_idx` once lived here too; it was
  // dropped in 20260611130200 because no query shape could use a jsonb_path_ops
  // GIN — all customFields reads are `::text ILIKE` / `->> key ILIKE`. That
  // also removed the drift workaround its hand-written status existed for.)

  // Compound identity for non-phone channels. Only enforced when both fields
  // are set — Postgres treats NULL as distinct in unique constraints, so
  // WhatsApp-only contacts (both nulls) coexist freely.
  @@unique([workspaceId, identityChannel, externalContactId])
  // Phone uniqueness is enforced by a PARTIAL unique index, not a full one —
  // see `Contact_teamId_phoneNumber_whatsapp_key` (raw SQL in the init
  // migration). It fires ONLY for WhatsApp (identityChannel = 'whatsapp').
  // Two Instagram
  // accounts with the same phone (different `externalContactId`) legitimately
  // coexist because the partial WHERE excludes them — their identity is
  // `(identityChannel, externalContactId)`, not phone.
  //
  // The partial unique covers BOTH active AND soft-deleted rows for WhatsApp,
  // so re-contact resurrection still works: the tombstoned row holds the
  // WhatsApp phone slot, the lookup lands on it, ingest clears `deletedAt`.
  // The schema-level `@@index` below is the lookup index; Prisma can't model
  // partial uniques, so the constraint lives in raw SQL. (The customFields GIN
  // that once shared this hand-managed/drift-detected status was dropped in
  // 20260611130200 — no query could use it.)
  //
  // Ingest path is findFirst+create/update (NOT upsert) because no Prisma
  // unique key exists for `(workspaceId, phoneNumber)` after this change. The
  // partial unique + Serializable wrapper (P2002 + P2034 retry) is the race
  // backstop.
  @@index([workspaceId, phoneNumber])
  // No bare @@index([workspaceId]) — every workspaceId-only lookup is already covered by
  // a workspaceId-leading composite ([workspaceId, deletedAt], [workspaceId, source], etc.).
  // Dropped as write overhead — migration 20260611130000.
  @@index([workspaceId, source])
  @@index([workspaceId, stageId])
  // BSUID lookup (forward-compat): resolve a WhatsApp contact by its
  // business-scoped id when a webhook omits the phone. Sparse — NULL today.
  @@index([workspaceId, identityChannel, bsuid])
  // Customer → its channel-contacts (the profile's channel switcher loads by
  // customerId); also serves the merge/split re-point.
  @@index([customerId])
  // Directory reads filter `deletedAt IS NULL`; index it so the common
  // "active contacts" scan stays cheap as tombstones accumulate.
  @@index([workspaceId, deletedAt])
  // "Contacts by recency of last inbound" — inbox-sidebar surfaces.
  @@index([workspaceId, lastInboundAt(sort: Desc)], map: "Contact_teamId_lastInboundAt_idx")
  // Newest-first contact listing — the DEFAULT order for three separate
  // surfaces: `GET /v1/contacts` (external-v1.service.ts), the CSV export, and
  // the global contact search keyset. No index covered `createdAt`, so every
  // one of them read the tenant's whole contact partition and sorted it —
  // verified with `SET enable_seqscan=off`, where the planner still produced a
  // Sort node because nothing could supply the order. Keyset pagination does
  // NOT rescue this: the cursor bounds which rows are returned, not the sort.
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  // pg_trgm GIN index for substring ILIKE search on contact name.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm_idx")
  // Same, for the email OR-arm of contact search (global-search.ts does
  // `email contains` → ILIKE). Without it that arm seq-scanned the team
  // partition while name/phone rode their trgm indexes. Non-partial: NULL
  // emails extract no trigrams, so GIN skips them.
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm_idx")
}

// The unified CUSTOMER (a person) — the profile layer above channel-scoped
// Contacts (§6 / lib/identity/identity-service.ts). One Customer owns many Contacts (one per
// channel the person uses); the agent sees a single profile + a channel
// switcher over the person's separate per-channel threads. Message histories
// are NEVER merged — the Customer only re-points `Contact.customerId`.
//
// Population: the IdentityService creates one on first contact and AUTO-MERGES
// only on deterministic strong keys (verified exact phone / exact email — never
// fuzzy/name). Everything else is a manual, reversible merge/split with an
// audit trail. Deleting a Customer SetNulls its contacts (they never vanish).
model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Person-level display name. Seeded from the first contact; an agent can edit
  // it without touching the underlying per-channel contact names.
  name        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contacts Contact[]

  @@index([workspaceId])
}

// Persisted audit trail for the manual, reversible merge/split of the unified
// customer identity (§6 / lib/identity/identity-service.ts). Previously merge/split was only
// logged to stdout; this makes it queryable + reversible-with-context (who
// merged whom, and when). One row per `linkContact` / `unlinkContact` action.
// Auto-merge at ingest (deterministic strong keys) is NOT recorded here — it's
// derived from the contact's strong keys and reversible by the same unlink.
model CustomerIdentityEvent {
  id               String                 @id @default(cuid())
  workspaceId      String
  // The channel-contact that moved between customers.
  contactId        String
  action           CustomerIdentityAction
  // Customer the contact belonged to before the action (null if it had none).
  fromCustomerId   String?
  // The `from` customer's person-level NAME at the time of the action. Captured
  // because a `link` reaps the emptied source customer, hard-deleting its row —
  // without this the source person's deliberate rename ("VIP – do not merge")
  // would be permanently discarded, making merge non-reversible. `unlink` reads
  // the latest link event to restore the pre-merge name onto the split-off
  // customer. Null when the source had no name or no source customer.
  fromCustomerName String?
  // Customer the contact belongs to after the action.
  toCustomerId     String
  // Who performed it — a human session (null for system/sweeper actions).
  actorUserId      String?
  createdAt        DateTime               @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, contactId])
}

enum CustomerIdentityAction {
  link
  unlink
}

// Customer-lifecycle stage. A team configures an ordered list ("New",
// "Qualified", "Customer", "Churned", …) and each Contact sits in exactly one
// at a time. Used for grouping in the contacts list and for stage-targeted
// broadcasts later. Per-team — names + colors are not platform-global.
//
// `isDefault` is the stage new contacts land in (manual creates, webhook
// ingest, CSV import all consult it). At-most-one-default-per-team is
// enforced by a partial unique index (`ContactStage_teamId_isDefault_key`
// in the init migration's raw-SQL section). Prisma doesn't model partial
// indexes, so the index is raw-SQL only; the app code's pre-check still
// exists as a friendlier error path but is no longer load-bearing for
// correctness.
//
// `color` mirrors the Tag color slot system (lib/tag-colors.ts) so the same
// safelist of Tailwind classes covers both surfaces.
model ContactStage {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("slate")
  // Sort order in the stages list — lower first. New stages get the next
  // available slot at create time; reorder is a bulk PATCH.
  position    Int      @default(0)
  // Exactly one row per team should carry isDefault = true. The partial
  // unique index `ContactStage_teamId_isDefault_key` (raw SQL — partial
  // indexes can't be expressed in the Prisma DSL, see migration
  // 20260526120000) is the DB-level backstop; the app-code pre-check in
  // /api/team/stages POST + PATCH still runs as a friendlier 4xx.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

// Workspace-wide contact field definitions: an admin/manager defines a key+label
// once, and every contact in the team renders that field in the panel. The
// value still lives in Contact.customFields[key] so we don't need a separate
// values table for MVP. Renaming a field here is a metadata-only change;
// deleting it strips the key from every contact's customFields in the same
// transaction (see /api/team/contact-fields/[id] DELETE).
model ContactFieldDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  // Stable identifier used in Contact.customFields. Lowercased + underscored
  // at create time; immutable once set so existing data keeps mapping cleanly.
  key         String
  label       String
  // Sort order within the panel — lower first. Tracked so the UI can reorder
  // later without us needing alphabetical-only sorting.
  order       Int      @default(0)
  // Admin-controlled visibility for the inbox contact panel. Hidden fields
  // are dropped from the panel for ALL agents (including admins — they can
  // still toggle them back on from /settings/contact-fields). Default true
  // so existing definitions stay visible after the migration.
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, order])
}

enum ContactTransferKind {
  import
  export
}

enum ContactTransferFormat {
  csv
  xlsx
}

enum ContactTransferStatus {
  pending
  running
  completed
  failed
  canceled
}

// One row per contact import/export run. Both directions share a model because
// their observable shape is identical (status, progress, counters, an R2
// artifact, an error report) and a `kind` discriminator is far less code than
// two near-duplicate tables plus two controllers plus two UIs.
//
// Why a table at all instead of leaning on BullMQ job state: the job row
// survives a Redis flush, it's what the artifact-expiry sweeper walks, and it
// backs the visible transfer history + the "download the rows that failed"
// link — none of which a transient queue entry can provide.
model ContactTransferJob {
  id              String                @id @default(cuid())
  workspaceId     String
  kind            ContactTransferKind
  format          ContactTransferFormat
  status          ContactTransferStatus @default(pending)
  // Null when a job outlives its creator (user deleted) — SetNull, not Cascade:
  // losing the audit trail of a 100k-row import because an agent left is worse
  // than a dangling name.
  createdByUserId String?
  // Import: the uploaded file's original name. Export: the generated filename.
  filename        String

  // R2 object keys. `sourceKey` is the uploaded import file (streamed straight
  // to R2 so a 50 MiB upload never sits in API heap across the request);
  // `artifactKey` is the produced export; `errorArtifactKey` is the
  // failed-rows report, in the SAME format the user uploaded.
  sourceKey        String?
  artifactKey      String?
  errorArtifactKey String?
  // Byte size of `artifactKey`, so the UI can show it before presigning.
  artifactBytes    Int?

  // Run options: { mode, tagMode, fireAutomations, mapping, filters, scope }.
  // Json rather than columns because the shape differs by `kind` and is only
  // ever read back whole by the runner that wrote it.
  options Json @default("{}")

  // Progress + outcome counters. `processedRows` doubles as the RESUME cursor:
  // a retried job skips rows below it, and counters are only advanced after a
  // batch commits, so a mid-run crash can't double-count.
  totalRows     Int? // null until the source is counted (import) / query counted (export)
  processedRows Int  @default(0)
  created       Int  @default(0)
  updated       Int  @default(0)
  revived       Int  @default(0)
  skipped       Int  @default(0)
  failed        Int  @default(0)

  // True when the row count exceeded IMPORT_EVENT_FANOUT_CAP so per-row
  // contact.created/updated events (and therefore workflows + outbound
  // webhooks) were deliberately NOT published. Surfaced in the UI — a silent
  // skip would look like broken automations.
  automationsSkipped Boolean @default(false)

  // First N row failures inline for the summary panel; the full set lives in
  // errorArtifactKey. Shape: [{ row: number, reason: string }].
  errorSample Json    @default("[]")
  // Whole-job failure message (not row-level). Null on success.
  error       String?

  // Heartbeat, so the sweeper can fail a job whose worker died mid-run without
  // waiting for a BullMQ stall timeout.
  heartbeatAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  // Artifacts + this row are reaped after this instant by the
  // contact-transfer-artifacts sweeper. Contact exports are a bulk PII dump;
  // they must not sit in the bucket forever.
  expiresAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation("ContactTransferJobs", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  // Drives the sweeper's two scans: expired rows, and running rows with a
  // stale heartbeat.
  @@index([status, heartbeatAt])
  @@index([expiresAt])
}

model Conversation {
  id                   String             @id @default(cuid())
  workspaceId          String
  contactId            String
  // Channel this thread lives on, and the SOURCE OF TRUTH for "which channel"
  // — NOT the contact (contacts are siloed per channel today, but channel
  // ownership belongs to the thread). A conversation is bound to ONE channel
  // for its lifetime. Needed even with zero messages (a thread created on
  // first outbound), to route sends and list/filter threads. Stamped at
  // creation: inbound = the ingesting channel; outbound-initiated threads
  // default to the team's WhatsApp channel. `Message.channel` always equals
  // this but exists for a different reason (the dedup key — see its comment);
  // the equality is a consistency invariant, not duplicated data.
  channel              Channel            @default(whatsapp)
  // For `webchatwidget` conversations: which named website widget this thread
  // originated from (a team runs many). Null on every other channel. SetNull on
  // delete so removing a widget config never deletes its conversation history.
  webchatWidgetId      String?
  // The channel ACCOUNT this thread belongs to (which WhatsApp number / Page /
  // IG handle). Stamped at ingest and RE-STAMPED on every inbound, so a reply
  // always goes out the account the customer last messaged -- Meta thread
  // affinity and the 24h window belong to the ACCOUNT, not the channel. This is
  // deliberately different from `webchatWidgetId`, which stays sticky.
  channelConnectionId  String?
  assignedUserId       String?
  // Durable "who handled this customer last" — set whenever an assignee is
  // written, and NEVER cleared (closing a conversation clears `assignedUserId`,
  // which is exactly when this history would otherwise be lost). Powers
  // AssignmentPolicy.preferPreviousAgent so a returning customer goes back to
  // the person who already knows them. Plain id, no FK: a removed member must
  // degrade to "no continuity", not cascade into the thread.
  lastAssignedUserId   String?
  // New chats land in `pending` so they sit in the triage column until an
  // agent claims them (→ open) or closes them out. The webhook ingest, the
  // broadcast runner, and the message-forward path all rely on this
  // default; existing conversations are untouched by the migration.
  status               ConversationStatus @default(pending)
  // AI Autopilot — when true the conversation is eligible for the external AI
  // auto-reply flow (n8n etc.); when false a human is handling it and the AI
  // must stay silent. Default true (new chats are AI-eligible). Flipped to
  // false automatically when a human replies (autoAssignOnAgentSend), by the
  // AI itself on escalation (POST /v1/conversations/:id/ai), or by the inbox
  // "Pause AI" toggle; flipped back to true by the toggle or on close. The
  // value rides the message.received/sent outbound webhook as `ai_enabled`
  // so the partner flow gates on it. NOT a workflow trigger.
  aiEnabled            Boolean            @default(true)
  unreadCount          Int                @default(0)
  lastMessageAt        DateTime           @default(now())
  lastMessagePreview   String             @default("")
  // Direction of the message behind `lastMessagePreview` — drives the inbox
  // row's triage cue ("we replied" vs "customer waiting"). Nullable: legacy
  // rows + freshly-created conversations have no real last message yet, which
  // the UI renders as no cue. Written alongside lastMessagePreview at every
  // bump site (ingest=in, outbound send/broadcast=out).
  lastMessageDirection MessageDirection?
  createdAt            DateTime           @default(now())

  // ---- Workflow analytics ----
  // Populated incrementally by lib/conversations/analytics.ts on assign /
  // status-change / message-create. All nullable until the first qualifying
  // event happens. Exposed to the workflow trigger payload as
  // $conversation.first_response_time etc.
  firstAssignedAt       DateTime?
  firstAssignedUserId   String?
  lastAssignedAt        DateTime?
  // First outbound message timestamp, regardless of channel — used for
  // first_response_time and the assignment→response variants.
  firstResponseAt       DateTime?
  firstResponseByUserId String?
  // When the conversation moved into `closed`. Reopens (status going from
  // closed back to anything else) zero this out so the closed-conv analytics
  // refer to the most-recent close.
  closedAt              DateTime?
  closedByUserId        String?
  // Denormalized API-key actor mirroring closedByUserId — set when a /v1 partner
  // call or a workflow step closed the thread (closedByUserId is null then). Plain
  // column (no FK) to match closedByUserId; the durable "who/what closed this"
  // answer so automation closes aren't attributed to nobody.
  closedByApiKeyId      String?
  // Free-text fields populated by the close_conversation step + the manual
  // "Close" action in the inbox (round 2b adds the inbox surface).
  closedCategory        String?
  closedSummary         String?
  // Lightweight counters — denormalized so the closed-conv analytics
  // payload doesn't run aggregates against Message on every workflow run.
  assignmentsCount      Int       @default(0)
  incomingMessagesCount Int       @default(0)
  outgoingMessagesCount Int       @default(0)
  responsesCount        Int       @default(0)

  // Number of MessageFlag rows on this thread still in `open`. Denormalized so
  // the inbox list's "Flagged" filter and the row badge are a plain column
  // predicate instead of a nested EXISTS over Message — the conversation list is
  // the hottest read in the app and a correlated subquery over the largest table
  // would show up immediately. Unlike unreadCount this is bumped only on FLAG
  // writes (rare, agent-initiated), never on the per-message hot path, so it
  // costs nothing on ingest. Maintained in the same transaction as the flag
  // status change (lib/message-flags/mutations.ts) and reconciled by the
  // message-flag-count-drift sweeper.
  openFlagCount Int @default(0)

  // The ticket new messages on this thread attach to. Maintained by
  // lib/tickets/mutations.ts in the same transaction as the status change that
  // moved it, so ingest resolves "which ticket" with a single column read
  // instead of an ordered scan of the thread's ticket history on every inbound
  // — the message hot path must not pay for ticketing.
  // SetNull, not Cascade: a deleted ticket must never take the thread with it.
  activeTicketId  String?
  // Non-terminal (new/open/pending/on_hold) tickets on this thread. Denormalized
  // for exactly the same reason as openFlagCount: the inbox list's ticket badge
  // and filter must be a plain column predicate, never an EXISTS over Ticket.
  // Bumped only on ticket writes (rare), never per-message.
  openTicketCount Int     @default(0)

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact           Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser      User?               @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  webchatWidget     WebchatWidget?      @relation(fields: [webchatWidgetId], references: [id], onDelete: SetNull)
  // SetNull: removing an account must never delete conversation history.
  channelConnection ChannelConnection?  @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  messages          Message[]
  notes             InternalNote[]
  // Audit timeline rows for this conversation. Cascade with the parent —
  // a deleted conversation drops its history. Workspace-level audit (if we want
  // a global "show me everything" feed) lives on the ConversationEvent.workspaceId
  // index, independent of cascade.
  events            ConversationEvent[]
  // Voice calls placed/received on this thread. Cascade with the parent —
  // deleting a conversation drops its call history alongside its messages.
  calls             Call[]
  // Triage flags raised on this thread's messages. Cascade with the parent.
  messageFlags      MessageFlag[]
  // Every piece of work raised on this thread, oldest to newest.
  tickets           Ticket[]            @relation("ConversationTickets")
  // Back-reference for TicketShare.guestConversationId — a guest workspace's
  // own thread with a customer whose ticket was shared with them.
  ticketSharesAsGuestConversation TicketShare[] @relation("TicketShareGuestConversation")
  activeTicket      Ticket?             @relation("ConversationActiveTicket", fields: [activeTicketId], references: [id], onDelete: SetNull)
  // NO trgm GIN on lastMessagePreview. The inbox-list search ORs a
  // `lastMessagePreview contains` arm with two Contact RELATION filters
  // (contact.name / contact.phoneNumber) — Prisma renders relations as a
  // join/EXISTS and Postgres can't BitmapOr across tables, so no plan could
  // ever use such a GIN for that query; it walked the team partition anyway.
  // The dropped index (Conversation_lastMessagePreview_trgm_idx, migration
  // 20260611130300) was pure write amplification on the hottest UPDATE in the
  // system (the summary bump, once per message). If list search ever goes hot,
  // split it into a contact-id prefilter + a preview-only query (unioned) and
  // index THOSE — don't re-add a cross-table-OR'd GIN.

  // The "Flagged" inbox preset (WHERE workspaceId = $1 AND openFlagCount > 0, same
  // keyset ORDER BY) is served by a PARTIAL index Prisma can't express:
  //   Conversation_teamId_openFlag_idx ON (workspaceId, lastMessageAt DESC, id DESC)
  //   WHERE "openFlagCount" > 0
  // created in raw SQL by migration 20260722120000_message_flags. A plain
  // composite would be useless here — `openFlagCount > 0` is a range predicate,
  // so it can't sit between workspaceId and the sort key without killing the ordered
  // scan. Partial keeps the index to just the flagged rows (a tiny fraction),
  // which is both smaller and faster. Same pattern as
  // Message_conversationId_timestamp_inbound_idx.
  // ONE conversation per contact — the core invariant, DB-enforced (a Contact
  // is already channel-siloed, so this is "one conversation per channel per
  // contact"). Closed threads REOPEN (→ pending) rather than fragment. Code
  // upholds it too — ingest via a Serializable retry, the find-or-create sites
  // (forward / broadcast / external-v1 / workflow target) via catch-P2002→
  // refetch — but this constraint is the backstop that makes a fragmented
  // inbox structurally impossible. Doubles as the index the broadcast runner's
  // per-recipient `findFirst({ workspaceId, contactId })` + contact-detail pages use.
  @@unique([workspaceId, contactId])
  // FK index for the `channelConnection` relation's onDelete: SetNull — the
  // same reason Broadcast carries one, and far more load-bearing here because
  // Conversation is orders of magnitude larger. Without it, disconnecting an
  // account runs `UPDATE "Conversation" SET "channelConnectionId" = NULL WHERE
  // "channelConnectionId" = $1` as a SEQUENTIAL SCAN that row-locks its way
  // through the whole table — inside the delete transaction, under a 30s
  // statement timeout. It also serves the inbox's per-account filter
  // (`listConversations({ accountId })`), which is a plain equality on this
  // column on the hottest read in the product.
  @@index([channelConnectionId])
  @@index([workspaceId, status, lastMessageAt(sort: Desc)])
  @@index([workspaceId, assignedUserId])
  // "Mine" inbox — the view an agent lives in all day. The filter is
  // (workspaceId, assignedUserId) with the list's standard
  // ORDER BY lastMessageAt DESC, id DESC. The index above stops at
  // assignedUserId, so Postgres had to read EVERY conversation assigned to that
  // agent and sort it, and because the keyset predicate is then only a residual
  // filter, every page repeated the whole sort. Carrying the sort key turns it
  // into a range scan that stops after `take`. (`status != closed` stays a
  // residual — an inequality can't be an index prefix — but it is cheap once the
  // scan is already narrowed to one agent's rows.)
  @@index([workspaceId, assignedUserId, lastMessageAt(sort: Desc), id(sort: Desc)])
  // FK index for the `assignedUser` relation's onDelete: SetNull. The
  // (workspaceId, assignedUserId) composite above leads with workspaceId, so a bare
  // `WHERE assignedUserId = $1` FK-trigger scan on user-delete can't use it.
  // Without this, hard-deleting a teammate seq-scans the hot Conversation
  // table to null their assignments. Migration 20260611130100.
  @@index([assignedUserId])
  // DB-5: contactId-leading index. The `@@unique([workspaceId, contactId])` below
  // leads with workspaceId, so a contactId-only scan (a GDPR hard-purge reconciling
  // every conversation for one contact across the team boundary, or a future
  // cross-tenant contact tool) can't use it. Cheap btree for that path.
  @@index([contactId])
  // Keyset-paginated inbox listing: WHERE workspaceId = $1 ORDER BY lastMessageAt
  // DESC, id DESC. The status-leading index above stays for filtered views
  // (open / pending / closed) but doesn't help the unfiltered list — the
  // planner needs status to participate in WHERE for that one to be useful.
  @@index([workspaceId, lastMessageAt(sort: Desc), id(sort: Desc)])
}

model Message {
  id                    String           @id @default(cuid())
  workspaceId           String
  conversationId        String
  // Provider-assigned id (Meta wamid for WhatsApp). Dedupe via the compound
  // unique below — bare `@unique` would collide across channels because
  // Meta's WhatsApp wamid and Instagram message-id share the same opaque-
  // string shape and could theoretically clash (Telegram numeric ids
  // definitely will against something). Compound on (workspaceId, channel,
  // externalId) keeps each channel's id space isolated.
  externalId            String
  // null on inbound — only outbound has an authoring agent.
  senderUserId          String?
  // For text-only messages this is the body. For media messages this holds
  // the caption (or empty) so search keeps matching across both kinds.
  body                  String
  direction             MessageDirection
  // Provenance of an outbound row — see `enum MessageOrigin`. Defaults to `api`
  // so every existing row (all sent through the platform) and every inbound row
  // is correct without a backfill; only Coexistence phone-app echoes set
  // `business_app`.
  origin                MessageOrigin    @default(api)
  // Half of the dedup key `@@unique([workspaceId, channel, externalId])` below —
  // that's its job, NOT to classify the channel for routing. It is enforced
  // at INSERT, before any conversation link exists (dedupe runs first in
  // ingest), and a DB unique index can't span a JOIN, so channel must live
  // on this row. Channel OWNERSHIP is `Conversation.channel`; this always
  // equals it (a thread is single-channel) — a consistency invariant, not
  // redundancy. Don't "simplify" by dropping either: lose this and dedup
  // breaks once a 2nd channel exists; lose Conversation.channel and empty
  // threads (no messages yet) have no channel.
  channel               Channel
  // WHICH of the workspace's accounts on that channel actually carried this
  // message — the number/Page it went out from, or arrived on.
  //
  // NOT redundant with `Conversation.channelConnectionId`, because those two
  // answer different questions. The conversation pointer answers "where does
  // the NEXT reply go", and it is deliberately MUTABLE: ingest re-stamps it
  // whenever the customer writes to a different number of ours. That makes it
  // wrong for history — a message genuinely sent from Sales started reporting
  // as Support the moment the customer messaged Support, including in the
  // outbound-webhook payload partners consume. A send's identity is a fact
  // about the past; this column records it and never moves.
  //
  // Plain id, NO FK — same reasoning as `Conversation.lastAssignedUserId`, and
  // stronger: the conversation's FK is `onDelete: SetNull`, which is exactly
  // wrong for a historical stamp (disconnecting a number would erase the
  // record of everything it ever sent).
  //
  // NULL = "not recorded" (every row written before this column existed).
  // Deliberately NOT backfilled: filling it from the conversation's CURRENT
  // pointer would write the wrong answer for precisely the rows this exists to
  // fix. Readers fall back to the conversation pointer when null, which is
  // exactly the old behaviour — so nothing regresses.
  //
  // Indexed as of the 24h-budget widening below: the portfolio budget query and
  // the per-account reports now DO filter Message by account, and without an
  // index that is a sequential scan of the largest table in the schema. The
  // partial index for the budget query itself lives in its own migration (see
  // `Message_template_send_budget_idx`).
  channelConnectionId   String?
  status                MessageStatus    @default(sent)
  // Delivery-failure diagnostics from Meta's async `status: "failed"` webhook.
  // Meta surfaces post-acceptance failures (131047 outside-window on an
  // API-accepted send, 131049 per-user marketing frequency caps, 131026
  // undeliverable, quality blocks) here as errors[0].code + title +
  // error_data.details. Persisted (not just console.errored) so the failed
  // bubble can show WHY instead of a bare red icon, and so broadcasts can
  // report per-recipient reasons. All null on every non-failed status.
  // statusErrorTitle is Meta's short human label; statusErrorDetail is
  // error_data.details (the actionable text).
  statusErrorCode       Int?
  statusErrorTitle      String?
  statusErrorDetail     String?
  // The broadcast this outbound message belongs to (null for every ordinary
  // send). Two jobs, both load-bearing:
  //   1. DURABILITY — the same link used to live only in `rawPayload`, which
  //      the message-rawpayload-retention sweeper COLLAPSES to
  //      {"sentVia":"broadcast"}, destroying the id. A real column survives.
  //   2. ZERO-COST DISCRIMINATOR — ingestStatusUpdate already loads this row
  //      (and its conversation.contactId), so `if (broadcastId)` gates the
  //      recipient-delivery propagation with no extra query, and every
  //      non-broadcast status webhook skips it for free.
  // Combined with conversation.contactId this yields (broadcastId, contactId)
  // — already the @@unique on BroadcastRecipient — so the propagation needs no
  // new index and no lookup by wamid.
  broadcastId           String?
  // The TEMPLATE this outbound message was sent from — null for every free-form
  // send and every inbound.
  //
  // Exists to make the portfolio 24h messaging budget honest. That budget counts
  // UNIQUE recipients messaged outside a customer-service window, and it used to
  // read `BroadcastRecipient` alone — so template sends driven by a workflow, the
  // inbox composer or the `/v1` API consumed Meta's real budget while being
  // invisible to our gate, which therefore only ever reported a LOWER BOUND.
  //
  // A name rather than a boolean: it costs the same, and it makes a per-template
  // "last used" reconcilable later. `rawPayload` cannot serve — the
  // message-rawpayload-retention sweeper collapses that blob, which is exactly why
  // `broadcastId` above became a real column too.
  templateName          String?
  // The structured button / list-row tap behind an inbound message. `body`
  // holds the user-facing TITLE, which an operator can rename in a template at
  // any time; this holds the STABLE machine id the template defined. Reporting
  // and workflow branching must key on the id — a title-keyed click report
  // silently resets its history the moment someone edits a button label.
  // Parsed by meta.ts today but, before this, never persisted anywhere.
  interactiveOptionId   String?
  interactiveOptionKind String?
  // The CUSTOMER's current emoji reaction to THIS message (WhatsApp lets a
  // contact react to any message). A single value because a conversation has
  // exactly one customer; a new reaction REPLACES it and an empty reaction
  // payload CLEARS it (null). Set by the ingest `reaction` path; null = none.
  reaction              String?
  // OUR team's outbound reaction to THIS message — the business-side twin of
  // `reaction`. A SEPARATE column so a customer reaction and an agent reaction
  // on the SAME message coexist instead of clobbering one field (the bug when
  // both sides reacted). Meta allows one business reaction per message: a new
  // one REPLACES it, an empty emoji CLEARS it (null). Set by the send-reaction
  // path; null = we haven't reacted.
  agentReaction         String?
  // The CUSTOMER's 👍/👎 "message feedback" on THIS (our outbound) message —
  // Messenger's `response_feedback`, which is Meta's business-message feedback,
  // NOT an emoji reaction (customers can't emoji-react to a business message).
  // Rendered as a distinct "helpful / not helpful" chip, never as a reaction.
  // "positive" | "negative"; null = no feedback given.
  feedback              String?
  // Structured non-media content (shared location pin / contact card) that gets
  // a dedicated bubble. Shape = MessageStructured (discriminated by `kind`:
  // location | contacts); `body` still holds the text placeholder for search /
  // list preview. Null for normal text/media messages.
  structured            Json?
  // Ad / deep-link attribution (Click-to-WhatsApp / Click-to-Messenger) on the
  // first inbound of an ad-sourced conversation. Shape = MessageAttribution
  // (source + headline/body/sourceUrl/clickId/ref). Null otherwise.
  attribution           Json?
  // Message unsend / edit (WhatsApp revoke + Messenger/Instagram unsend, and
  // WhatsApp edits). `deletedAt` tombstones a message the CUSTOMER removed — the
  // row is KEPT (audit + dedup) but the bubble renders "message was deleted" and
  // the body is preserved for the record. `editedAt` marks a body the customer
  // edited (body already updated in place). Both null on a normal message. These
  // are the inbound customer action — distinct from `Contact.deletedAt` (a
  // contact tombstone) and from an agent deleting their own send (not built).
  deletedAt             DateTime?
  editedAt              DateTime?
  // Original webhook payload kept verbatim for debugging (CLAUDE.md rule #4).
  // Nullable so the opt-in rawPayload-retention sweeper (DB-1) can NULL ancient
  // payloads to bound table/dump bloat at scale; every WRITE still sets it.
  rawPayload            Json?
  timestamp             DateTime         @default(now())
  createdAt             DateTime         @default(now())

  // Media fields. All nullable — text-only rows leave them null. `mediaKind`
  // is the discriminator; when set, the binary lives in the active blob
  // storage provider (today UploadThing, see lib/blob-storage/).
  //
  //   mediaKey — provider's reference for the file. Used to call
  //              blobStorage.delete(). Provider-agnostic by design: today this
  //              is an UploadThing fileKey, tomorrow it could be an S3 object
  //              key. The shape is opaque to app code.
  //   mediaUrl — public CDN URL the browser fetches. /api/media/[id] does a
  //              team-ownership check then 302s to this.
  mediaKind       String?
  mediaKey        String?
  mediaUrl        String?
  mediaMimeType   String?
  mediaCaption    String?
  mediaFilename   String?
  mediaSizeBytes  Int?
  mediaDurationMs Int?
  // Audio only: true for a WhatsApp voice note (push-to-talk) vs a shared
  // audio FILE. Drives the inbox mic-glyph + "Voice message" affordance.
  // Inbound: from Meta's `audio.voice`. Outbound: from the recorder's `voice`
  // flag. Null/false = a regular audio file.
  mediaVoice      Boolean?

  // Optional first-frame thumbnail for video messages. Generated server-side
  // during inbound media ingest via @ffmpeg-installer/ffmpeg + fluent-ffmpeg;
  // stored as a separate blob (uploadthing key) so the <video> element can
  // render a poster frame instead of a black square until the user clicks
  // play. Outbound video sends don't generate one today (the file is already
  // on the agent's disk; their player picks its own frame); revisit if
  // outbound bubbles look inconsistent next to inbound.
  mediaThumbnailKey String?
  mediaThumbnailUrl String?

  // Quoted reply: the row this message is replying to. Self-FK with SetNull
  // so deleting the original (rare) doesn't take the reply with it. The
  // snapshot the UI renders comes from JOINing this row at read time, not
  // from a denormalized copy — we don't want stale quotes when bodies edit.
  replyToMessageId String?
  replyTo          Message?      @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]     @relation("MessageReply")
  // Triage flags raised on this message. Cascade with the parent.
  flags            MessageFlag[]
  // The ticket this message belongs to. An EXPLICIT column, not derived from
  // timestamps against ticket open/close ranges: a ticket's boundaries move
  // (reopen, merge) and a derived answer would silently rewrite which work a
  // message belonged to. Null on messages that predate ticketing and on threads
  // where auto-open is off. SetNull so deleting a ticket never deletes history.
  ticketId         String?
  ticket           Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("AuthoredMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  // NOTE: a partial index on inbound-only messages also exists in the DB
  // (`Message_conversationId_timestamp_inbound_idx` in the init migration's
  // raw-SQL section). Prisma can't express `WHERE direction = 'in'` via
  // `@@index`. It powers the "what was the contact's last inbound?" lookups
  // (24h-window UI + lastInboundAt drift sweeper) without scanning outbound
  // rows.

  @@unique([workspaceId, channel, externalId])
  // No bare @@index([workspaceId]) — it's a leftmost prefix of the dedupe unique
  // ([workspaceId, channel, externalId]) AND Message_teamId_timestamp_id_idx below,
  // so a workspaceId-only lookup already has coverage. No bare
  // @@index([conversationId, timestamp]) — fully covered by the
  // (conversationId, timestamp DESC, id DESC) keyset index below (Postgres
  // walks a btree in either direction, so DESC,DESC serves equality-on-
  // conversationId + an ASC/range timestamp scan too). Both dropped as pure
  // write overhead on the hottest-write table — migration 20260611130000.
  @@index([replyToMessageId])
  // Per-account reporting + the portfolio 24h budget both filter Message by the
  // account that carried it. Unindexed this was a seq scan of the biggest table.
  @@index([channelConnectionId])
  // FK index for the ticket relation's SetNull, and for the ticket detail
  // page's "the messages that belong to THIS piece of work" read.
  @@index([ticketId, timestamp])
  // FK index for the `sender` relation's `onDelete: SetNull`. Without it,
  // hard-deleting a teammate seq-scans the (largest) Message table to null
  // their authored rows. Cheap btree; the hottest write path gains one small
  // index update per insert in exchange for a non-locking admin user-delete.
  @@index([senderUserId])
  // Keyset for thread loads + "load older": WHERE conversationId = $1
  // ORDER BY timestamp DESC, id DESC. The SOLE (conversationId, timestamp)
  // index now — a btree scans in both directions, so this also serves
  // chronological/range scans + the conversationId-equality lookups that the
  // dropped ascending (conversationId, timestamp) index used to. id is the
  // same-millisecond tiebreaker for the backward keyset cursor.
  @@index([conversationId, timestamp(sort: Desc), id(sort: Desc)])
  // pg_trgm GIN for the GLOBAL inbox-search "Messages" tab — an ILIKE on
  // body across EVERY conversation in the team (the in-thread message search
  // is scoped by conversationId and rides the keyset index above; this one
  // is for the team-wide search where there's no conversation predicate to
  // narrow the scan). The team-wide search matches `body` ONLY (no OR over
  // mediaCaption): the caption is copied into `body` at every write site
  // (inbound ingest, outbound media send, forward), so a caption-only match
  // can't exist — and ORing an un-indexed mediaCaption arm would force a
  // BitmapOr that defeats this GIN (an OR needs an index on every arm),
  // degrading to a team-wide seq-scan. So no mediaCaption trgm index is
  // needed — its data is already inside `body`. See global-search.ts
  // searchAllMessages.
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_body_trgm_idx")
  // Workspace-wide search SORT support. The trgm index above serves the ILIKE
  // filter, but the global "Messages" search then ORDER BY (timestamp DESC,
  // id DESC) had no composite to satisfy it — a broad search term returned a
  // large GIN bitmap that Postgres had to sort in memory. This btree lets the
  // planner walk newest-first and stop at LIMIT for broad terms. Selective
  // terms still ride the trgm path. Mirrors the conversation-scoped keyset
  // index above, but keyed on workspaceId for the cross-conversation search.
  @@index([workspaceId, timestamp(sort: Desc), id(sort: Desc)], map: "Message_teamId_timestamp_id_idx")
}

// One-row-per-attempt log for outbound text sends, written BEFORE the Meta
// fetch so a worker death mid-fetch can be detected on retry.
//
// Why this exists: BullMQ's send queue uses jobId = `msg-send-${clientTempId}`
// and retries the SAME jobId after `lockDuration=90s` if the worker dies
// without completing. Meta has no native idempotency key on POST /messages,
// so a process death between Meta receiving the request and the worker
// recording the response → BullMQ retry → Meta sends the message AGAIN.
// The DB-level unique on `(workspaceId, channel, externalId)` dedupes the
// resulting Message row, but the customer was already charged twice and
// saw two messages on WhatsApp.
//
// The fix: every send attempt insert-or-fail-on-conflict a row here keyed
// by jobId BEFORE calling Meta. If the insert succeeds, no prior attempt
// touched Meta — safe to proceed. If a P2002 fires:
//   - completedAt is set → the prior attempt succeeded; look up the
//     existing Message row by externalId and re-publish `message.sent`
//     so the originating client sees the bubble swap (idempotent reply).
//   - completedAt is null → Meta may or may not have received the request
//     in the prior attempt. We refuse to retry (UnrecoverableError) to
//     avoid the rare double-charge. The originating client's post-HTTP
//     watchdog (30s) will flip the optimistic bubble to `failed` and the
//     user can retry — with a fresh clientTempId, which is a new jobId,
//     and unblocked. Trade-off: a Meta-was-actually-down scenario means
//     one "lost" send the user must re-do; vs the alternative of
//     systematically double-charging on every deploy-induced retry.
//
// Cleanup: rows older than 7 days are purged by the outboundSendAttempt
// sweeper (see apps/api/src/lib/sweepers/). Completed + failed rows are
// expendable bookkeeping after the originating job has been ack'd by
// BullMQ's removeOnComplete window (24h).
model OutboundSendAttempt {
  id               String    @id @default(cuid())
  // Matches BullMQ's jobId for this send: `msg-send-${clientTempId}`. The
  // SAME jobId is used across all retry attempts of the same client-side
  // send action — that's the property we exploit to detect a retry.
  jobId            String    @unique
  workspaceId      String
  conversationId   String
  attemptStartedAt DateTime  @default(now())
  // Set when the Meta fetch returned successfully AND we recorded the
  // wamid. Until set, the attempt is considered in-flight or aborted.
  completedAt      DateTime?
  // Meta wamid from a successful send; used on retry to look up the
  // existing Message row and re-publish `message.sent`.
  externalId       String?
  // Set when Meta returned a non-retryable error (4xx). A retry will see
  // failedAt + a populated failureReason and proceed normally — the
  // original failure publish to the client already happened, so a
  // duplicate publish is harmless. (Failed-attempt rows still get
  // recycled by the sweeper.)
  failedAt         DateTime?
  failureReason    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Sweeper picks rows by (completedAt || failedAt) older than the
  // retention window — index on attemptStartedAt for the scan.
  @@index([attemptStartedAt])
}

// Pending team invite. Admin POSTs to /api/invites; the link contains a
// random token whose SHA-256 hash is stored here (never the raw token, same
// reasoning as a password). Accepting consumes the row by stamping
// acceptedAt — we don't delete so admins can audit who invited whom.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(agent)
  tokenHash   String    @unique
  // Nullable + SetNull so deleting the inviter leaves their pending invites
  // in place — the token still works, the "invited by" label just falls
  // back to "Removed user".
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("InvitedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
}

// Cached snapshot of a WhatsApp message template registered on the team's
// WABA. We sync from Meta on demand (admin clicks "Refresh templates" in the
// settings page, or the picker opens with a stale-than-5-min cache) and store
// the full component tree as JSON so the picker can render the same preview
// the customer will see — header (text/media), body with {{n}} placeholders,
// footer, and buttons.
//
// `externalId` is Meta's template id; we keep `(workspaceId, name, language)` as
// the natural key since the same template can have multiple language variants
// under a single name. Updating a template in WhatsApp Manager bumps Meta's
// id — the sync upserts by the natural key so the cached row tracks the
// latest version.
model MessageTemplate {
  id                    String            @id @default(cuid())
  workspaceId           String
  // The WABA whose catalog this template belongs to — a REQUIRED FK, not a
  // string.
  //
  // It used to be `wabaId String @default("")`, where `""` meant "unknown WABA".
  // That sentinel made the cross-account send guard a NO-OP: the guard only
  // refuses when both sides are known and differ, so a legacy template was
  // sendable from ANY account, and a connection whose WABA was never pasted could
  // send ANY of the workspace's templates. A NOT NULL FK makes the hole
  // unrepresentable rather than merely discouraged.
  wabaAccountId         String
  externalId            String?
  name                  String
  language              String
  category              TemplateCategory
  // The category Meta has decided this template SHOULD be, when it disagrees
  // with `category`. Meta announces this IN ADVANCE (`correct_category` on the
  // template node, and the notice form of the `template_category_update`
  // webhook) and only moves the template on the first of the following month.
  //
  // Deliberately a separate column, never folded into `category`: until Meta
  // actually moves it, the template is still reviewed, rendered and BILLED as
  // `category`. Writing the future value into `category` mispriced every
  // broadcast quote for up to a month. Null = not impacted.
  correctCategory       TemplateCategory?
  status                TemplateStatus
  // Meta's `reason` from the last `message_template_status_update` — the
  // difference between "rejected" and the actionable "rejected:
  // INCORRECT_CATEGORY", which tells the author to resubmit under a different
  // category rather than rewrite the copy.
  statusReason          String?
  // The status webhook's rich sub-objects, which the coarse `statusReason`
  // can't carry: `rejection_info` (Meta's detailed explanation AND its fix
  // recommendation for INVALID_FORMAT rejections), `other_info` (the pause
  // instance — FIRST_PAUSE 3h / SECOND_PAUSE 6h self-lift vs
  // RATE_LIMITING_PAUSE, which is pacing and only lifts via manual unpause),
  // and `disable_info.disable_date`. Shape:
  //   { title?, description?, rejectionReason?, recommendation?, disabledAt? }
  // Cleared alongside statusReason on any status that arrives without one, so
  // stale guidance can't hang off a since-recovered template.
  statusDetail          Json?
  // Meta's `message_send_ttl_seconds`: how long delivery is retried before the
  // message is dropped. Null = the template uses Meta's per-category default
  // (minutes for authentication, days for marketing/utility) — we never
  // materialize that default locally, because it is Meta's to change.
  messageSendTtlSeconds Int?
  // When this template was seen to become ARCHIVED, which starts Meta's 28-day
  // deletion countdown.
  //
  // Meta never states an archival DATE, so this is when we observed the
  // transition: exact when the `message_template_status_update` webhook
  // delivered it, approximate when a catalog sync found a template already
  // archived. The UI says "about N days" for that reason. Cleared when the
  // template leaves the archived state.
  archivedAt            DateTime?
  // Meta's `quality_score.score` for this template: GREEN | YELLOW | RED |
  // UNKNOWN. A plain String, NOT an enum, for the same reason the number's
  // `qualityRating` is one — Meta's quality vocabulary churns and we never want
  // an unrecognized band to need a migration before it can be stored.
  //
  // This is the EARLY warning. Quality feeds Meta's template pacing and
  // pausing, so a RED template is one about to stop sending; by the time the
  // `PAUSED` status arrives the campaign is already dead. Null = never reported.
  qualityScore          String?
  // When Meta last recomputed the score (`quality_score.date`, unix seconds).
  // Shown beside the band because a GREEN from three months ago says much less
  // than one from yesterday.
  qualityScoreAt        DateTime?
  // Last time this template was actually SENT — the activity that resets Meta's
  // 12-month archival clock (along with create/edit/appeal/unarchive).
  //
  // Written once per direct send and once per broadcast RUN, never per
  // recipient: a 100k campaign is one use of the template, and a write per
  // recipient would add 100k pointless updates to the hot send path.
  lastUsedAt            DateTime?
  // The Template Library blueprint this template was instantiated from.
  //
  // Meta's own marker: a template carrying `library_template_name` has FIXED,
  // uneditable copy and is subject to per-parameter TYPE CHECKS at send time.
  // Both facts change what the UI may offer, so the marker is stored rather than
  // inferred. Null for a template authored in the composer or in Manager.
  libraryTemplateName   String?
  // Per-template button-click tracking opt-out (Meta's
  // `cta_url_link_tracking_opted_out`). True = clicks are NOT tracked, so the
  // insights UI explains an empty click series instead of looking broken.
  // Null = Meta hasn't reported the flag for this row yet (distinct from
  // false); synced with the leave-alone rule, toggled via the provider.
  linkTrackingOptedOut  Boolean?
  // Per-body-parameter value types (`["TEXT","AMOUNT","DATE"]`), positionally
  // aligned with the body's `{{n}}`. ONLY library templates have these, and they
  // are only readable from the library catalogue — the template node doesn't
  // return them — so they are captured at instantiation. Without them, a value
  // Meta rejects at send time fails the message with no indication of which
  // parameter was wrong.
  bodyParamTypes        String[]          @default([])
  // Body text with `{{1}}, {{2}}, …` placeholders. Denormalized from components
  // for cheap previews / search; the canonical source is `components`.
  bodyText              String            @default("")
  // Full components array as Meta returned it. Schema:
  //   [{ type: "HEADER" | "BODY" | "FOOTER" | "BUTTONS", format?, text?, buttons? }]
  components            Json
  // Per-variable metadata layered on top of Meta's positional `{{n}}` model:
  // human-readable label + source (manual / contact field / custom field) +
  // optional fallback value used at send time when the contact's field is
  // empty. Owned by our app — Meta never sees this. Shape:
  //   { body: VariableBinding[], header?: VariableBinding }
  //   VariableBinding = {
  //     label: string,
  //     source:
  //       | { kind: "manual" }
  //       | { kind: "contact_field", field: "name"|"phoneNumber"|"email"|"location" }
  //       | { kind: "contact_custom_field", key: string },
  //     defaultValue?: string,
  //   }
  // Empty `{}` for templates synced from Meta before bindings existed — the
  // runner treats a missing binding the same as `manual`, so old broadcasts
  // keep working.
  variableBindings      Json              @default("{}")
  // Meta's `parameter_format`: "positional" (`{{1}}`) or "named" (`{{order_id}}`).
  // Stored rather than inferred from the body text — a regex misreads a
  // positional template that contains `{{order_id}}` as literal copy, and the
  // wrong wire shape fails every recipient with Meta error 132000. Defaults to
  // positional so every row synced before this column keeps its exact behaviour.
  parameterFormat       String            @default("positional")
  syncedAt              DateTime          @default(now())

  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Cascade: a WABA's catalog has no meaning without the WABA. Disconnecting a
  // phone NUMBER never reaches this — numbers hang off the WABA, not the reverse.
  wabaAccount WhatsappBusinessAccount @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)

  // Templates live on a WABA, and numbers under one WABA SHARE a catalog, so
  // two WABAs in the same workspace may each hold a template of the same
  // (name, language). Keying on the workspace alone collided them.
  @@unique([workspaceId, wabaAccountId, name, language])
  @@index([workspaceId, status])
  @@index([wabaAccountId])
}

// Free-form label applied to contacts for segmentation ("VIP", "Ramadan
// buyers", "Women clients", …). Many-to-many with Contact — a contact can
// carry any number of tags, a tag is reused across many contacts.
//
// `color` is a named slot ("slate", "rose", "amber", …) NOT a hex, so the UI
// can map to a safelist of Tailwind classes without dynamic class strings.
model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("slate")
  createdAt   DateTime @default(now())

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Tags live on Contact. Implicit M2M; join table is `_ContactToTag` (re-
  // created by the revert migration). One contact = one conversation in
  // this app, so per-thread tagging would be dead complexity.
  contacts       Contact[]
  // M2M with audience groups built off a tag-based filter. A group with
  // tags = "ramadan, women" includes the union of contacts carrying any
  // of them.
  audienceGroups AudienceGroup[] @relation("AudienceGroupTags")
  // Same taxonomy applied to tickets. Implicit M2M (`_TicketTags`).
  tickets        Ticket[]        @relation("TicketTags")

  // (workspaceId, name) unique already serves workspaceId-prefix lookups, so a standalone
  // @@index([workspaceId]) was redundant write overhead. Dropped 2026-06-01.
  @@unique([workspaceId, name])
}

// Saved audience for broadcasts. Hybrid composition:
//   - `tags`     → dynamic: every contact with ANY of these tags is in the
//                  group at resolution time.
//   - `contacts` → manual: these specific contacts are always in the group,
//                  even if their tags change later.
// Members at send time = union of both. Empty `tags` + empty `contacts` is
// a valid but empty group (the broadcast wizard will reject it).
//
// Inspired by Front / Intercom segments. Static (snapshot-at-send) — when
// the agent triggers a broadcast that targets a group, the runner resolves
// the current member set ONCE and writes it into BroadcastRecipient. New
// contacts that match the criteria afterwards don't join the in-flight job.
model AudienceGroup {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  // Nullable + SetNull — audience groups are team-shared and shouldn't be
  // destroyed when their creator is removed.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CreatedAudienceGroups", fields: [createdById], references: [id], onDelete: SetNull)
  tags      Tag[]     @relation("AudienceGroupTags")
  contacts  Contact[] @relation("AudienceGroupContacts")

  // (workspaceId, name) unique already covers workspaceId-prefix lookups — standalone
  // @@index([workspaceId]) was redundant. Dropped 2026-06-01.
  @@unique([workspaceId, name])
}

// A batch template send to many recipients in one go. Inspired by Front /
// Intercom broadcasts. Variables are SAME-FOR-ALL in v1 — per-recipient
// personalization (CSV upload) is a later add-on.
//
// `template*` fields are SNAPSHOTTED at creation, not foreign keys. If the
// admin re-syncs templates from Meta and the template gets renamed or its
// body changes mid-broadcast, this row keeps the version that was actually
// sent. We do keep `templateId` for ergonomic linkage in the UI.
model Broadcast {
  id                    String              @id @default(cuid())
  workspaceId           String
  // The channel ACCOUNT this campaign sends from. Null = fall back to the
  // channel default (pre-multi-account rows).
  channelConnectionId   String?
  // Nullable + SetNull — broadcasts are audit history; we never want them
  // destroyed when the agent who launched them is removed.
  createdById           String?
  status                BroadcastStatus     @default(queued)
  // Optional operator-given label for the list/audit ("Ramadan promo").
  // Falls back to the template name in the UI when null.
  name                  String?
  // Future send time. Null = send immediately (legacy behavior). When set +
  // in the future, the broadcast is created `scheduled` and a delayed BullMQ
  // job (jobId = broadcast id) fires it at this instant.
  scheduledAt           DateTime?
  // What this broadcast sends + which channel it targets. `template` broadcasts
  // are WhatsApp-only (the historical default); `freeform` broadcasts send plain
  // text to in-window Messenger/Instagram contacts.
  kind                  BroadcastKind       @default(template)
  // contact-mode (default) = single-channel, today's behavior. customer-mode =
  // omnichannel, one send per PERSON on their best channel. See BroadcastTargetMode.
  targetMode            BroadcastTargetMode @default(contact)
  channel               Channel             @default(whatsapp)
  // Snapshot of the template at send time — NULL for `freeform` broadcasts.
  templateId            String?
  templateName          String?
  templateLanguage      String?
  // Free-form message body — set for `freeform` broadcasts, null for templates.
  bodyText              String?
  // The values the agent filled into {{1}}, {{2}}, … (and optional header).
  // Schema: { body: string[], header?: string }. Empty for freeform.
  variables             Json
  // Audience picker mode the agent chose at creation.
  //   "all"       — every team contact at the moment of creation.
  //   "selected"  — the recipient list was hand-picked.
  //   "by_tag"    — `audienceTagIds` were resolved to the recipient list at
  //                 the moment of creation (snapshot). A contact re-tagged
  //                 later does NOT get added to an in-flight broadcast.
  audienceMode          String
  // Tag ids the agent originally selected (mode = by_tag). Kept for the
  // detail page so the audit trail can show "Sent to VIP, Ramadan buyers"
  // even after the tag is renamed.
  audienceTagIds        String[]            @default([])
  // Group used when mode = "group". Held as a soft reference (just the id +
  // a denormalized name) — no FK because we never want to cascade-delete a
  // broadcast's audit trail when the group gets removed.
  audienceGroupId       String?
  audienceGroupName     String?
  // Counters live on the parent for cheap progress reads — derived from
  // BroadcastRecipient.status, kept in sync by the runner.
  // Recipients removed from the audience at create time because they had
  // opted out of marketing. Write-once at creation, so unlike the delivery
  // counters it has no drift surface and needs no sweeper. Surfaced in the
  // report ("targeted 10,000 · 47 suppressed · 9,953 queued") — without it
  // totalCount silently shrinks and generates "why did only N get this?" tickets.
  suppressedCount       Int                 @default(0)
  // Template category snapshot (MARKETING | UTILITY | AUTHENTICATION) taken at
  // send time. Gates opt-out suppression (only marketing suppresses) and labels
  // the cost breakdown, so it pays for itself twice.
  templateCategory      String?
  totalCount            Int                 @default(0)
  sentCount             Int                 @default(0)
  failedCount           Int                 @default(0)
  // Free-form last-error captured if the whole runner crashed (not per-
  // recipient errors, those live on the BroadcastRecipient row).
  lastError             String?
  // When this broadcast was last parked `paused` (dead credentials at fire time,
  // or the mid-run permanent-error breaker). Null unless currently/previously
  // paused. Exists so the drift sweeper can auto-resume a paused campaign after
  // a COOLDOWN rather than only at process boot — before this, a broadcast
  // paused at 2am sat dead until the next deploy. The cooldown is what makes
  // auto-resume safe: a still-broken cause re-parks the row, so retrying is
  // bounded to once per cooldown instead of a hot loop.
  pausedAt              DateTime?
  // WHY this broadcast was parked `paused`, so auto-resume can tell a transient
  // cause from a hopeless one. Free-form string (not an enum) to match how
  // `lastError` is already carried and to avoid a migration per new cause:
  //   "rate_limited"  — Meta throttled us; resuming after a cooldown is the FIX
  //   "not_connected" — creds missing at fire time; costs zero sends to retry
  //   "credentials"   — token died mid-run; self-heals once re-authed
  //   "shutdown"      — graceful stop mid-send; must resume
  //   "template"      — template disabled/paused at Meta. NOT auto-resumed:
  //                     the fix is entirely operator-side in Meta's console, and
  //                     each retry burns PERMANENT_ERROR_PAUSE_THRESHOLD more
  //                     recipients into `failed` for nothing.
  pausedReason          String?
  // Staging area for a LARGE broadcast's recipients while it is `materializing`.
  // Audience is resolved to `{ contactId, customerId? }[]` in the create request
  // (so the snapshot is locked at creation), but the actual BroadcastRecipient
  // rows are chunk-inserted asynchronously by the materialize worker — inserting
  // 100k rows inside the create HTTP transaction blows the tx budget. The worker
  // reads this, inserts in batches, then NULLs it (reclaims the ~MBs) and flips
  // `materializing` → `queued`. Null for small broadcasts (built synchronously)
  // and for every terminal/queued row. Shape: Array<{ contactId: string;
  // customerId?: string | null }>.
  materializeRecipients Json?

  // --- Campaign assignment (see BroadcastAssignmentMode) --------------------
  // Who owns the replies this campaign generates. Resolved per recipient ONCE,
  // when BroadcastRecipient rows are built, and stored on the recipient row —
  // so an exact-count split is guaranteed and a resume/retry can't re-draw.
  assignmentMode      BroadcastAssignmentMode @default(none)
  // Target for mode = fixed. Plain id (no FK) — a removed member degrades the
  // campaign to "no assignment", it never breaks the send.
  assignmentUserId    String?
  // Target for mode = policy.
  assignmentPolicyId  String?
  // Split table for mode = split_counts / split_percent. Shape:
  // `Array<{ userId: string; value: number }>` — `value` is a literal recipient
  // count (split_counts) or a relative weight (split_percent).
  assignmentSplit     Json?
  // WHEN the drawn assignee is applied.
  //   "on_reply" (default) — only once the customer actually replies. A
  //     campaign is mostly one-way: assigning all 10,000 recipients at send
  //     time would put thousands of conversations nobody will ever answer onto
  //     agents' plates, inflating the open-conversation counts that capacity
  //     limits and least-busy routing are measured against. The split is still
  //     DRAWN up front (so "50 to Ali" stays exact) — it's only APPLIED to the
  //     people who engage.
  //   "on_send" — apply immediately after a successful send. For campaigns
  //     where ownership of the outreach itself matters (a sales sequence an
  //     agent is expected to follow up on) rather than ownership of replies.
  // String, not an enum, so adding a trigger later is a code change not a
  // migration — same reasoning as Broadcast.pausedReason.
  assignmentTrigger   String                  @default("on_reply")
  // What to do with recipients left over after an exact-count split is
  // exhausted: "leave_unassigned" (default) or "policy" (run the team default
  // policy for the remainder).
  assignmentLeftover  String                  @default("leave_unassigned")
  // Whether to overwrite a conversation that ALREADY has an assignee. Default
  // false: a campaign never steals a thread a human is already handling.
  assignmentOverwrite Boolean                 @default(false)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection?   @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  createdBy         User?                @relation("CreatedBroadcasts", fields: [createdById], references: [id], onDelete: SetNull)
  recipients        BroadcastRecipient[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  // Calendar view + scheduler boot-reconcile scan upcoming scheduled sends.
  @@index([workspaceId, scheduledAt])
  // Backs the paused-broadcast drift sweeper:
  // WHERE status = 'paused' AND pausedAt <= cutoff.
  @@index([status, pausedAt])
  // FK index for the channelConnection relation's onDelete: SetNull. Without it,
  // disconnecting a channel account seq-scans every broadcast the workspace has
  // ever run. Created by migration 20260722180000; declared here so it stops
  // reading as schema drift.
  @@index([channelConnectionId])
}

// TENANCY EXCEPTION — no workspaceId by design. Reach these rows ONLY
// through their workspace-carrying parent, resolved with a workspaceId-scoped
// query FIRST; never query by a bare child id taken from request input. The
// checker (scripts/check-prisma-fields.mjs) allowlists this model — adding a
// new tenant-less model without updating the allowlist fails CI.
model BroadcastRecipient {
  id             String                   @id @default(cuid())
  broadcastId    String
  contactId      String
  // The unified PERSON this recipient targets (customer-mode only). `contactId`
  // is the channel-contact actually sent to — resolved from the person's best
  // live channel at build time. Null in contact-mode. Soft pointer (no FK).
  customerId     String?
  // Set after the runner picks/creates a conversation for this recipient so
  // the message lands in the existing thread (matches the inbox rules). Soft
  // reference (plain string, no FK) — survives conversation hard-delete by
  // design: the broadcast's audit trail must outlive a thread an agent later
  // deletes. The detail UI tolerates a 404 when following a dangled id.
  conversationId String?
  // Pre-drawn assignee for this recipient (see BroadcastAssignmentMode). Set
  // when the recipient rows are built — NOT at send time — so an exact-count
  // split ("first 50 to Ali") is deterministic and a resumed run reuses the
  // same draw instead of redistributing. The runner applies it AFTER a
  // successful send, via the shared `assignConversation` mutation. Plain id
  // (no FK): a removed member degrades to "no assignment", never a broken row.
  assignedUserId String?
  status         BroadcastRecipientStatus @default(queued)
  // Meta wamid of the sent message — links back to the Message row.
  externalId     String?
  // Per-recipient error body, kept compact for the UI table.
  errorMessage   String?
  sentAt         DateTime?

  // ── Delivery truth (webhook-owned; see BroadcastDeliveryState) ────────────
  // Advanced by `applyBroadcastDeliveryStatus` in lib/providers/ingest.ts as
  // Meta's async status webhooks arrive. Monotonic: a terminal state never
  // leaves, and `undelivered` may only overwrite `pending`/`sent` (if the
  // handset already acked, a later failure webhook is a Meta duplicate, not a
  // regression — Meta batches `delivered` + `failed` for one wamid more often
  // than you'd expect on marketing sends).
  deliveryState BroadcastDeliveryState @default(pending)
  deliveredAt   DateTime?
  readAt        DateTime?
  // Normalized failure reason, sharing ONE vocabulary with the send path (the
  // `MetaErrorCode` union in lib/providers/meta-send-error.ts) so the failure
  // report is a single GROUP BY instead of two disjoint taxonomies. Stored as
  // String, not a Prisma enum, so a new Meta code is a code change rather than
  // a migration — and an unmapped code degrades to `provider_rejected` instead
  // of failing the webhook write.
  errorCode     String?
  // Meta's raw numeric code, kept for forensics + for classifying codes we
  // haven't mapped yet.
  metaErrorCode Int?
  // Required by the /v1 `updatedSince` incremental sync: without it a client
  // pulling late-arriving delivery/read updates must re-fetch all 100k rows.
  updatedAt     DateTime               @updatedAt

  // ── Engagement (attributed post-commit from inbound ingest) ───────────────
  // First reply only — the CAS is `where repliedAt: null`, so this counts
  // unique RECIPIENTS who replied, not messages. That's the right denominator
  // for a reply RATE, and the UI labels it accordingly.
  repliedAt          DateTime?
  /**
   * Soft pointer (no FK) to the inbound message credited, for audit.
   */
  repliedMessageId   String?
  /**
   * How the reply was credited: "direct" = the customer quoted our campaign
   * message (exact), "window" = first inbound inside the attribution window
   * (last-touch inference). Stored so the report can footnote "N of M
   * attributed by time window" — that's what turns a guess into a measurement
   * an operator can calibrate their trust against.
   */
  repliedAttribution String?
  // Template quick-reply button tap. Keyed on the STABLE option id, never the
  // button's display title (titles are editable, which would silently reset a
  // click report's history).
  clickedAt          DateTime?
  clickedOptionId    String?
  /**
   * Set when this recipient opted out within the campaign's attribution window.
   */
  optedOutAt         DateTime?

  // ── Cost (from Meta's status webhook `pricing` object) ────────────────────
  // Stored HERE rather than on Message because campaign cost is always
  // aggregated per campaign — on Message it would force a join across the
  // largest table in the database — and because Message.rawPayload is not
  // durable (the retention sweeper nulls it).
  // NOTE: no currency amount. Meta sends a CATEGORY and a billable flag, never
  // a price; rates are per-country rate cards that change quarterly, so storing
  // a computed amount would freeze a wrong number into the audit trail. The
  // report shows billable conversation counts by category and lets the operator
  // apply their own rate card.
  pricingCategory String?
  pricingBillable Boolean?
  pricingModel    String?
  /// Meta's `pricing.type` — WHY this message was or wasn't charged:
  /// `regular` (billed), `free_customer_service` (a utility/non-template message
  /// inside the recipient's open 24h service window), `free_entry_point` (a
  /// free-entry-point window), `free_group_customer_service` (the Groups
  /// equivalent).
  ///
  /// This is the column that makes `pricingBillable` explicable. Two recipients
  /// of ONE utility campaign legitimately differ — the one who had messaged in
  /// the last 24 hours rode an open service window for free — and without the
  /// type, a mixed billable column in a single campaign reads as a bug in our
  /// reporting rather than as Meta pricing per recipient, which is exactly how
  /// it was first reported to us.
  ///
  /// A plain String, not an enum: Meta added `free_group_customer_service` with
  /// the Groups API and will add more, and an unrecognized value must never need
  /// a migration before it can be stored.
  pricingType     String?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Each contact appears at most once per broadcast — dedupe in the audience
  // picker, but enforce here too so the runner can re-run idempotently.
  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  // Broadcast send loop: the runner pages recipients with
  // WHERE broadcastId = ? AND status = 'queued' ORDER BY id ASC, cursor on id.
  // Without `id` in the index every page matched the whole remaining queued set
  // and sorted it, so a 100k-recipient broadcast got progressively SLOWER the
  // further it got — ~1000 pages each re-scanning what was left. With the sort
  // column included each page is a bounded range scan from the cursor.
  @@index([broadcastId, status, id])
  // Reply attribution probes "most recent campaign this contact was sent,
  // within the window" on every inbound message. contactId-leading, so it also
  // still backs the Contact-cascade delete that the bare [contactId] index
  // served — that one is now a redundant leftmost prefix and is dropped.
  @@index([contactId, sentAt(sort: Desc)])
  // Campaign report: serves BOTH the funnel `GROUP BY deliveryState` (the
  // leading two columns are an index-only scan) AND the filtered drill-down
  // `WHERE broadcastId=? AND deliveryState=? ORDER BY id` (the trailing `id`
  // is what keeps each page a bounded range scan — the same lesson already
  // paid for on [broadcastId, status, id] above). Deliberately NOT paired with
  // a 2-column [broadcastId, deliveryState] variant: that's a redundant
  // leftmost prefix and pure write overhead on a table taking 100k inserts +
  // ~200k webhook updates per campaign.
  @@index([broadcastId, deliveryState, id])
  // The delivery-curve query buckets on `deliveredAt` and `readAt`, so each
  // needs its own (broadcastId, <ts>) index — the existing status/state indexes
  // don't carry those columns and the scan would read every recipient row of
  // the campaign twice.
  //
  // Scoped to exactly the two curves that need it, deliberately: this table
  // takes a write on every status webhook, and each extra index is paid on
  // every one of those. `sentAt` is already covered for this purpose by the
  // (contactId, sentAt) index's leading scan, and `repliedAt` is rare enough
  // that the sequential portion is negligible.
  @@index([broadcastId, deliveredAt])
  @@index([broadcastId, readAt])
}

model InternalNote {
  id             String   @id @default(cuid())
  // Tenant scope, for rule-#2 consistency with every other table (notably its
  // sibling audit table ConversationEvent). A note's team always equals its
  // conversation's team (conversations never change team), so this is a stable
  // denorm — kept for direct team-scoped queries / future RLS, not for delete
  // cascades (those already flow Workspace -> Conversation -> InternalNote).
  workspaceId    String
  conversationId String
  // Nullable + SetNull — internal notes are critical audit trail. When the
  // author is removed, the note STAYS and the UI renders "Removed user".
  // Cascading would destroy customer-context the next agent needs.
  authorUserId   String?
  body           String
  timestamp      DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, timestamp])
  // No bare @@index([workspaceId]) — covered by InternalNote_teamId_timestamp_id_idx
  // below (workspaceId-leading), which serves workspaceId-prefix lookups too. Dropped as
  // write overhead — migration 20260611130000.
  // FK index for the `author` relation's onDelete: SetNull — without it,
  // hard-deleting a teammate seq-scans InternalNote to null their authored
  // rows (same rationale as Message_senderUserId_idx). Migration 20260611130100.
  @@index([authorUserId])
  // pg_trgm GIN for the GLOBAL inbox-search "Comments" tab — an ILIKE on a
  // note's body across every conversation in the team. Same rationale as
  // Message_body_trgm_idx: no conversation predicate to narrow the team-wide
  // scan, so the index carries it.
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "InternalNote_body_trgm_idx")
  // Workspace-wide "Comments" search SORT support — same rationale as
  // Message_teamId_timestamp_id_idx: the trgm index filters, this btree serves
  // the ORDER BY (timestamp DESC, id DESC) so a broad term doesn't sort a large
  // GIN bitmap in memory.
  @@index([workspaceId, timestamp(sort: Desc), id(sort: Desc)], map: "InternalNote_teamId_timestamp_id_idx")
}

// ---------------------------------------------------------------------------
// Message flags (triage)
// ---------------------------------------------------------------------------
//
// A flag marks ONE MESSAGE as needing follow-up of a named kind ("Complaint",
// "Refund request", "Bug report") and carries a resolution lifecycle, so the
// team can come back later and know whether it was handled.
//
// Why this is NOT the Tag table: `Tag` labels a CONTACT and feeds broadcast
// audience targeting (AudienceGroup.tags) plus the tag-usage settings screen.
// Putting "Complaint" in there would make it a selectable broadcast segment and
// pollute segmentation, and `Tag` has nowhere to hang open/resolved, an owner,
// or who resolved it. Different noun, different lifecycle, different table.
//
// Why message-level and not conversation-level: a thread is long-lived and
// reopens forever (one conversation per contact). "This customer complained" is
// not useful; "THIS message is a complaint" points at the exact thing to act on
// and is what an agent — or later the AI, mid-chat — actually observes.

// One day of Meta's own template analytics, per template.
//
// A DAILY ROLLUP rather than a per-broadcast snapshot, because Meta reports at
// template+day granularity and two campaigns using one template on one day
// genuinely share those numbers. Storing per-broadcast would either duplicate
// the same figures under both or force an arbitrary split of them.
//
// This is the ONLY place currency cost is available: the delivery funnel we
// build from status webhooks knows a pricing CATEGORY but never a price. It is
// also the only source of unique URL-button clicks.
model TemplateAnalyticsDaily {
  id                 String   @id @default(cuid())
  workspaceId        String
  /// Meta's template id (`MessageTemplate.externalId`), not our row id — the
  /// analytics API speaks in Meta ids, and a template can be re-synced.
  templateExternalId String
  date               DateTime @db.Date
  sent               Int      @default(0)
  delivered          Int      @default(0)
  /// Nullable, NOT zero-defaulted: Meta only returns read/click for the last 7
  /// days, so "we don't know" and "nobody read it" must stay distinguishable.
  /// After that window Meta RESETS the counts to zero (not absent), so the
  /// upsert merges these with GREATEST — a re-fetch of an aged campaign can
  /// never overwrite a captured number with a later null OR zero.
  read               Int?
  /// URL-button ("link") clicks — unique accounts when Meta reports them,
  /// total clicks otherwise. Quick-reply presses are excluded (they arrive as
  /// inbound replies and are already counted in the per-recipient funnel).
  clicked            Int?
  /// Meta's per-button click entries, verbatim but normalized:
  /// `[{ type, buttonContent, count }]` with type one of `url_button`,
  /// `unique_url_button`, `quick_reply_button`. Null when Meta reported no
  /// click data (no buttons, or outside the 7-day window).
  clickedButtons     Json?
  /// Withheld by Meta when the WABA is billed through a Solution Partner.
  costAmountSpent    Decimal? @db.Decimal(14, 6)
  costPerDelivered   Decimal? @db.Decimal(14, 6)
  costPerUrlClick    Decimal? @db.Decimal(14, 6)
  currency           String?
  fetchedAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, templateExternalId, date])
  // The per-template trend and the per-broadcast merge are both a date RANGE
  // for one template, which this index serves directly.
  @@index([workspaceId, templateExternalId, date])
}

enum InboxViewVisibility {
  personal
  shared
}

// A saved inbox view — a named, reusable filter over the conversation list.
//
// The built-in presets (Active/All/Mine/Unassigned/Closed/Flagged) answer
// "what state is this thread in". A view answers "which slice of work is mine
// to look at": "Support · unassigned · WhatsApp", "VIP escalations".
//
// WHY `filters` IS JSON, not columns: every criterion is optional and
// orthogonal, and the set will grow (ticket status, SLA breach, custom
// fields). As columns that is a migration per criterion and a wide sparse
// table. As one validated document it is one Zod schema
// (inbox-views.schemas.ts) and one WHERE builder (lib/inbox-views/where.ts) —
// and both are shared with the /v1 API. The cost accepted: the DB cannot
// enforce that a referenced tag/stage/user still exists, so the builder drops
// dangling ids at read time (INBOX_VIEW_DANGLING_POLICY in @ccp/shared).
model InboxView {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  // Named color slot from TAG_COLORS ("rose", "amber", …) — never a hex, so
  // the UI maps to a safelist without dynamic class strings. Same contract as
  // Tag.color and MessageFlagDefinition.color.
  color       String              @default("slate")
  // Key from INBOX_VIEW_ICONS. Stored as a key, not a component name, so an
  // unknown value degrades to the default icon instead of breaking the rail.
  icon        String              @default("filter")
  visibility  InboxViewVisibility @default(personal)
  createdById String?
  // Validated InboxViewFilters document. See @ccp/shared/inbox-views/types.
  filters     Json                @default("{}")
  // Manual ordering within its visibility group. Ties broken by name.
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: a SHARED view outlives the agent who created it.
  // Deleting the team's "Escalations" inbox because its author left would be a
  // silent, unrecoverable loss of team configuration. PERSONAL views are the
  // opposite case — an owner-less one is visible to nobody — so
  // `UsersService.remove` deletes them explicitly right after the user row
  // goes, next to the avatar GC.
  createdBy User?     @relation("CreatedInboxViews", fields: [createdById], references: [id], onDelete: SetNull)

  // The list query is always "views visible to me in this workspace" =
  // shared ones + my personal ones, so both reads are workspace-prefixed.
  //
  // NAME UNIQUENESS is enforced by two PARTIAL unique indexes created in raw
  // SQL by migration 20260722220000_inbox_views, because the rule is
  // conditional and Prisma cannot express it:
  //   shared   → unique per (workspace, lower(name))              — one team list
  //   personal → unique per (workspace, owner, lower(name))       — per person
  // A single @@unique([workspaceId, visibility, createdById, name]) would let
  // two admins each create a SHARED "Escalations" (different createdById), and
  // would compare names case-sensitively. Violations still surface as P2002 →
  // 409 through PrismaExceptionFilter.
  @@index([workspaceId, visibility])
  @@index([workspaceId, createdById])
}

// A flag definition the team can raise. Workspace-scoped catalog, modelled on `Tag`.
//
// `color` is a named slot ("rose", "amber", …) NOT a hex, so the UI maps to a
// safelist of Tailwind classes without dynamic class strings — same contract as
// Tag.color, sharing TAG_COLORS from @ccp/shared.
model MessageFlagDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("slate")
  // Shown as helper text in the flag picker — "what does this one mean", so a
  // new agent picks the right one.
  description String?
  // Soft-retire instead of delete. A definition with history must stay
  // renderable in old threads and in the audit timeline, so the service only
  // permits a hard delete when the definition has zero flags (409 otherwise)
  // and steers everything else here. Archived definitions disappear from the
  // picker but keep rendering on existing flags.
  archived    Boolean  @default(false)
  // Manual ordering in the picker and the queue rail. Ties broken by name.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flags     MessageFlag[]

  // (workspaceId, name) unique already serves workspaceId-prefix lookups, so no separate
  // @@index([workspaceId]) — same call as Tag.
  @@unique([workspaceId, name])
}

// One raised flag. Modelled on InternalNote (the canonical "attached to a
// conversation by a user, survives that user leaving" shape).
model MessageFlag {
  id             String @id @default(cuid())
  // Tenant scope, same stable denorm rationale as InternalNote.workspaceId — every
  // read is workspaceId-scoped, and the queue lists flags across conversations so it
  // needs workspaceId directly rather than through a join.
  workspaceId    String
  messageId      String
  // Denormalized from the message. The queue list groups/filters by thread and
  // the openFlagCount maintenance needs the parent id inside the same write —
  // both would otherwise join Message purely to read one column.
  conversationId String
  definitionId   String

  status     MessageFlagStatus @default(open)
  // Who raised it: "human" | "ai" | "workflow" | "api". A plain string, not an
  // enum, because the set is provenance metadata rather than behaviour — new
  // sources must not require a migration + enum rollout. Nothing branches on it
  // beyond rendering an "AI" chip.
  source     String            @default("human")
  // 0..1, AI-raised flags only; null for every human flag. Lets the UI show a
  // low-confidence AI flag as a suggestion rather than a fact.
  confidence Float?
  // Why it was flagged, written when raising it.
  note       String?

  // All four actor columns are nullable + SetNull: a flag is triage history and
  // must outlive the departure of whoever touched it (same rule as
  // InternalNote.authorUserId).
  createdById    String?
  // Who owns following this up. Independent of Conversation.assignedUserId — the
  // thread can belong to one agent while a specific complaint on it is owned by
  // someone else.
  assignedToId   String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message      Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a definition must never silently erase the
  // triage history raised under it. The service enforces the friendly version of
  // this (delete only when unused, else archive); this is the backstop.
  definition   MessageFlagDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  createdBy    User?                 @relation("CreatedMessageFlags", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?                 @relation("AssignedMessageFlags", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy   User?                 @relation("ResolvedMessageFlags", fields: [resolvedById], references: [id], onDelete: SetNull)

  // One flag of a given kind per message. This is the idempotency key: raising
  // the same flag twice (a double-click, a retried API call, an at-least-once
  // AI job) upserts instead of duplicating. Two DIFFERENT definitions on the
  // same message are fine — a message can be both a complaint and a refund
  // request.
  // workspaceId deliberately absent from this unique: the leading cuid FK
  // already implies exactly one workspace (Batch D, 2026-07-27).
  @@unique([messageId, definitionId])
  // The triage queue: WHERE workspaceId = $1 AND status = 'open'
  // ORDER BY createdAt DESC, id DESC — keyset-paginated, so the sort key rides
  // along and the scan stops at `take`.
  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  // "Assigned to me, still open" — the queue's default personal view.
  @@index([workspaceId, assignedToId, status])
  // Thread hydration loads flags for the current page of messages
  // (WHERE messageId IN (...)), and the drift sweeper reconciles per
  // conversation.
  @@index([messageId])
  @@index([conversationId])
  // FK indexes for the SetNull / Restrict relations — without them, deleting a
  // teammate or a definition seq-scans this table. Same rationale as
  // Message_senderUserId_idx (migration 20260611130100).
  @@index([definitionId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([resolvedById])
}

// ---------------------------------------------------------------------------
// Ticketing
// ---------------------------------------------------------------------------
//
// A CONVERSATION is the long-lived thread with one contact on one channel —
// it never fragments (`@@unique([workspaceId, contactId])`). A TICKET is the
// unit of WORK on that thread, and there are MANY over time: the same customer
// asks about a refund in March and a delivery in June, and those are two
// pieces of work with their own assignee, priority, SLA clock and resolution —
// on one unbroken thread. That is the whole reason this entity exists; folding
// work state onto the conversation would have forced either a fragmented inbox
// or a single ever-open thread with no reportable outcomes.
//
// The inbox is deliberately UNTOUCHED by this: its reducers, rooms and fanout
// keep operating on conversations. The ticket board is a parallel lens over the
// same messages, and `Message.ticketId` is the join between them.

enum TicketStatus {
  // Auto-opened, nobody has picked it up yet. Distinct from `open` so "never
  // touched" is reportable — an untriaged backlog is a different problem from
  // a worked one.
  new
  open
  // Waiting on the CUSTOMER. The SLA clock optionally pauses here (per policy)
  // because time we spend waiting on them isn't time we owe them.
  pending
  // Waiting on US but deliberately parked (escalation, a part on order).
  on_hold
  // Work is done; the reopen window is still running, so a follow-up message
  // lands back on THIS ticket rather than opening a new one.
  solved
  // Terminal. A message after this always opens a new ticket.
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

// Ticket audit timeline. Separate from ConversationEvent on purpose: the
// conversation timeline answers "what happened on this thread", this answers
// "what happened to this piece of work", and mixing them would make either
// feed unreadable. Only four ticket boundaries cross over as inline pills
// (see ConversationEventKind.ticket_*).
enum TicketEventKind {
  created
  assigned
  unassigned
  // The ticket was handed to a different TEAM (or taken out of every queue).
  // Distinct from `assigned`, which is about a PERSON: a handoff to Sales and a
  // claim by someone on Sales are two different things a reader needs to tell
  // apart, and collapsing them makes "how long did Sales sit on this" unanswerable.
  team_changed
  // An internal note on the ticket. The customer never sees it.
  //
  // Lives on the ticket TIMELINE rather than in a separate table because that is
  // exactly where it has to be read: the whole point is Sales answering "tell
  // them X" in-line with the handoff that prompted it. A parallel notes table
  // would put the question and the answer on two different screens.
  note
  status_changed
  priority_changed
  subject_changed
  description_changed
  tag_added
  tag_removed
  field_changed
  sla_breached
  reopened
  merged
  // ---- Cross-workspace sharing (see TicketShare) ----
  // This ticket was shared with another workspace — escalated to a department
  // that can now work it. `body` carries the cause; `after` names the guest.
  escalated
  // Access was revoked; the guest workspace can no longer see the ticket. The
  // row stays as history — who had the key, and until when.
  escalation_revoked
  // A comment on the ticket. On a SHARED ticket everyone with access sees it —
  // that is the conversation between the departments. Distinct from `note`,
  // which stays inside the workspace that wrote it.
  escalation_note
  // Retired (2026-07-30, the twin-pair design): a shared ticket has ONE status,
  // so a status change is a plain `status_changed` row on it. Kept because
  // Postgres enum values cannot be dropped, and old rows still render.
  escalation_received
  escalation_status
  escalation_severed
  // A file was attached to the ticket (see TicketAttachment). `after` snapshots
  // the filename + size so the log still reads after the file is deleted.
  attachment_added
  attachment_removed
}

model Ticket {
  id          String @id @default(cuid())
  workspaceId String
  // Human-facing sequential id ("#1042"), unique per workspace. NOT the cuid —
  // agents and customers quote this number to each other.
  //
  // GAPS ARE ACCEPTABLE; COLLISIONS ARE NOT. Allocated from TicketNumberCounter
  // by `allocateNumber`, which `createTicket` calls BEFORE opening its
  // transaction — so a create that fails after allocating burns its number.
  //
  // That is not a new property, which is the point: `deleteTicket` (UI and
  // DELETE /v1/tickets/:id) removes a ticket without renumbering survivors, and
  // the counter is only ever incremented — never decremented. Deleting #5
  // already leaves a permanent, user-visible gap, through a far more common
  // path than a failed create. Gaplessness is therefore not something this
  // product has ever offered, and making it true would mean holding the
  // counter's row lock until COMMIT — which serialized every concurrent create
  // in a workspace and blew the 15s transaction ceiling at 8 of them
  // (measured 2026-07-29).
  //
  // Nothing derives from contiguity: every consumer renders `#{number}` and
  // nothing does arithmetic on it, counts by it, or computes a "next".
  // The `@@unique([workspaceId, number])` below is the property that matters.
  number      Int

  // Nullable ONLY for an escalated-in ticket (source "escalation"): the target
  // workspace receives the work with a contact SNAPSHOT (TicketEscalation) and
  // no thread of its own until "Message customer" binds one. Every other create
  // path requires both — enforced in lib/tickets, not the schema.
  conversationId String?
  // Denormalized from the conversation. The board lists tickets ACROSS
  // conversations and filters by channel, so both would otherwise be a join
  // on the hottest ticket read. Conversation.channel is immutable for the
  // thread's lifetime, so this can't drift.
  contactId      String?
  channel        Channel

  // Free text, agent- or automation-authored. Null means "not titled yet" and
  // the UI falls back to the first inbound message excerpt — deliberately not
  // auto-filled into the column, so a real subject is distinguishable from a
  // guess.
  subject     String?
  // The CAUSE — why this ticket exists, in the raising agent's words. Distinct
  // from `subject` (a one-line title) and from a `team_changed` handoff reason
  // (which is per-handoff): this is the ticket's defining context, set when it
  // is raised and read by whoever the ticket is handed to so they understand the
  // issue without re-reading the whole thread. Free-form, so @db.Text.
  description String?        @db.Text
  status      TicketStatus   @default(new)
  priority    TicketPriority @default(normal)

  // Independent of Conversation.assignedUserId: the thread can belong to one
  // agent while a specific ticket on it is owned by someone else. Same
  // never-cleared continuity column as the conversation (see its comment).
  assignedUserId     String?
  lastAssignedUserId String?
  // The AssignmentPolicy that routed it, for reporting "which queue did this
  // come through". Plain id, no FK — an archived policy must not cascade into
  // closed work. PROVENANCE ONLY: it records how the ticket arrived, and never
  // changes when the ticket is handed on. See `assignedTeamId` for ownership.
  policyId           String?
  // The TEAM that currently owns this ticket — an AssignmentPolicy, which is
  // what a "team" is in this product (Sales, Support, Billing).
  //
  // This is the handoff primitive, and it is deliberately separate from
  // `assignedUserId`. The real workflow is: Support reads a message, realises
  // the issue belongs to Sales, and hands the TICKET to Sales — at which point
  // it belongs to a queue, not yet to a person. Whoever on Sales picks it up
  // then takes `assignedUserId`. Modelling only a person forced the handing-over
  // agent to guess WHO on the other team should own it, which is exactly the
  // decision they are unqualified to make.
  //
  // The two are independent, and every combination is meaningful:
  //   team + no user  → in Sales' queue, unclaimed
  //   team + user     → claimed by someone on Sales
  //   no team + user  → assigned directly, no queue involved
  //   neither         → unassigned backlog
  //
  // SetNull, not Cascade: deleting a team must never delete the work it was
  // holding — the tickets fall back to the unassigned backlog, visibly.
  assignedTeamId     String?

  // ---- SLA ----
  // Due dates are COMPUTED at create / priority-change from the matching
  // TicketSlaPolicy and then STORED, not derived on read: the policy can be
  // edited later and a ticket must keep the commitment it was created under.
  slaPolicyId           String?
  firstResponseDueAt    DateTime?
  resolutionDueAt       DateTime?
  firstResponseAt       DateTime?
  firstResponseBreached Boolean   @default(false)
  resolutionBreached    Boolean   @default(false)
  // Accumulated paused time in ms + the open pause's start. Storing the
  // accumulation (rather than recomputing from the event log) keeps the
  // breach sweeper a single indexed range scan instead of a per-ticket replay.
  slaPausedMs           Int       @default(0)
  slaPausedAt           DateTime?

  // ---- Resolution ----
  resolvedAt     DateTime?
  closedAt       DateTime?
  resolvedById   String?
  // Short reportable outcome ("refunded", "duplicate", "no_response"). Free
  // string rather than an enum for the same reason as MessageFlag.source — the
  // set is per-org vocabulary, not behaviour.
  resolutionCode String?
  resolutionNote String?
  // How many times this ticket came back from `solved`. A high number is the
  // signal that "solved" was optimistic — worth reporting on.
  reopenCount    Int       @default(0)
  lastSolvedAt   DateTime?

  // ---- Provenance ----
  // "auto" (opened by an inbound message), "human", "workflow", "api",
  // "escalation" (created here by another workspace escalating a ticket in).
  source            String  @default("auto")
  createdById       String?
  createdByApiKeyId String?

  // Values keyed by TicketFieldDefinition.key — same shape and rationale as
  // Contact.customFields.
  customFields Json @default("{}")

  // Optimistic-concurrency token. Two agents dragging the same card on a board
  // is the normal case here, not the exotic one.
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation  Conversation?     @relation("ConversationTickets", fields: [conversationId], references: [id], onDelete: Cascade)
  contact       Contact?          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser  User?             @relation("AssignedTickets", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedTeam  AssignmentPolicy? @relation("TeamTickets", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  resolvedBy    User?             @relation("ResolvedTickets", fields: [resolvedById], references: [id], onDelete: SetNull)
  slaPolicy     TicketSlaPolicy?  @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  // Shared taxonomy with contacts — an org that already colour-codes "VIP" and
  // "billing" should not maintain a second parallel tag list.
  tags          Tag[]             @relation("TicketTags")
  events        TicketEvent[]
  messages      Message[]
  // Back-reference for Conversation.activeTicketId.
  activeOn      Conversation[]    @relation("ConversationActiveTicket")
  // Which sibling workspaces have been granted access to THIS ticket (see
  // TicketShare). Empty for the overwhelming majority — a ticket only becomes
  // cross-workspace when someone deliberately escalates it.
  shares      TicketShare[]
  attachments TicketAttachment[]
  // The SLA breach sweeper scans ACROSS workspaces for tickets whose clock has
  // run out and that aren't already flagged. That is a tiny fraction of rows,
  // so it is served by two PARTIAL indexes Prisma cannot express (raw SQL in
  // migration 20260722190000_ticketing):
  //   Ticket_first_response_due_idx ON ("firstResponseDueAt")
  //     WHERE "firstResponseDueAt" IS NOT NULL AND NOT "firstResponseBreached"
  //   Ticket_resolution_due_idx ON ("resolutionDueAt")
  //     WHERE "resolutionDueAt" IS NOT NULL AND NOT "resolutionBreached"
  // A plain composite would be useless: the sweeper's predicate is a range on
  // the due date, so nothing can sit between it and the workspace key without
  // killing the ordered scan. Same pattern as Conversation's openFlagCount
  // partial index.

  @@unique([workspaceId, number])
  // Board + list, keyset-paginated: WHERE workspaceId = $1 [AND status = $2]
  // ORDER BY createdAt DESC, id DESC.
  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  // "My tickets" — the view an agent lives in, same shape as the Mine inbox.
  @@index([workspaceId, assignedUserId, status, createdAt(sort: Desc), id(sort: Desc)])
  // The team-queue board: "everything waiting on Sales", newest first. Carries
  // the sort key so the list is a range scan that stops after `take`, matching
  // the assignedUserId board index above.
  @@index([workspaceId, assignedTeamId, status, createdAt(sort: Desc), id(sort: Desc)])
  // FK index for the SetNull relation — without it, deleting a team seq-scans
  // every ticket in the deployment to null the column.
  @@index([assignedTeamId])
  // Priority-sorted board column.
  @@index([workspaceId, priority, status])
  // The conversation rail ("other work on this thread") and the ingest-time
  // active-ticket lookup.
  @@index([conversationId, createdAt(sort: Desc)])
  // "Everything this person ever raised", across their threads.
  @@index([workspaceId, contactId, createdAt(sort: Desc)])
  // FK indexes for the SetNull relations — without them, removing a teammate
  // seq-scans this table (same rationale as MessageFlag's).
  @@index([assignedUserId])
  @@index([resolvedById])
  @@index([slaPolicyId])
  @@index([contactId])
}

model TicketEvent {
  id String @id @default(cuid())
  // The OWNING workspace of the ticket (denormalized from Ticket.workspaceId),
  // not the actor's. A shared ticket has ONE history, so every row on it
  // carries the same workspaceId regardless of which department wrote it — and
  // reads reach it through `ticketAccessWhere()` on the parent ticket, never by
  // a bare workspaceId filter. Who DID it is `actorWorkspaceId` below.
  workspaceId   String
  ticketId      String
  // Which workspace the actor was acting in. Null for pre-share history and
  // for system/sweeper writes. This is what makes a shared log readable:
  // "Billing changed the status" instead of an unattributed change.
  actorWorkspaceId String?
  kind          TicketEventKind
  // Same before/after shape as ConversationEvent so one renderer covers both
  // timelines. Names (assignee, tag, field label) are SNAPSHOTTED at write time
  // so history keeps reading correctly after a rename or a departure.
  before        Json?
  after         Json?
  // Free text — the note body, and the optional "why" on a team handoff.
  //
  // A handoff without a reason is the most common way this feature fails in
  // practice: Sales receives a ticket and has to re-read the whole thread to
  // work out what Support wanted. Null on every other kind.
  body          String?
  // Nullable + SetNull: ticket history must outlive whoever made it.
  actorUserId   String?
  // Set when a /v1 partner call or a workflow made the change (actorUserId is
  // null then) — so automation is never attributed to nobody.
  actorApiKeyId String?
  createdAt     DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // SetNull, not Cascade: a shared ticket's history must outlive the guest
  // workspace being deleted — the entry stays, unattributed.
  actorWorkspace Workspace? @relation("TicketEventActorWorkspace", fields: [actorWorkspaceId], references: [id], onDelete: SetNull)
  // Files attached to THIS timeline entry (a comment with its evidence). A
  // ticket-level attachment has no event; see TicketAttachment.
  attachments TicketAttachment[]

  // The detail page reads one ticket's timeline oldest-first.
  @@index([ticketId, createdAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorUserId])
}

// A file on a ticket — the screenshot of the error, the invoice PDF, the
// signed form. Attached when the ticket is raised, or with any later comment.
//
// A SEPARATE table rather than media columns on Ticket (the shape Message and
// TeamChannelMessage use) because a ticket legitimately accumulates MANY files
// over its life and from BOTH departments, while a message carries at most one.
//
// Every attachment on a shared ticket is visible to every workspace the ticket
// is shared with — that is the point: the ticket carries all the information
// the issue needs. `workspaceId` records who UPLOADED it (attribution + quota),
// and reads go through `ticketAccessWhere()` on the parent ticket, never a bare
// workspaceId filter.
model TicketAttachment {
  id          String @id @default(cuid())
  // The UPLOADER's workspace, for attribution ("added by Billing"). NOT the
  // read scope — see the note above.
  workspaceId String
  ticketId    String
  // The timeline entry this file came in with (a comment or note), or null for
  // a file attached at raise time / directly to the ticket. Cascade: deleting
  // the event that carried it deletes the file record with it.
  eventId     String?

  // Canonical R2 key — the authority, same rule as Message.mediaKey. Registered
  // in the blob-orphan sweeper's cross-check (four historical incidents of
  // exactly this omission silently deleting live files 24h later).
  blobKey  String
  // Stable (non-fetchable) object URL. Bytes reach the browser through
  // GET /api/tickets/:id/attachments/:attachmentId, same-origin streamed.
  blobUrl  String
  filename String
  mimeType String
  // MediaKind ("image" | "video" | "audio" | "document" | "sticker") — a plain
  // string for the same reason as Message.mediaKind's neighbours: provenance
  // for rendering, not behaviour.
  kind      String
  sizeBytes Int

  uploadedById String?
  createdAt    DateTime @default(now())

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event      TicketEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // The detail page reads a ticket's files oldest-first; the timeline joins by
  // event.
  @@index([ticketId, createdAt])
  @@index([eventId])
  @@index([workspaceId])
  @@index([uploadedById])
}

// A saved TICKET view — a named, reusable filter over the board.
//
// The board's own filters (status column, priority chip, team queue) are
// transient narrowings you toggle while working. A saved view is the query a
// department actually lives in: "urgent + unclaimed", "shared with us, past
// due", "everything on the Billing queue". Modelled exactly like InboxView —
// same visibility split, same colour/icon slots, same "criteria are ONE
// validated JSON document turned into a where in exactly one place" rule —
// because the two are the same product idea over two different lists, and a
// second, subtly-different design would be two sets of bugs.
model TicketView {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  /// Named colour slot from TAG_COLORS — never a hex, so the UI maps to a
  /// safelist instead of building dynamic class strings.
  color       String              @default("slate")
  /// Key from TICKET_VIEW_ICONS; an unknown value degrades to the default.
  icon        String              @default("filter")
  visibility  InboxViewVisibility @default(personal)
  createdById String?
  /// Validated TicketViewFilters document — see @ccp/shared/tickets/views.
  filters     Json                @default("{}")
  /// Manual ordering within its visibility group. Ties broken by name.
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade, for the same reason as InboxView: a SHARED view
  // outlives the agent who built it — deleting the team's "Escalations" board
  // because its author left is a silent loss of team configuration. Personal
  // views are the opposite case and are removed with their owner in
  // UsersService.remove.
  createdBy User?     @relation("CreatedTicketViews", fields: [createdById], references: [id], onDelete: SetNull)

  // Name uniqueness is case-insensitive and per visibility group, enforced by
  // two PARTIAL unique indexes in migration 20260730180000 (Prisma's DSL can
  // express neither `lower(name)` nor a `WHERE`) and asserted by
  // apps/api/test/partial-indexes.spec.ts.
  @@index([workspaceId, visibility, position])
  @@index([createdById])
}

// One SLA commitment per priority. Modelled per-priority rather than as a
// free-form policy list because that is the only dimension every helpdesk
// actually varies, and it makes "which policy applies" a lookup with no
// matching rules to get wrong.
model TicketSlaPolicy {
  id                String         @id @default(cuid())
  workspaceId       String
  priority          TicketPriority
  // Null = no commitment on that leg (an org may promise a first response but
  // never a resolution time). Null is NOT zero — nothing is due, nothing breaches.
  firstResponseMins Int?
  resolutionMins    Int?
  // Time spent waiting on us-by-choice / on the customer doesn't count against
  // the promise. Defaults follow the industry norm: on_hold pauses, pending
  // does not (a customer being slow is still their ticket aging).
  pauseOnHold       Boolean        @default(true)
  pauseWhenPending  Boolean        @default(false)
  // Count only the workspace's configured working hours (Workspace.workHours).
  // Off by default — an org that hasn't set hours must not silently get a
  // clock that never advances.
  businessHoursOnly Boolean        @default(false)
  isActive          Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@unique([workspaceId, priority])
}

// Per-workspace custom fields on a ticket. A near-mirror of
// ContactFieldDefinition rather than a shared table: a contact field describes
// a PERSON and lives forever, a ticket field describes one piece of work — the
// two vocabularies diverge immediately ("company size" vs "root cause"), and
// merging them would put every contact field on every ticket form.
model TicketFieldDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  label       String
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, order])
}

// Sequential ticket numbers, one counter row per workspace.
//
// The row lock taken by `update({ next: { increment: 1 } })` serializes
// concurrent allocations — Postgres blocks the second writer until the first
// commits, so two simultaneous creates can never read the same value. The
// @@unique([workspaceId, number]) on Ticket is the backstop, and the create
// path retries on P2002.
model TicketNumberCounter {
  workspaceId String @id
  next        Int    @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// The cross-workspace escalation bridge: agent X in workspace A can't answer,
// so their ticket is REFERRED to a sibling workspace in the same organization.
// The escalation creates a twin ticket over there (own number, own board card,
// own assignee, that workspace's own SLA) carrying a contact SNAPSHOT — never a
// live join into A's directory — and this row links the pair. Everything the
// two sides share travels as MIRRORED TicketEvent rows (one per side, each
// workspace-scoped to its own ticket), so no read path ever crosses the
// boundary. Tickets themselves still never cross workspaces.
//
// TENANCY EXCEPTION: this is deliberately the only row in the schema that
// spans two workspaces, so it carries no single workspaceId. It must ONLY be
// reached through a workspace-scoped query on one of its two tickets (or its
// source/target workspace columns) — never by a bare id from request input.
// Allowlisted in scripts/check-prisma-fields.mjs.
// A ticket SHARE — the grant that lets a sibling workspace work the SAME
// ticket. A ticket is the way two departments talk about one customer's issue,
// so there is exactly ONE ticket row: one number, one status, one priority, one
// history. Escalating does not copy it; it hands a second workspace the key.
//
// (Superseded the twin-pair design of 2026-07-28 the same week: two rows kept
// in sync were two truths that could drift, two numbers to quote, and two
// histories to read. One row with an access grant is the simpler model — and
// it is what "one identity in the organization" actually means.)
//
// What the guest workspace may see is bounded by this row, NOT by the ticket:
// the `contactSnapshot` (a frozen profile, never a live join into the owner's
// directory) and `guestConversationId` (their OWN thread with the customer, if
// they started one). The owner's conversation and messages stay private.
//
// TENANCY EXCEPTION: deliberately the only table spanning two workspaces, so
// it carries no single workspaceId. It is READ only through
// `ticketAccessWhere()` (lib/tickets/access.ts) — the one place the
// "my workspace OR shared with my workspace" predicate exists. Never reach a
// share by bare id from request input. Allowlisted in
// scripts/check-prisma-fields.mjs.
model TicketShare {
  id             String @id @default(cuid())
  organizationId String

  // The ONE ticket. Cascade: the grant is meaningless without it.
  ticketId String
  // Denormalized from `Ticket.workspaceId` for the "everything we shared out"
  // read. The ticket is the authority; this cannot drift because a ticket never
  // changes workspace.
  ownerWorkspaceId String
  // The workspace being granted access — the department being asked.
  guestWorkspaceId String

  // The customer's profile AT SHARE TIME — name, phoneNumber, email,
  // identityChannel, customFields (shape: ContactSnapshot in @ccp/shared).
  // A snapshot, not a live join: the owner's directory stays private, and later
  // edits or deletes there must not mutate what the guest was handed.
  contactSnapshot Json

  // The GUEST's own conversation with this customer, once they start one
  // ("Message the customer" mints a contact + thread in THEIR workspace on
  // THEIR channel). Null until then. The owner's thread is never exposed here.
  guestConversationId String?

  // WHO in the guest workspace owns their side of the work.
  //
  // Per-share and NOT on the ticket, because the ticket's single
  // `assignedUserId` belongs to the OWNER's roster: with one column, Billing
  // assigning Sara silently cleared Support's Ali (and each side's assignee
  // picker rendered a blank for the other's person). Two departments working
  // one ticket each need their own owner — the status, priority, cause,
  // history and files stay shared; the person accountable does not.
  //
  // SetNull: a departure must not delete the grant. `lastAssignedUserId` keeps
  // continuity for the same reason the ticket's does.
  assignedUserId     String?
  lastAssignedUserId String?

  createdById String?
  createdAt   DateTime @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ownerWorkspace  Workspace     @relation("TicketSharesOut", fields: [ownerWorkspaceId], references: [id], onDelete: Cascade)
  guestWorkspace  Workspace     @relation("TicketSharesIn", fields: [guestWorkspaceId], references: [id], onDelete: Cascade)
  guestConversation Conversation? @relation("TicketShareGuestConversation", fields: [guestConversationId], references: [id], onDelete: SetNull)
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignedUser    User?         @relation("TicketShareAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  // One grant per (ticket, workspace) — re-escalating to the same department is
  // a no-op, not a second key. A ticket CAN be shared with several departments.
  @@unique([ticketId, guestWorkspaceId])
  // The guest board's query: every ticket shared INTO this workspace.
  @@index([guestWorkspaceId])
  @@index([ownerWorkspaceId])
  @@index([organizationId])
  @@index([createdById])
  @@index([guestConversationId])
  // The guest board's "assigned to me" — the same shape as Ticket's own
  // assignee index.
  @@index([guestWorkspaceId, assignedUserId])
  @@index([assignedUserId])
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------
//
// Multi-step DAG workflows built on a React Flow canvas. Admins design them
// at /workflows. Each workflow has:
//   - one trigger (when does this fire?)
//   - optional trigger-time conditions (does it actually fire for THIS event?)
//   - optional once-per-contact dedupe (welcome flows don't want to fire twice)
//   - a graph of steps with edges, including branch / wait / jump control flow
//
// Dispatch path: a domain event calls `dispatch(workspaceId, event, payload)` in
// lib/workflows/dispatcher.ts. The dispatcher loads published workflows for
// this team+trigger, evaluates `triggerConditions`, optionally checks the
// once-per-contact ledger (`WorkflowContactState`), and enqueues a BullMQ
// job per match. The worker runs the DAG one step at a time, persisting
// state on WorkflowRun after each step so `wait` can resume cleanly and
// failures are debuggable per step.
//
// Round 1 (pre-canvas) used flat single-action Automation rows; those were
// migrated to single-step Workflow rows in the 20260516180000_workflows
// migration. Removed entirely: `Automation`, `AutomationRun`, and their
// enums.

model Workflow {
  id                    String               @id @default(cuid())
  workspaceId           String
  name                  String
  // `published` is the single live/draft gate: the dispatcher (and manual /
  // webhook / trigger_workflow paths) run a workflow iff `published = true`.
  // `false` = draft (still editable, test-runnable from the canvas, never
  // fired by real triggers). The editor exposes one Draft↔Live control that
  // flips this bit. (A separate `enabled` kill switch existed pre-2026-05-22;
  // it was redundant once the UI collapsed to one control and was dropped.)
  published             Boolean              @default(false)
  trigger               WorkflowTriggerEvent
  // Trigger-specific config. Shape depends on trigger:
  //   incoming_webhook → { secret: string }  (HMAC for signature validation)
  //   manual_trigger   → { allowedRoles: ("admin"|"agent")[] }
  //   contact_tag_updated → { kind: "added" | "removed" | "any" }
  //   contact_field_updated → { fieldKey?: string }  (omit = any field)
  //   contact_lifecycle_updated → { toStageId?: string }  (omit = any stage)
  //   others → {}
  triggerConfig         Json                 @default("{}")
  // Same nested AND/OR group shape used by automations Round 1 — see
  // lib/workflows/conditions.ts.
  triggerConditions     Json                 @default("{\"op\":\"AND\",\"children\":[]}")
  triggerOncePerContact Boolean              @default(false)

  // DAG. Shape:
  //   {
  //     startNodeId: string,
  //     nodes: [{ id, type: WorkflowStepType, config: {...}, position?: {x,y} }],
  //     edges: [{ from, to, label?: "true" | "false" | string }],
  //   }
  // `position` is round-trip persistence for the canvas — runner ignores it.
  // Validated server-side in lib/workflows/graph.ts at write time.
  graph Json @default("{\"startNodeId\":\"\",\"nodes\":[],\"edges\":[]}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs            WorkflowRun[]
  contactStates   WorkflowContactState[]
  awaitingReplies WorkflowAwaitingReply[]

  @@unique([workspaceId, name])
  // Hot path: dispatcher loads `WHERE workspaceId=? AND trigger=? AND published=true`.
  @@index([workspaceId, trigger, published])
}

model WorkflowRun {
  id          String               @id @default(cuid())
  workflowId  String
  workspaceId String
  status      WorkflowRunStatus    @default(queued)
  trigger     WorkflowTriggerEvent

  // Redelivery dedupe (2026-07-27). The outbox is at-least-once: a crash
  // between claim and publish redelivers the row, and without this a second
  // WorkflowRun would re-execute every step — including a second BILLED
  // Meta send. Set to the outbox row id (+ discriminator) when the dispatch
  // came from the drainer; NULL on the synchronous publish path, which never
  // redelivers. The partial unique index (0_init hand-section) makes the
  // duplicate create a P2002 the dispatcher swallows as "already ran".
  eventKey String?

  // The contact this run is acting on. Nullable for triggers that aren't
  // contact-scoped (none today, but keeps the schema flexible if we add a
  // team-level "any time of day" cron trigger). Used by:
  //   - once-per-contact dedupe (combined with workflowId in WorkflowContactState)
  //   - Ask a Question step resume routing (Round 2c)
  contactId      String?
  // Soft reference (plain string, no FK) — survives conversation hard-delete
  // by design: a workflow run's audit trail must outlive a thread an agent
  // later deletes. The runs UI tolerates a 404 when following a dangled id.
  conversationId String?

  // Snapshot of the event payload at dispatch time. Used by branch/condition
  // evaluation throughout the run AND by the runs UI to show "why did this fire."
  eventPayload Json

  // Immutable snapshot of Workflow.graph taken at run-creation time. The runner
  // executes THIS, never the live Workflow.graph — so editing a workflow while a
  // run is paused (wait / ask_question) can't corrupt the in-flight run
  // (orphaned currentStepId, wrong branch). Nullable only for runs created before
  // this column existed; the runner falls back to the live graph for those (see
  // runner.ts). The `published` live/draft gate is still read live — only the
  // graph is pinned.
  graphSnapshot Json?

  // DAG state. `currentStepId` is the step that will run NEXT (queued state),
  // or the step that's PAUSED (waiting state), or NULL (completed/failed).
  currentStepId String?
  // For waiting state: when the resume job is scheduled to fire. Lets the UI
  // show "resumes in 1h" without consulting BullMQ.
  waitUntil     DateTime?
  // Jump-to-step uses this to cap loops. Hard ceiling enforced in runner.ts.
  jumpsUsed     Int       @default(0)

  // Per-step audit log. Append-only array of:
  //   { stepId, type, status, startedAt, finishedAt?, responseStatus?,
  //     responseBody?, errorMessage?, nextStepId? }
  // Bounded by the runner's ceilings (~600 entries / ~1.3MB worst case; deliberately not truncated — see runner.ts).
  stepLog Json @default("[]")

  // Inbound answer dropped here by the message-ingest hook when a contact
  // replies to an `ask_question` step. The ask_question step handler reads
  // and clears it on resume; null means "still awaiting / timed out."
  // Shape: { body: string, messageId: string, timestamp: string } | null
  pendingAnswer Json?

  // Per-step structured outputs from this run. Map of stepId → JSON object
  // produced by the step's run() (parsed from StepResult.body). Drives the
  // `$var.previousStep.X` + `$var.steps.<id>.X` tokens so downstream steps
  // can route on what an earlier step produced (e.g. HTTP response body
  // fields, ask_question answer + optionId, branch selection). Capped at
  // ~32KB per step in the runner; cheap as long as `body` payloads stay
  // small. Empty for runs that don't reference per-step outputs.
  stepOutputs Json @default("{}")

  attempts     Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  workflow      Workflow               @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  awaitingReply WorkflowAwaitingReply?

  @@index([workflowId, startedAt(sort: Desc)])
  @@index([workspaceId, startedAt(sort: Desc)])
  // Status-leading index for the worker's "find runs to resume" sweep
  // (round 3 fallback if a wait job goes missing).
  @@index([status, waitUntil])
}

// One row per `ask_question` step that's currently paused waiting for the
// contact's next inbound message. The message-ingest hook does
// `findFirst({ where: { workspaceId, contactId } })` on each inbound and, if it
// finds a match, drops the message body onto `WorkflowRun.pendingAnswer`,
// deletes this row, and enqueues an immediate resume for the run. The
// runner's timeout job re-fires the same step independently — whoever wins
// the race deletes this row; the loser is a no-op.
//
// Separate from WorkflowContactState (the trigger-once-per-contact ledger)
// because the semantics + cardinality differ: that table is one row per
// (workflow, contact) for life-of-deployment; this table is one row per
// in-flight question with a near-term expiresAt.
model WorkflowAwaitingReply {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  runId       String   @unique
  workflowId  String
  stepId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  workflow  Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Inbound-resume lookup: every inbound message hits this index to ask
  // "is anyone awaiting from this contact?"
  @@index([workspaceId, contactId])
  // contactId-leading index backs the Contact-cascade delete (GDPR hard-purge)
  // — the composite above is workspaceId-leading and can't serve a bare contactId.
  @@index([contactId])
  // Timeout sweeper fallback (round 3): find awaiting rows past expiresAt
  // in case the BullMQ delayed job got lost.
  @@index([expiresAt])
}

// Per-(workflow, contact) ledger row for `triggerOncePerContact`. Existence
// of the row means "this workflow has fired for this contact." Cheap to
// look up via the compound unique; cleared when the workflow is deleted via
// cascade.
model WorkflowContactState {
  id          String   @id @default(cuid())
  workflowId  String
  contactId   String
  workspaceId String
  firedAt     DateTime @default(now())

  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // workspaceId deliberately absent from this unique: the leading cuid FK
  // already implies exactly one workspace (Batch D, 2026-07-27).
  @@unique([workflowId, contactId])
  @@index([workspaceId])
  // The (workflowId, contactId) unique leads with workflowId, so a
  // contactId-only lookup (reconciling rows after a contact hard-purge)
  // couldn't use it. Btree on contactId for that scan.
  @@index([contactId])
}

// API key for the external (n8n-facing) endpoints under /api/external/v1.
// n8n authenticates with `Authorization: Bearer <key>`. We store SHA-256 of
// the plaintext only — `tokenPrefix` (first 8 chars) is shown in the UI so
// admins can tell two keys apart without exposing the secret.
//
// Plaintext is shown EXACTLY ONCE at creation time. Lost keys are rotated,
// not recovered.
model WorkspaceApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  createdById String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  /// Allow-listed capabilities for this key. `["*"]` = wildcard (every
  /// scope). Empty array = deny-by-default. See
  /// packages/shared/src/api-keys/scopes.ts for the canonical catalog.
  /// Backfilled to `["*"]` for pre-existing rows so partner integrations
  /// keep working — new keys ask for specific scopes from the settings UI.
  scopes      String[]  @default(["*"])

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  idempotencyKeys    ApiIdempotencyKey[]
  conversationEvents ConversationEvent[]

  @@index([workspaceId, revokedAt])
}

/// Stores `Idempotency-Key` headers from external /v1 POSTs so a partner's
/// retry after a 5xx (or n8n's default retry-on-timeout) doesn't double-send
/// to WhatsApp. Keyed by (team, apiKey, key) so two partners using the same
/// short key can't collide. `responseBody` is the JSON we returned the first
/// time — replayed verbatim on retry within the TTL so the partner sees the
/// same shape they'd see if their first call had completed.
///
/// 24h TTL is the canonical retry window for HTTP semantics (Stripe-style);
/// after that a "retry" is logically a NEW operation. Sweeper job at the end
/// of the file purges expired rows.
model ApiIdempotencyKey {
  id             String   @id @default(cuid())
  workspaceId    String
  apiKeyId       String
  key            String
  responseBody   Json
  responseStatus Int
  /// SHA-256 of the canonical request (route + sorted body) captured at claim
  /// time. On a completed-row replay we compare this against the incoming
  /// request: a mismatch means the same Idempotency-Key was reused for a
  /// DIFFERENT payload, which we reject (Stripe-style) instead of returning the
  /// prior response and silently dropping the new send. Nullable so legacy rows
  /// (and any caller that pre-dates this) skip the check.
  requestHash    String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  apiKey WorkspaceApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, apiKeyId, key])
  @@index([expiresAt])
}

/// Outbound webhook subscription. Partners create one of these per "I want
/// to know when X happens" — `eventTypes` is the allowlist of public event
/// names the subscriber wants. `secret` is envelope-encrypted (same helper
/// Meta credentials use) and signs each delivery with HMAC-SHA256 over the
/// raw body via the `X-CCP-Signature` header.
///
/// Plaintext secret is shown EXACTLY ONCE at creation; rotation is explicit.
/// Auto-disabled after a sustained run of failures so a dead URL doesn't
/// keep our queue busy forever.
model OutboundWebhook {
  id                  String    @id @default(cuid())
  workspaceId         String
  name                String
  url                 String
  /// HMAC-SHA256 signing secret. Stored as `enc:v1:<base64>` (envelope encryption).
  secret              String
  /// Allowlisted public event type names (e.g. ["message.received", "contact.updated"]).
  eventTypes          String[]
  enabled             Boolean   @default(true)
  /// Nullable since the /v1 parity build: an integration registering its own
  /// webhook through the external API has no human creator, and forcing one
  /// would mean inventing an author for an action no person took. Plain id, no
  /// relation — same audit-trail discipline as the rest of the schema.
  createdById         String?
  createdAt           DateTime  @default(now())
  /// Last successful delivery (2xx response) — surfaced in the UI as "Last delivered".
  lastDeliveredAt     DateTime?
  /// Last failure — last error message + when. Reset after a successful delivery.
  lastErrorAt         DateTime?
  lastErrorMessage    String?
  /// Rolling failure count for the auto-disable circuit breaker. Reset to 0 on
  /// every 2xx. When it crosses the threshold, `enabled` flips to false.
  consecutiveFailures Int       @default(0)
  /// Set when `enabled` flips to false from automatic action (circuit breaker
  /// vs. an explicit admin toggle). Together with `disabledReason` they're
  /// the audit trail the UI surfaces as "auto-disabled at … because …".
  /// Manual toggles via the settings UI clear both back to null.
  disabledAt          DateTime?
  disabledReason      String?

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries OutboundWebhookDelivery[]

  @@index([workspaceId, enabled])
}

/// One row per delivery attempt. Powers the "delivery log" UI so partners can
/// debug receiver-side failures without us needing to surface internal logs.
/// `responseBody` is truncated to ~4KB on insert (receivers sometimes echo
/// huge payloads). Nightly sweeper
/// (apps/api/src/lib/sweepers/outbound-webhook-delivery-cleanup.ts) drops
/// rows older than 30 days; override via WEBHOOK_DELIVERY_RETENTION_DAYS.
// TENANCY EXCEPTION — no workspaceId by design. Reach these rows ONLY
// through their workspace-carrying parent, resolved with a workspaceId-scoped
// query FIRST; never query by a bare child id taken from request input. The
// checker (scripts/check-prisma-fields.mjs) allowlists this model — adding a
// new tenant-less model without updating the allowlist fails CI.
model OutboundWebhookDelivery {
  id             String    @id @default(cuid())
  webhookId      String
  /// Redelivery dedupe (2026-07-27): outbox row id + webhook id when the
  /// delivery was created by the drainer, NULL on the sync publish path.
  /// `id` doubles as the partner's X-CCP-Delivery dedup header, so minting a
  /// fresh UUID on a redelivered event defeated dedupe on BOTH sides (ours
  /// and theirs). Partial unique in the 0_init hand-section.
  eventKey       String?
  eventType      String
  /// Public-shape payload the receiver was sent. Stored verbatim so a retry
  /// from the UI can re-POST the same JSON.
  payload        Json
  /// HTTP status code from the receiver. null when fetch itself failed (DNS,
  /// timeout, TLS) — `errorMessage` carries the reason in that case.
  responseStatus Int?
  responseBody   String?
  attemptCount   Int       @default(0)
  deliveredAt    DateTime?
  failedAt       DateTime?
  errorMessage   String?
  /// Request correlation id of the action that CAUSED this delivery (the HTTP
  /// request / webhook whose mutation published the source event), captured
  /// from the ALS scope at delivery-row creation. Echoed to the receiver as
  /// `X-CCP-Trace-Id` and shown in the delivery-log UI so an operator can join
  /// a partner-side failure back to the originating request in our logs.
  /// Nullable: events published outside an HTTP request (sweepers, the boot
  /// reconciler) have no correlation scope. F6 in
  /// tests/VERIFICATION-2026-07-29.md.
  correlationId  String?
  /// minor#8: cross-system loop-guard depth (inbound X-CCP-Depth) of the action
  /// that caused this delivery, captured at row creation. The worker stamps
  /// depth+1 on the outbound X-CCP-Depth header. Persisted (not just passed as a
  /// BullMQ job arg) so the orphan-delivery sweeper's re-enqueue preserves it
  /// instead of resetting the counter to 1 on recovered deliveries.
  chainDepth     Int       @default(0)
  createdAt      DateTime  @default(now())

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Inbox unread = team-wide ONLY
// ---------------------------------------------------------------------------
//
// There is exactly ONE unread tier for the inbox: Conversation.unreadCount
// (team-wide INT counter). Written by ingest (+1 per inbound), markRead (→0),
// markUnread (→1); read by the conversation-list badges, document.title total,
// outbound-webhook payloads, and the workflow envelope. Any member opening a
// thread zeroes it for EVERYONE — "read" means read for the whole team.
//
// There is deliberately NO per-agent inbox read state. A prior iteration
// added a `ConversationReadReceipt` table + an `unreadForMe` derived field,
// but no UI ever consumed it (the list item always rendered against
// unreadCount) — it was computed, shipped to the client, and dropped. Both
// the table and the field were removed. Do NOT re-introduce per-agent inbox
// unread without a real per-agent inbox UX to justify it. Workspace chat already
// has its own per-user receipts (TeamChannelReadReceipt) for the cases where
// personal read state genuinely matters.

// ---------------------------------------------------------------------------
// Conversation audit log
// ---------------------------------------------------------------------------
//
// Append-only timeline of state changes on a conversation. Powers the right-
// rail "history" panel (future) and answers the "who closed this 3 days ago"
// question that always comes up after pilot launch.
//
// Schema by `kind`:
//   assigned         — `before` = { assignedUserId: string | null }
//                      `after`  = { assignedUserId: string | null }
//   status_changed   — `before` = { status: ConversationStatus }
//                      `after`  = { status: ConversationStatus }
//   tag_added        — `after`  = { tagId: string, tagName: string }
//   tag_removed      — `before` = { tagId: string, tagName: string }
//   stage_changed    — `before` = { stageId: string | null, stageName: string | null }
//                      `after`  = { stageId: string | null, stageName: string | null }
//   note_added       — `after`  = { noteId: string, excerpt: string }
//   note_deleted     — `before` = { noteId: string }
//
// `userId` is the agent who performed the action. Nullable + SetNull so
// removing an agent doesn't take their audit trail with them (the UI
// renders "Removed user" for the actor label). For system actions (e.g.
// a webhook auto-assignment, an automation closing a thread), `userId` is
// null and the actor is "System."
model ConversationEvent {
  id             String                @id @default(cuid())
  conversationId String
  workspaceId    String
  /// Redelivery dedupe (2026-07-27): outbox row id + discriminator when the
  /// audit write came from the drainer, NULL on the sync publish path. The
  /// at-least-once lease would otherwise write a SECOND identical pill on a
  /// crash-window redelivery — the "messy timeline" class. Partial unique in
  /// the 0_init hand-section; P2002 is swallowed as "already recorded".
  eventKey       String?
  userId         String?
  /// Set when the mutation came from an external /v1 API call instead of a
  /// human session. Mutually exclusive with userId in practice — partner
  /// integrations have no human author. SetNull on key revoke so audit
  /// history survives key rotation.
  apiKeyId       String?
  /// Set when a WORKFLOW caused the mutation (assign / close / AI toggle) —
  /// neither a human session nor an API key. Lets the timeline render
  /// "by workflow «name»" instead of a bare "System". Plain column (no FK,
  /// matching the denormalized actor style here); a deleted workflow's rows
  /// simply render the generic automation label.
  workflowId     String?
  kind           ConversationEventKind
  before         Json?
  after          Json?
  at             DateTime              @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey       WorkspaceApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([conversationId, at(sort: Desc)])
  // Drives the retention sweeper's `WHERE at < cutoff` scan — the composite
  // index above leads with conversationId and can't serve an at-only filter.
  // See lib/sweepers/conversation-event-retention.ts (N2,
  // tests/VERIFICATION-2026-07-29.md).
  @@index([at])
  // FK index for the `user` relation's onDelete: SetNull — without it,
  // hard-deleting a teammate seq-scans this (large, append-only) audit table
  // to null their attribution. Migration 20260611130100.
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspace chat (internal channels)
// ---------------------------------------------------------------------------
//
// Slack-style group chat between agents on the same team. Distinct from
// customer-facing Conversation/Message because the surfaces don't overlap:
// - No provider, no externalId, no direction, no status, no rawPayload
// - Different read-receipt cadence and indexes
// - Different permission model (every team member is implicitly in every
//   channel for v0; per-channel membership is the future hook)
//
// Keeping the two graphs apart means a query against `Message` (the customer
// surface) cannot accidentally leak into team-chat results, and vice versa.
// Cost: some duplicated media columns. Worth it.

// What a TeamChannel row IS. `channel` = a named, joinable room. `dm` = a
// 1:1 direct message between two people (or one, for notes-to-self).
//
// DMs reuse this table rather than getting their own because a DM's
// confidentiality requirement is EXACTLY what a private channel already
// enforces (TeamChannelMember + requireChannelMembership + emitChannelScoped).
// A parallel model would duplicate the whole service, the team_channel.*
// event taxonomy, the fanout rules, the chan: room gate, the media proxy,
// threading, and search — for zero security benefit.
enum TeamChannelKind {
  channel
  dm
}

// Who may JOIN a channel. Orthogonal to `isDefault` (which means "landing
// channel, undeletable, implicit membership").
//   public  → any team member can browse it and join themselves
//   private → invite-only; invisible in the browser, 404s on direct URL
// DMs are always `private`.
//
// Note this governs JOIN, not READ-after-join: reading still requires a
// membership row via requireChannelMembership. Public channels are
// join-to-read, so that single security spine stays unbranched.
enum TeamChannelVisibility {
  public
  private
}

model TeamChannel {
  id                 String                @id @default(cuid())
  workspaceId        String
  // Lowercase slug, unique per team. Becomes the URL: /team/<slug>.
  // The default channel "general" is auto-created at team setup time and
  // protected — the DELETE and rename routes refuse to touch it.
  //
  // NULL for DMs: a DM has no name, it's rendered from the peer's identity.
  // Deliberately NULL rather than a synthetic "dm:<cuid>" — a synthetic name
  // would leak into WorkspaceSearchHit.channelName, the page <h1>, and the
  // sidebar filter, and would silently occupy the @@unique([workspaceId, name])
  // namespace. NULL forces every consumer to be surfaced by the type checker.
  name               String?
  description        String?
  // The first channel created with name="general" per team is the default.
  // Used to (a) redirect /team to the default channel, (b) protect from
  // deletion/rename. At-most-one-default-per-team is enforced in app code,
  // not by a partial unique (Prisma can't model those).
  isDefault          Boolean               @default(false)
  kind               TeamChannelKind       @default(channel)
  // Defaults to `private`: every channel that existed before this column was
  // created under invite-only semantics, so the default is what keeps the
  // migration honest. Only the default channel is flipped to public.
  visibility         TeamChannelVisibility @default(private)
  // Canonical participant key for a DM: the two user ids sorted and joined
  // with ":" (a self-DM is "u:u"). NULL for channels. This is what dedupes
  // "open a DM with Sara" to one row no matter who opens it or how often.
  //
  // ALWAYS derived server-side from the session user — never accepted from
  // the client, or a caller could claim someone else's DM.
  dmKey              String?
  // Nullable + SetNull — channels are team-shared and shouldn't be destroyed
  // when their creator leaves. The audit label degrades to "Removed user."
  createdById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  // Denormalized for cheap list rendering. Kept in sync by the message-send
  // route; reads never have to join through TeamChannelMessage to render the
  // sidebar. Best-effort consistency — a race that leaves these slightly
  // stale is fine; the next message corrects them.
  lastMessageAt      DateTime              @default(now())
  lastMessagePreview String                @default("")

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?                    @relation("CreatedChannels", fields: [createdById], references: [id], onDelete: SetNull)
  messages  TeamChannelMessage[]
  receipts  TeamChannelReadReceipt[]
  pins      TeamChannelPin[]
  members   TeamChannelMember[]

  // Postgres treats NULLs as distinct in a unique index, so unlimited DM
  // rows (name = NULL) coexist under this constraint unchanged.
  @@unique([workspaceId, name])
  // The DM dedup guarantee. Workspace-scoped rather than global to match the
  // tenant-isolation idiom used everywhere else — and it's free.
  @@unique([workspaceId, dmKey])
  @@index([workspaceId, lastMessageAt(sort: Desc)])
  @@index([workspaceId, kind, lastMessageAt(sort: Desc)])
}

// Per-channel membership. The default channel ("general") implicitly includes
// every team member — the service layer auto-inserts on team-join and refuses
// removals. Non-default channels are members-only: listChannelsForUser filters
// through this table, so a user only sees channels they're in.
//
// Cascade on both sides: deleting a channel or a user purges the rows; no
// orphan memberships. `addedById` is SetNull so removing an admin doesn't
// destroy attribution on the rows they added.
// TENANCY EXCEPTION — no workspaceId by design. Reach these rows ONLY
// through their workspace-carrying parent, resolved with a workspaceId-scoped
// query FIRST; never query by a bare child id taken from request input. The
// checker (scripts/check-prisma-fields.mjs) allowlists this model — adding a
// new tenant-less model without updating the allowlist fails CI.
model TeamChannelMember {
  channelId String
  userId    String
  addedAt   DateTime @default(now())
  addedById String?

  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation("ChannelMemberships", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?       @relation("AddedChannelMembers", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([channelId, userId])
  @@index([userId])
}

// One row per top-level channel message OR thread reply. The discriminator is
// `threadRootId`:
//   - NULL  → top-level channel message. Surfaces in the channel scroller.
//   - SET   → reply to a root message; appears in the thread side panel only.
//
// Slack-style: replies never appear in the main channel feed by default. A
// future "also send to channel" toggle would post a sibling top-level message
// instead of changing this row.
//
// Hover toolbar wires up author-only edits (PATCH within 24h), author-or-
// admin deletes, anyone-can-react, admin/manager pins. The route handlers
// own those checks; the model just stores the data.
model TeamChannelMessage {
  id           String  @id @default(cuid())
  channelId    String
  // Denormalized for cheap tenant guards. The channel obviously already
  // carries workspaceId, but every read site otherwise has to JOIN — and the
  // socket-emit path wants workspaceId without a lookup.
  workspaceId  String
  // Null when the original author was deactivated/removed. UI renders
  // "Removed user" — same pattern as InternalNote.authorUserId.
  authorUserId String?
  body         String

  // Client-generated idempotency key for the optimistic send. Persisted so a
  // retried POST (lost HTTP response on a flaky network, or the Retry button)
  // is deduped by the @@unique below instead of inserting a SECOND real message
  // visible to the whole channel. Null for legacy/system inserts; NULLs are
  // distinct in a Postgres unique index, so those rows never conflict.
  clientTempId String?

  // ---- Media columns: mirror Message.media* exactly ----
  // The agent attaches a file in the composer; we run it through the same
  // UploadThing pipeline as customer media and store the result here. No
  // background-download phase — there's no provider to fetch from.
  mediaKind       String?
  mediaKey        String?
  mediaUrl        String?
  mediaMimeType   String?
  mediaCaption    String?
  mediaFilename   String?
  mediaSizeBytes  Int?
  mediaDurationMs Int?

  // ---- Edit history ----
  // Null = never edited. Edit window is enforced at the PATCH route (24h);
  // edited messages render an "(edited)" label sourced from this column.
  // Edit history (prior bodies) is not stored — add TeamChannelMessageRevision
  // later if anyone asks.
  editedAt DateTime?

  // ---- Thread linkage ----
  // Null = top-level channel message (the "thread root"). When set, this row
  // is a reply living in the side panel for that root. We don't allow
  // sub-threads (no nesting): a reply's threadRootId always points at a
  // top-level message, never at another reply. The POST route enforces this.
  threadRootId String?

  // ---- Thread denormalization (lives on the ROOT row only) ----
  // Always null/0 on reply rows. The reply route increments threadReplyCount
  // and updates threadLastReplyAt on the parent in the same transaction as
  // the insert, so the channel feed can render "12 replies · 2m ago" without
  // a COUNT().
  threadReplyCount  Int       @default(0)
  threadLastReplyAt DateTime?

  createdAt DateTime @default(now())

  channel       TeamChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        User?                 @relation("AuthoredChannelMessages", fields: [authorUserId], references: [id], onDelete: SetNull)
  threadRoot    TeamChannelMessage?   @relation("ChannelThread", fields: [threadRootId], references: [id], onDelete: Cascade)
  threadReplies TeamChannelMessage[]  @relation("ChannelThread")
  mentions      TeamChannelMention[]
  reactions     TeamChannelReaction[]
  pin           TeamChannelPin?

  // Send idempotency: a retried POST reusing the same clientTempId is rejected
  // with P2002 instead of inserting a duplicate (see channels.service.ts
  // dedupCommittedSend). NULL clientTempId rows (legacy/system) are distinct in
  // Postgres so they never collide.
  // workspaceId deliberately absent from this unique: the leading cuid FK
  // already implies exactly one workspace (Batch D, 2026-07-27).
  @@unique([channelId, authorUserId, clientTempId], map: "TeamChannelMessage_send_idem_key")
  // Keyset on the main feed: WHERE channelId = ? AND threadRootId IS NULL
  // ORDER BY createdAt DESC, id DESC. The partial index for top-level rows
  // (`TeamChannelMessage_channel_toplevel_keyset_idx` in the init migration's
  // raw-SQL section) covers that read; Prisma can't model partial indexes.
  // The full (threadRootId, createdAt) index below covers the thread-panel
  // read: WHERE threadRootId = ? ORDER BY createdAt ASC.
  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([threadRootId, createdAt])
  @@index([workspaceId])
  // FK index for the `author` relation's onDelete: SetNull — without it,
  // hard-deleting a teammate seq-scans this (growing) chat table to null their
  // authored rows. Migration 20260611130100.
  @@index([authorUserId])
  // pg_trgm GIN for substring ILIKE on channel-message body.
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "TeamChannelMessage_body_trgm_idx")
}

// @user mention. One row per (message, mentionedUser) so the "show me my
// mentions" query is a single indexed lookup, not a JSONB scan. The mention
// is also encoded inline in the body as `@[Display Name](userId)` so plain-
// text previews keep working — these rows are the structured index, not the
// source of truth for the display string.
// TENANCY EXCEPTION — no workspaceId by design. Reach these rows ONLY
// through their workspace-carrying parent, resolved with a workspaceId-scoped
// query FIRST; never query by a bare child id taken from request input. The
// checker (scripts/check-prisma-fields.mjs) allowlists this model — adding a
// new tenant-less model without updating the allowlist fails CI.
model TeamChannelMention {
  id              String @id @default(cuid())
  messageId       String
  mentionedUserId String

  message       TeamChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User               @relation("ChannelMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, mentionedUserId])
  @@index([mentionedUserId])
}

// Emoji reaction on a channel message. `emoji` is the raw Unicode codepoint
// (e.g. "👍"), NOT a shortcode — simpler render path, no shortcode→unicode
// map to maintain. Each user can apply each emoji at most once per message.
// TENANCY EXCEPTION — no workspaceId by design. Reach these rows ONLY
// through their workspace-carrying parent, resolved with a workspaceId-scoped
// query FIRST; never query by a bare child id taken from request input. The
// checker (scripts/check-prisma-fields.mjs) allowlists this model — adding a
// new tenant-less model without updating the allowlist fails CI.
model TeamChannelReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message TeamChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User               @relation("ChannelReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  // FK index for the `user` relation's onDelete: Cascade — a CASCADE still
  // scans this child table on parent (user) delete, so it benefits from the
  // index just like a SetNull does. Migration 20260611130100.
  @@index([userId])
}

// Pinned message bar. Separate table (not a boolean on the message) so we
// retain who pinned, when. A message can be pinned at most once per channel;
// pin permission is admin/manager — enforced at the route, not by the model.
// TENANCY EXCEPTION — no workspaceId by design. Reach these rows ONLY
// through their workspace-carrying parent, resolved with a workspaceId-scoped
// query FIRST; never query by a bare child id taken from request input. The
// checker (scripts/check-prisma-fields.mjs) allowlists this model — adding a
// new tenant-less model without updating the allowlist fails CI.
model TeamChannelPin {
  id         String   @id @default(cuid())
  channelId  String
  messageId  String   @unique
  // SetNull — keep the pin even when the pinner leaves the team.
  pinnedById String?
  pinnedAt   DateTime @default(now())

  channel  TeamChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message  TeamChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User?              @relation("PinnedMessages", fields: [pinnedById], references: [id], onDelete: SetNull)

  @@index([channelId, pinnedAt(sort: Desc)])
}

// Per-(user, channel) read state. `lastReadAt` vs `channel.lastMessageAt`
// yields "unread for me" without a per-message receipt row. Mention-with-
// unread is a JOIN against TeamChannelMention. Workspace chat is the ONLY surface
// with per-user read state — the customer inbox is team-wide (see the
// "Inbox unread = team-wide ONLY" note above Conversation's audit log).
// TENANCY EXCEPTION — no workspaceId by design. Reach these rows ONLY
// through their workspace-carrying parent, resolved with a workspaceId-scoped
// query FIRST; never query by a bare child id taken from request input. The
// checker (scripts/check-prisma-fields.mjs) allowlists this model — adding a
// new tenant-less model without updating the allowlist fails CI.
model TeamChannelReadReceipt {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// Persistent login-attempt counters. Replaces the in-process Map in
// apps/web/src/lib/rate-limit.ts so brute-force history survives process
// restarts (deploys, OOM, systemd Restart=on-failure). Keyed by lowercased
// email — login attempts happen before we know the team, so this lives at
// the platform layer, not team-scoped.
//
// Lifecycle: incremented on failed login, cleared (deleted) on success.
// `lockedUntil` is set when failedCount crosses the threshold; the gate
// reads `lockedUntil > now()` to refuse without consulting the counter,
// so a successful guess after lockout doesn't quietly let the attacker in.
model LoginAttempt {
  email        String    @id
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  lastFailedAt DateTime  @default(now())

  @@index([lockedUntil])
}

// ---------------------------------------------------------------------------
// Transactional outbox
// ---------------------------------------------------------------------------
//
// Closes the DB-commit → bus.publish window. Two flow patterns:
//
//   1. publish(event)            — fire-and-forget. Writes a row here AND
//      runs in-process subscribers immediately. The row is the durable
//      audit trail; subscribers ran already, so a process crash mid-publish
//      leaves a row marked `publishedAt = null AND failedAt IS NOT NULL`
//      (or `lastError IS NOT NULL`) that the operator can investigate.
//
//   2. publishInTx(tx, event)    — durable. Caller writes this row INSIDE
//      their own $transaction so the outbox INSERT commits atomically with
//      the entity write. The drainer (apps/api/src/events/outbox-drainer.service.ts)
//      polls every poll-interval ms, picks oldest pending rows, marks them
//      `publishedAt` BEFORE dispatching subscribers (at-most-once), and
//      records `lastError` if dispatch throws. Subscribers see the event
//      only AFTER the originating tx commits.
//
// At-most-once on purpose: re-dispatching events would double-fire audit
// rows, duplicate workflow runs, and resend outbound webhooks. The trade-
// off is "lost dispatch on crash is detectable; duplicates are not allowed."
// To go at-least-once, every non-idempotent subscriber would need to track
// `(dispatch_id, side_effect_id)` — deferred.
//
// Retention: WIRED — the outbound-event-retention sweeper (see
// apps/api/src/lib/sweepers/outbound-event-retention.ts, scheduled by the
// workflow worker service) DELETEs published rows past its retention window
// daily, under the shared sweeper mutex. (This comment previously claimed the
// sweep was "not wired yet"; it has been wired since the retention-index
// migration.)
model OutboundEvent {
  id          String @id @default(cuid())
  workspaceId String

  // Domain-event type — e.g. "contact.updated", "conversation.assigned".
  // Stored as a plain string (not enum) so adding a new event type is a
  // code-only change; the table stays stable.
  type    String
  // The full DomainEvent envelope minus the `type` field. Subscribers
  // reconstruct the typed event by combining `type` + `payload`.
  payload Json

  createdAt    DateTime  @default(now())
  // Set when the drainer (or the synchronous publish path) finished running
  // this row's subscribers — success, OR a terminal per-subscriber error (see
  // `failedAt`); either way the row is DONE and never redelivered. Null =
  // pending or claimed-in-flight. (Until 2026-07-27 this was stamped BEFORE
  // dispatch — at-most-once — so a hard crash mid-dispatch silently lost the
  // fan-out. It now closes the bracket `claimedAt` opens.)
  publishedAt  DateTime?
  // Lease stamp (at-least-once, 2026-07-27): set when the drainer CLAIMS the
  // row, before dispatch. A crash between claim and publish leaves
  // publishedAt NULL, and the row is redelivered once the lease
  // (OUTBOX_CLAIM_LEASE_MS, 10 min) expires — the crash-window redelivery §9
  // promises. Consumers tolerate the resulting duplicates (that has always
  // been the §9 contract); steady-state never redelivers because publishedAt
  // lands within the lease.
  claimedAt    DateTime?
  // Set when dispatch threw, or when redelivery was exhausted
  // (`attempts` ceiling → lastError "redelivery_exhausted"). The row is NOT
  // retried — the operator queries failed rows and decides what to do
  // (manual re-publish, drop, or fix the subscriber + bulk re-publish).
  failedAt     DateTime?
  // Truncated error message from the throwing subscriber. NULL when the
  // dispatch succeeded.
  lastError    String?
  // Claim counter. 1 on the steady-state happy path; >1 only after a
  // crash-window redelivery. Capped (see claimBatch) so a poison row can't
  // loop forever — at the ceiling it is marked failed instead.
  attempts     Int       @default(0)
  // Stamped AFTER the drainer finished dispatching ALL subscribers for this
  // row — same moment as publishedAt on the success path (kept as its own
  // column because the retention sweeper's EVT-2 rule and existing forensic
  // queries key on it). A row with claimedAt set + publishedAt NULL is
  // in-flight (or awaiting redelivery after a crash); it is NEVER silently
  // lost anymore.
  dispatchedAt DateTime?

  // Cross-system loop counter (X-CCP-Depth) + correlation id captured at PUBLISH
  // time, while still inside the originating request's ALS scope. The drainer
  // dispatches this row later (outside that scope) and restores them so an
  // outbound webhook fired for this event carries the correct depth instead of
  // resetting to 1 — defeating the loop guard (EVT-1). Default 0 = a publish
  // with no inbound chain depth (the common case).
  chainDepth    Int     @default(0)
  correlationId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Drainer hot-path is served by the partial index
  // `OutboundEvent_drainer_pending_idx` (WHERE publishedAt IS NULL AND
  // failedAt IS NULL, raw SQL — partial indexes aren't expressible in the
  // Prisma DSL, see the init migration).
  // No team-id-keyed index here on purpose: the drainer never filters by
  // workspaceId, and that index was a non-trivial write tax on every publish.
}

// ---------------------------------------------------------------------------
// WhatsApp Business Calling
// ---------------------------------------------------------------------------
//
// Voice/video calls placed or received on a conversation. Calls are an
// independent first-class object, not Message rows — they have their own
// lifecycle (ringing → answered → ended), their own dedup (Meta's call id,
// distinct from wamid), and a different audit shape (no body, no media). They
// DO live on a Conversation (1:1 with the contact) and render inline in the
// thread timeline alongside messages, but they don't fragment the message
// stream.
//
// Schema rules:
//   - Compound unique `(workspaceId, channel, externalCallId)` mirrors Message
//     dedupe — Meta retries calls webhooks the same way it retries messages,
//     and the P2002 catch + Serializable wrapper are the same idempotency
//     pattern.
//   - Channel column even though there's only one calling channel today —
//     consistency invariant with Message, and the multi-channel seam already
//     anticipates non-WhatsApp call events.
//   - Calls bump `Conversation.lastMessageAt` (monotonic `lt` guard) on real
//     call activity so a missed/incoming call SURFACES the thread for triage —
//     they DO reorder the inbox list (see ingest-call.ts). They do NOT touch
//     `lastMessagePreview`, so the list row still shows the last real message
//     text, not a synthetic "call" line.
//   - `missed` vs `rejected` is intentional. Workflow trigger differentiation.
model Call {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String
  // Meta's call id — half of the dedup key. Same shape as Message.externalId.
  externalCallId String
  // Calling channel. Hard-coded `whatsapp` today; mirrors Message.channel
  // for future-channel parity. Pre-existing rule: channel on the row is the
  // dedup key half, conversation.channel is the ownership truth.
  channel        Channel       @default(whatsapp)
  direction      CallDirection
  status         CallStatus    @default(ringing)

  // Agent who PLACED an outbound call. Set at create time from the session.
  // Null for inbound calls (the customer initiated) and for the rare webhook-
  // races-the-create path (the webhook has no user context — backfilled on the
  // place-call P2002 retry). Surfaces "who called the customer" in the thread.
  initiatedByUserId String?

  // CAS-set when an agent successfully answers. Null until then (also null
  // for missed / rejected with no answer). One call = at most one answering
  // agent (Meta enforces this at the call-object level).
  answeredByUserId String?

  // Origin attribution for user-initiated calls, echoed by the provider's
  // connect/terminate webhooks: the opaque `payload` from a call BUTTON we
  // sent (`cta_payload`) or the `biz_payload` from a wa.me/call deep link
  // (`deeplink_payload`). Null for outbound calls and calls placed from the
  // plain call icon. This is what ties an inbound call back to the campaign
  // or surface that produced it.
  ctaPayload      String?
  deeplinkPayload String?

  // Call recording (opt-in per call via the workspace's recording policy).
  // The provider's `call_recording_available` webhook lands ~1min after the
  // call ends with a media id whose file expires after 7 DAYS — so the bytes
  // are downloaded to R2 immediately (recordingKey) and the media id is kept
  // (recordingMediaId) so the recording sweeper can re-attempt a transient
  // download failure inside that window. mediaId set + key null = pending.
  recordingMediaId  String?
  recordingKey      String?
  recordingMimeType String?

  // Call transcription (opt-in per call, independent of recording). Same
  // 7-day provider retention + download-to-R2 lifecycle as the recording
  // columns above; the artifact is a JSON document (segments + word timings).
  // transcriptLanguage is the AUTO-DETECTED spoken language (ISO 639, e.g.
  // "ar") from the transcript body — denormalized for list display/filtering.
  transcriptMediaId  String?
  transcriptKey      String?
  transcriptLanguage String?

  // WHY a failed call failed, from the terminate webhook's errors[] — the only
  // place Meta says (troubleshooting doc: 138019-138023, e.g. "Media receive
  // timeout", "Relay connection failed"). Mirrors Message.statusErrorCode/
  // Title; full error_data stays in rawPayload. Null for non-failed calls.
  errorCode  Int?
  errorTitle String?

  ringingAt       DateTime
  answeredAt      DateTime?
  endedAt         DateTime?
  // Computed at terminal transition: endedAt - answeredAt. Null when the
  // call never reached `in_progress` (missed / rejected / failed-pre-answer).
  durationSeconds Int?

  // Verbatim Meta call object (mirrors Message.rawPayload). Kept for
  // forensics + debugging — call signaling is complex and the raw payload
  // is the only ground truth when something goes sideways.
  rawPayload Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiatedBy  User?        @relation("InitiatedCalls", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  answeredBy   User?        @relation("AnsweredCalls", fields: [answeredByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, channel, externalCallId])
  // Thread-timeline read path: GET /api/conversations/:id/calls.
  @@index([conversationId, ringingAt(sort: Desc)])
  // FK index for the initiatedBy relation's onDelete: SetNull (mirrors the
  // Message.senderUserId index rationale — avoids a seq-scan on user delete).
  @@index([initiatedByUserId])
  // Same for the answeredBy relation (onDelete: SetNull). The 20260602130000
  // migration that added initiatedBy cited "mirrors answeredByUserId" but only
  // indexed initiatedBy — this closes the gap. Migration 20260611130100.
  @@index([answeredByUserId])
  // "Currently ringing" + "calls today" queues: filter by (workspaceId, status)
  // ordered by recency. Also serves the 5-calls-per-24h pre-flight gauntlet.
  @@index([workspaceId, status, ringingAt(sort: Desc)])
  @@index([workspaceId])
}

// One row per outbound calling-permission request to a contact. Meta caps
// these at 1/24h and 2/7d, with 72h validity once granted. We track the
// state locally so:
//   - the inbox can show "Permission requested — waiting on customer" UI
//   - the placeCall pre-flight skips re-requesting when permission is live
//   - rateLimitedUntil mirrors a Meta 4xx so we don't keep banging on the
//     endpoint
model CallPermissionRequest {
  id                String               @id @default(cuid())
  workspaceId       String
  contactId         String
  // The id of the request MESSAGE we sent (permission requests are ordinary
  // interactive messages, not a calling endpoint). The customer's reply webhook
  // echoes this back as its context, which is how a grant is matched to the
  // exact request that produced it. Null when we still have an in-flight error
  // or rate-limit placeholder on file.
  externalRequestId String?
  // Grant lifecycle. `pending` the instant we send the request; flips to
  // `granted`/`denied` when Meta's permission webhook lands. The placeCall
  // pre-flight only treats a `granted` (+ unexpired) row as live — sending a
  // request is NOT itself a grant. A rate-limited error row is left `pending`
  // (it never reached the customer); rateLimitedUntil is the discriminator.
  status            CallPermissionStatus @default(pending)
  requestedAt       DateTime             @default(now())
  // While `pending`: the REQUEST's own validity (it lapses 7 days after
  // delivery if the customer never answers). Once `granted`: the provider's
  // own grant expiry, taken verbatim from the permission webhook — never
  // recomputed locally, because no webhook is sent when a temporary permission
  // lapses, so a guessed duration silently throws away days of a live grant.
  // Ignored entirely when `isPermanent`.
  //
  // This is a CACHE, not the gate. Permission can also be granted in ways that
  // touch no row here at all (automatically when the customer calls us, or from
  // the business profile), so the authoritative pre-flight reads the provider.
  expiresAt         DateTime
  // True when the customer granted ONGOING permission rather than a bounded
  // window. A permanent grant has no expiry — modelled as a flag rather than a
  // far-future `expiresAt` so the UI can say "always allowed" instead of
  // rendering a countdown to the next century.
  isPermanent       Boolean              @default(false)
  // Stamped when the provider's grant webhook lands (the real grant time).
  grantedAt         DateTime?
  // Set when Meta returned 1/24h or 2/7d; cleared on next successful request.
  rateLimitedUntil  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactId, requestedAt(sort: Desc)])
  // contactId-leading index backs the Contact-cascade delete (GDPR hard-purge)
  // — the composite above is workspaceId-leading and can't serve a bare contactId.
  @@index([contactId])
}

// ===========================================================================
// Native AI Assistant subsystem
// ---------------------------------------------------------------------------
// A first-party, in-app AI auto-responder. DELIBERATELY SEPARATE from the
// legacy n8n "autopilot" (Workspace.aiAutopilotEnabled / AiHandoffAction /
// FirstTouchGreeter / Conversation.aiEnabled). Nothing here shares state with
// that system. The two are kept from ever answering the same inbound message
// by the atomic ConversationAutomationClaim below — a unique
// (workspaceId, inboundMessageId) row that exactly one owner can insert.
//
// FK discipline: every table cascades from Workspace (tenant hard-delete). Other
// references (conversationId / messageId / customerId) are PLAIN string columns
// with their own index — matching CustomerIdentityEvent.contactId — so this
// subsystem can be dropped without altering Conversation/Message/Customer.
// The one exception is AiContextChunk -> AiContextDocument, which cascades so
// deleting a knowledge file removes its chunks (correction #13).
// ===========================================================================

enum AiAutoReplyMode {
  auto_send // send automatically (pause on human takeover)
  draft // produce a persisted suggestion; a human sends it
  hybrid // auto_send outside opening hours, draft during
}

enum AiLanguagePolicy {
  match_customer // reply in the customer's detected language/script
  default_language // always reply in AiAssistantConfig.defaultLanguage
  specific // always reply in AiAssistantConfig.specificLanguage
}

enum AiReplyChannelMode {
  text
  voice
  match_customer // voice if the customer sent voice, else text
  text_and_voice // send both
}

enum AiContextDocStatus {
  processing
  ready
  failed
  disabled // uploaded but excluded from retrieval by an admin
}

// Per-conversation native-AI state machine (correction #2). A human reply
// CANCELS the pending AI turn and moves the conversation to human_active, but
// does NOT permanently pause: the next CUSTOMER inbound auto-resumes to
// ai_active. ai_paused is the EXPLICIT agent pause (sticky until resumed —
// EXCEPT a closed->reopened conversation, which force-resumes to ai_active;
// see conversation-state.ts `resumeOnReopen`).
//
// `disabled` is RETAINED here for backward compat with historic rows only —
// agents can no longer set it (removed 2026-07: the product now only exposes
// pause/resume, not a separate full-disable). The migration that removed the
// action also converts any pre-existing `disabled` rows to `ai_paused`, so no
// live conversation is ever stuck in this state; it is otherwise dead.
enum AiConvAutomationState {
  ai_active
  human_active
  ai_paused
  disabled
}

// Which automation system owns (answers) a given inbound message. The claim
// row is the atomic arbiter — the unique index makes the first INSERT win.
enum AiAutomationOwner {
  native_ai
  autopilot
  workflow
}

enum AiMemoryKind {
  preferred_language
  dialect
  script
  tone
  communication_style
  interest
  recurring_need
  preference
}

enum AiMemoryStatus {
  candidate // extracted, below the auto-confirm bar; needs confidence/review
  confirmed // surfaced in the panel + fed back into prompts
  rejected // an agent dismissed it; never resurfaced
  // Replaced by a newer value of the same SINGLETON kind (e.g. preferred_language
  // English -> French). Kept for history/provenance; hidden from the panel and
  // never fed back into prompts. Only singleton kinds are superseded this way.
  superseded
}

enum AiMemorySource {
  system // extracted by the model
  agent // hand-entered/edited by a human
}

enum AiInteractionDecision {
  replied // auto-sent an outbound
  suggested // wrote a draft suggestion (draft/hybrid mode)
  skipped // eligibility failed before generation
  escalated // model flagged human handoff
  cancelled // eligibility failed on the pre-send recheck (e.g. human replied)
  failed // generation/send error
}

enum AiSuggestionState {
  pending
  accepted // sent as-is
  edited // sent after an agent edit
  rejected
  expired
  superseded // replaced by a newer Regenerate attempt (kept for history)
}

enum AiTranscriptionStatus {
  pending
  ready
  failed
}

// One row per team — the whole AI Assistant configuration surface (the 7
// settings tabs). `configVersion` is bumped on every save, stamped onto every
// AiAssistantInteraction (audit traceability) and used as the CAS token on the
// settings PUT. `enabled` is the master switch, SEPARATE from
// Workspace.aiAutopilotEnabled.
model AiAssistantConfig {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(false)
  configVersion Int       @default(1)

  // --- Company Identity ---
  companyName      String?
  shortDescription String?
  fullDescription  String? @db.Text
  industry         String?
  website          String?
  phone            String?
  locations        Json    @default("[]")
  serviceAreas     Json    @default("[]")

  // --- Business Details ---
  products               String? @db.Text
  services               String? @db.Text
  pricingNotes           String? @db.Text
  paymentMethods         String? @db.Text
  deliveryPolicy         String? @db.Text
  returnPolicy           String? @db.Text
  bookingRules           String? @db.Text
  faqs                   Json    @default("[]")
  restrictions           String? @db.Text
  escalationInstructions String? @db.Text

  // --- Opening Hours ---
  timezone           String  @default("Asia/Beirut")
  weeklySchedule     Json    @default("{}")
  holidays           Json    @default("[]")
  scheduleExceptions Json    @default("[]")
  afterHoursBehavior String? @db.Text

  // --- Languages & Dialect ---
  supportedLanguages Json             @default("[\"ar\", \"en\"]")
  defaultLanguage    String           @default("ar")
  languagePolicy     AiLanguagePolicy @default(match_customer)
  specificLanguage   String?
  lebaneseDialect    Boolean          @default(true)
  lebaneseStyle      String?          @db.Text
  allowArabizi       Boolean          @default(true)
  scriptPolicy       String           @default("match_customer") // arabic | latin | match_customer
  codeSwitching      Boolean          @default(true)
  emojiPolicy        String           @default("sparing") // none | sparing | expressive

  // --- Tone & Reply Behavior ---
  tone                  String          @default("friendly")
  matchCustomerTone     Boolean         @default(true)
  replyLength           String          @default("balanced") // short | balanced | detailed
  customInstructions    String?         @db.Text
  autoReplyMode         AiAutoReplyMode @default(auto_send)
  // Below this model-reported confidence the assistant DRAFTS instead of
  // auto-sending, even in auto_send mode (correction: confidence threshold).
  confidenceThreshold   Float           @default(0.55)
  // 0 = unlimited. Otherwise the assistant stops auto-replying on a thread
  // after N consecutive AI turns without a human, to bound runaway loops.
  maxAutoRepliesPerConv Int             @default(0)
  humanTakeoverBehavior String          @default("cancel_and_yield")
  // Seconds to WAIT after a customer's last message before replying, so a
  // burst of chunked messages gets ONE considered answer. The timer resets on
  // each new inbound. 0 = reply immediately (no debounce).
  replyWaitSeconds      Int             @default(0)

  // --- Voice ---
  incomingTranscription Boolean            @default(true)
  saveTranscript        Boolean            @default(true)
  replyChannelMode      AiReplyChannelMode @default(text)
  // A TESTED, configured ElevenLabs voice id. No Lebanese-accent quality is
  // guaranteed by the system — the admin selects/tests a voice (correction #12).
  voiceId               String?
  voiceLanguage         String             @default("ar")
  voiceSpeed            Float              @default(1.0)
  maxVoiceDurationSec   Int                @default(60)
  voiceTextFallback     Boolean            @default(true)

  // Logical tier key -> resolved to an env-configured Anthropic model id at
  // call time (never a hardcoded display name in code; correction #11).
  replyModelTier String @default("reply")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An uploaded knowledge file. Bytes live in R2 under a private, team-prefixed
// key; text is extracted (bounded, encrypted-PDF rejected) into AiContextChunk
// rows for retrieval. Deleting a row cleans up R2 + chunks (correction #13).
model AiContextDocument {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  sizeBytes   Int
  r2Key       String
  status      AiContextDocStatus @default(processing)
  enabled     Boolean            @default(true)
  error       String?            @db.Text
  chunkCount  Int                @default(0)
  tokenCount  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  processedAt DateTime?

  chunks AiContextChunk[]

  @@index([workspaceId, createdAt(sort: Desc)])
}

// A retrievable slice of a knowledge document. Retrieval uses a Postgres
// full-text keyword search (a GIN index on to_tsvector('simple', content) is
// added in raw SQL in the migration; pgvector can replace it later without a
// model change). Only the top tenant-filtered chunks are injected per prompt —
// never every document's full text (correction #8).
model AiContextChunk {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId  String
  document    AiContextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal     Int
  content     String            @db.Text
  tokenCount  Int               @default(0)
  createdAt   DateTime          @default(now())

  @@index([workspaceId])
  @@index([documentId, ordinal])
}

// Per-conversation native-AI state (correction #2). Default row is created
// lazily on first eligibility check as ai_active when the team config is on.
model AiConversationState {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId String                @unique
  state          AiConvAutomationState @default(ai_active)
  // Who/when for an explicit pause (state = ai_paused). Plain user id, no FK.
  pausedByUserId String?
  pausedAt       DateTime?
  stateChangedAt DateTime              @default(now())
  // Consecutive AI auto-replies since the last human/customer break — enforces
  // AiAssistantConfig.maxAutoRepliesPerConv.
  autoReplyCount Int                   @default(0)
  updatedAt      DateTime              @updatedAt

  @@index([workspaceId])
}

// Atomic mutual-exclusion arbiter (correction #3). Exactly one owner may claim
// a given inbound message. The unique (workspaceId, inboundMessageId) makes the
// first INSERT win; every other automation system's insert hits P2002 and must
// not answer. Native AI inserts owner = native_ai; a future autopilot/workflow
// integration inserts its own owner. This is the ONLY cross-system coupling and
// it is write-based, not a read-only guard.
model ConversationAutomationClaim {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId   String
  inboundMessageId String
  owner            AiAutomationOwner
  claimedAt        DateTime          @default(now())

  @@unique([workspaceId, inboundMessageId])
  @@index([workspaceId, conversationId])
}

// Session-level rollup (correction #6). A session is open until the
// conversation closes OR 12h of inactivity. `sessionEndAt` null = the current
// open session (the one the "Latest Session Summary" panel reads). Summaries
// update INCREMENTALLY: lastSummarizedMessageId marks progress, summaryVersion
// bumps each pass. Temporary order/complaint details live HERE, not in
// permanent customer memory (correction #7).
model ConversationSessionSummary {
  id                      String    @id @default(cuid())
  workspaceId             String
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId          String
  sessionStartAt          DateTime
  sessionEndAt            DateTime?
  lastSummarizedMessageId String?
  summaryVersion          Int       @default(0)
  // Structured session fields for the panel.
  customerGoal            String?   @db.Text
  importantContext        String?   @db.Text
  questions               Json      @default("[]")
  answers                 Json      @default("[]")
  commitments             Json      @default("[]") // company commitments/promises
  openQuestions           Json      @default("[]")
  requiredFollowUp        String?   @db.Text
  sentiment               String?
  language                String?
  tone                    String?
  latestStatus            String?   @db.Text
  // A 1-2 sentence brief of the WHOLE conversation/relationship (across all
  // sessions), distinct from the current-session fields above.
  overallBrief            String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([workspaceId, conversationId, sessionStartAt(sort: Desc)])
}

// Permanent, PERSON-level memory (correction #1 + #7). Structured candidates,
// each with confidence + provenance (source conversation/message), editable and
// deletable. Confirmed items feed the panel + future prompts. NOT stored on
// Customer/Message.
model AiCustomerMemory {
  id                   String         @id @default(cuid())
  workspaceId          String
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId           String
  kind                 AiMemoryKind
  // VarChar(500) (not Text) so the dedup unique below is a safe btree key.
  value                String         @db.VarChar(500)
  confidence           Float          @default(0)
  status               AiMemoryStatus @default(candidate)
  source               AiMemorySource @default(system)
  sourceConversationId String?
  sourceMessageId      String?
  createdByUserId      String? // set when source = agent
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // DB-level dedup of a person's memory items. NOTE: this is
  // (workspaceId, customerId, kind, value) — NOT unique(workspaceId, customerId), which
  // would force one row per customer and contradicts the approved
  // structured-candidates design (multiple kind/value items per person).
  @@unique([workspaceId, customerId, kind, value])
  @@index([workspaceId, customerId, status])
  @@index([workspaceId, customerId, kind])
}

// Per-message AI metadata, kept OFF the Message row (correction #1). The
// aiGenerated flag is the loop guard: the assistant never answers a message
// that carries an aiGenerated=true metadata row (correction #15, last case).
model AiMessageMetadata {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageId          String    @unique
  aiGenerated        Boolean   @default(false)
  model              String?
  language           String?
  dialect            String?
  script             String?
  intent             String?
  confidence         Float?
  // Model self-reported risk (0..1) that this reply contains a claim not
  // grounded in the company info / retrieved knowledge (see REPLY_SCHEMA).
  // Null for replies generated before this field existed. A conversation's
  // hallucination rate is the average across its scored AI messages (see
  // lib/ai/hallucination.ts); messages at/above HALLUCINATION_FLAG_THRESHOLD
  // are surfaced to the agent for review via `ai.message_flagged`.
  hallucinationRisk  Float?
  hallucinationNotes String?   @db.Text
  createdAt          DateTime  @default(now())

  @@index([workspaceId])
}

// Inbound-voice transcription, kept OFF the Message row (correction #1 + #5).
model AiMessageTranscription {
  id                String                @id @default(cuid())
  workspaceId       String
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageId         String                @unique
  status            AiTranscriptionStatus @default(pending)
  transcript        String?               @db.Text
  language          String?
  provider          String?
  durationMs        Int?
  // Agent correction of the machine transcript (correction: allow correction).
  correctedText     String?               @db.Text
  correctedByUserId String?
  error             String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([workspaceId])
}

// Durable per-attempt audit (correction #9). One row per assistant run —
// what it decided and why, for observability + debugging + cost tracking.
model AiAssistantInteraction {
  id                String                @id @default(cuid())
  workspaceId       String
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId    String
  inboundMessageId  String
  outboundMessageId String?
  suggestionId      String?
  configVersion     Int
  model             String?
  language          String?
  dialect           String?
  intent            String?
  confidence        Float?
  decision          AiInteractionDecision
  skipReason        String?
  selectedChunkIds  Json                  @default("[]")
  inputTokens       Int?
  outputTokens      Int?
  cacheReadTokens   Int?
  latencyMs         Int?
  error             String?               @db.Text
  createdAt         DateTime              @default(now())

  @@index([workspaceId, conversationId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// Durable draft (correction #10). Survives refresh/reconnect because it lives
// in Postgres, not client state. One per inbound; regenerate updates in place.
model AiReplySuggestion {
  id               String             @id @default(cuid())
  workspaceId      String
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId   String
  inboundMessageId String
  text             String             @db.Text
  replyLanguage    String?
  replyScript      String?
  channelMode      AiReplyChannelMode @default(text)
  // Set when a voice draft was pre-rendered; R2 key of the preview audio.
  audioR2Key       String?
  usedChunkIds     Json               @default("[]")
  state            AiSuggestionState  @default(pending)
  // Regenerate version (correction: deterministic attempt/version number). The
  // first draft is attempt 1; each Regenerate supersedes the current pending
  // draft and creates attempt+1, preserving prior attempts as history rows.
  attempt          Int                @default(1)
  editedText       String?            @db.Text
  decidedByUserId  String?
  decidedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // NO full @@unique([workspaceId, inboundMessageId]) — Regenerate keeps superseded
  // history rows. "Only one UNRESOLVED (pending) suggestion per inbound" is
  // enforced by a PARTIAL unique index (WHERE state = 'pending') added in raw
  // SQL in the migration (Prisma can't express partial uniques).
  @@index([workspaceId, inboundMessageId, attempt])
  @@index([workspaceId, conversationId, state])
}

// ---------------------------------------------------------------------------
// Assignment routing (2026-07-21)
// ---------------------------------------------------------------------------
//
// Who gets a conversation, and by what rule. Before this, "who" was one
// hardcoded algorithm (least-busy round-robin, `lib/conversations/round-robin.ts`)
// shared by the AI handoff and the workflow `assign_to` step. Admins running
// real support floors need to shape that: weight a senior agent 50 vs a junior
// 20, cap how many open chats anyone carries, route VIP tags to a different
// pool, and pre-assign a campaign's replies.
//
// The model is deliberately three small tables, not one JSON blob:
//   AssignmentPolicy        — a named strategy ("Support — weighted")
//   AssignmentPolicyMember  — per-member weight + capacity inside that policy
//   AssignmentRule          — first-match-wins routing INTO a policy
//   AssignmentSettings      — the per-team switchboard (when auto-assign fires)
//
// Every team gets a seeded `isDefault` policy whose settings reproduce the old
// round-robin EXACTLY, so turning this on changes nothing until an admin edits
// it. See apps/api/src/lib/assignment/README.md.

// How a policy picks among its eligible, under-capacity candidates.
enum AssignmentStrategy {
  // Strict turn-taking: the next eligible member after the rotation cursor,
  // REGARDLESS of how loaded they are. Predictable ("everyone gets one in
  // turn") — pick this when fairness of count matters more than balance.
  round_robin
  // Fewest currently-open conversations wins; ties broken by the rotation
  // cursor so equal-load teams still spread evenly. This is the historical
  // behavior and the default — it self-balances when chats have uneven length.
  least_busy
  // Proportional share by `AssignmentPolicyMember.weight` — a member with
  // weight 50 receives ~5x the volume of one with weight 10. Implemented as
  // deficit-based selection (lowest served/weight ratio wins), so the split is
  // exact over time rather than probabilistic.
  weighted
  // Always `fixedUserId` (a triage lead / a single owner).
  fixed
  // Never auto-assigns. Use to disable routing for a slice of traffic while
  // keeping the rest automated.
  manual
}

// Which members are considered candidates at pick time.
enum AssignmentEligibility {
  // Tiered (historical): online+available → available → any active member.
  // Never lands nowhere as long as ONE member exists.
  online_first
  // Only agents with a live socket AND availability "available". May yield
  // nobody (→ overflow rule) — correct for teams that want strict presence.
  online_only
  // DB availability only, ignore sockets (correct for a standalone worker).
  available_only
  // Any active member, ignore presence and availability entirely.
  any_active
}

// What happens when no candidate has capacity (or none is eligible at all).
enum AssignmentOverflow {
  // Land in the Unassigned triage queue. Safe default — visible, never lost.
  leave_unassigned
  // Ignore the caps and assign to the least-loaded candidate anyway. For teams
  // that would rather overload someone than leave a customer unowned.
  ignore_capacity
  // Assign to `AssignmentPolicy.fallbackUserId` (a supervisor).
  fallback_user
}

model AssignmentPolicy {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?

  // Exactly one policy per team carries isDefault — the fallback when no rule
  // matches, and what a caller that names no policy gets. Enforced by a partial
  // unique index (WHERE "isDefault") added in raw SQL in the migration.
  isDefault Boolean @default(false)

  // Default = least_busy: it reproduces the historical hardcoded behavior
  // exactly (fewest open conversations, rotation as the tie-break).
  strategy    AssignmentStrategy    @default(least_busy)
  eligibility AssignmentEligibility @default(online_first)

  // Role filter — empty = every role is eligible. Lets an admin route only to
  // `agent`s and keep managers out of the rotation.
  eligibleRoles Role[] @default([])

  // Membership. `includeAllMembers` (default) means the policy pool is every
  // active team member and `members` rows are OPTIONAL per-member overrides
  // (weight / cap / opt-out). When false, ONLY members with an enabled row are
  // candidates — an explicit squad.
  includeAllMembers Boolean @default(true)

  // Capacity. Per-member cap defaults to this when the member row leaves
  // `maxOpen` null. Null = uncapped.
  defaultMaxOpen Int?

  overflow       AssignmentOverflow @default(leave_unassigned)
  // Target for overflow = fallback_user. Plain id (no FK) so removing that user
  // degrades to leave_unassigned instead of cascading into the policy.
  fallbackUserId String?
  // Target for strategy = fixed. Same no-FK reasoning.
  fixedUserId    String?

  // Rotation cursor (last user picked) — PER POLICY, so two policies rotate
  // independently. Replaces the single team-wide Workspace.aiRoundRobinCursorUserId.
  cursorUserId String?

  // CONTINUITY. When a returning customer already has a history with someone,
  // send them back to that person instead of starting over with a stranger —
  // the single biggest quality difference between a support floor that feels
  // like a team and one that feels like a lottery.
  //
  // It is a PREFERENCE, not an override: the previous agent still has to be
  // eligible (active, in this policy, right role, present per `eligibility`)
  // and under their capacity limit. If they're offline or full, routing falls
  // straight through to the normal strategy — a customer waiting for someone
  // who has gone home is worse than a fresh agent who is here now.
  //
  // Defaults ON because it is what customers expect and what every mature
  // product does; it can only ever fire for a contact who HAS a history, so a
  // new org is unaffected.
  preferPreviousAgent     Boolean @default(true)
  // How long a relationship stays "warm". Past this, the previous agent is
  // treated as cold and the normal strategy decides — a 6-month-old thread
  // shouldn't pin a customer to someone who has since changed teams.
  previousAgentWindowDays Int     @default(30)

  // Optimistic-concurrency token for the settings UI (same pattern as
  // AiAssistantConfig.configVersion): a save carrying a stale version is
  // rejected rather than clobbering a co-admin's edit.
  version Int @default(1)

  // Soft delete — a policy referenced by historical broadcasts/rules is
  // archived, never destroyed, so audit trails keep resolving its name.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   AssignmentPolicyMember[]
  /// Tickets currently owned by this team — the queue side of a handoff.
  /// See `Ticket.assignedTeamId`.
  tickets   Ticket[]                 @relation("TeamTickets")
  rules     AssignmentRule[]

  @@index([workspaceId, archivedAt])
  @@index([workspaceId, isDefault])
}

model AssignmentPolicyMember {
  id          String @id @default(cuid())
  workspaceId String
  policyId    String
  userId      String

  // Relative share for strategy = weighted. 0 = never picked (a clean way to
  // pause someone without deleting their row/history). Ignored by the other
  // strategies, which use `enabled` + capacity only.
  weight Int @default(1)

  // Per-member concurrent-open cap; null falls back to policy.defaultMaxOpen.
  maxOpen Int?

  // Opt a member out without losing their weight/cap configuration.
  enabled Boolean @default(true)

  // Deficit counter for weighted selection: how many conversations this policy
  // has routed to this member. The picker compares `served / weight` ratios —
  // never renormalized: ratios are scale-free and Int4 headroom is ample; the
  // real hazard (a late joiner at 0 vacuuming traffic) is handled at write
  // time by seeding newcomers at the pool's current ratio (syncMembers).
  served Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy AssignmentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User             @relation("AssignmentPolicyMemberships", fields: [userId], references: [id], onDelete: Cascade)

  // workspaceId deliberately absent from this unique: the leading cuid FK
  // already implies exactly one workspace (Batch D, 2026-07-27).
  @@unique([policyId, userId])
  @@index([workspaceId])
}

model AssignmentRule {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  policyId    String

  // First match wins; ascending. Ties broken by id for determinism.
  position Int     @default(0)
  enabled  Boolean @default(true)

  // Match conditions — ALL present clauses must match (AND); within a clause,
  // ANY value matches (OR). Absent/empty clause = "don't care". Shape mirrors
  // `AssignmentRuleConditions` in packages/shared/src/assignment/types.ts:
  //   { channels?: Channel[]; channelAccountIds?: string[]; tagIds?: string[];
  //     stageIds?: string[];
  //     sources?: ("inbound"|"ai_handoff"|"broadcast"|"workflow"|"api")[];
  //     keywords?: string[]; languages?: string[]; isNewContact?: boolean }
  // `channelAccountIds` is finer than `channels` — it names specific
  // ChannelConnection ids, so "chats on the Sales number" routes separately
  // from "chats on WhatsApp". Fails closed: an unbound thread matches none.
  // JSON (not columns) because the clause set is expected to grow and each
  // clause is a pure list — there is no query that filters ON a clause.
  conditions Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policy    AssignmentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled, position])
}

model AssignmentSettings {
  // One row per team, id == workspaceId (same shape as a settings singleton).
  workspaceId String @id

  // Route a BRAND-NEW conversation the moment its first inbound lands.
  autoAssignOnNewConversation Boolean @default(false)

  // Skip that routing while the built-in AI is going to handle the thread —
  // the conversation only gets a human when the AI escalates. This is the
  // "AI first, human when needed" posture; turn it off to give every new chat
  // a human owner immediately even while the AI answers.
  skipWhenAiHandling Boolean @default(true)

  // Route an EXISTING unassigned conversation when a new customer message
  // arrives (covers reopened/closed threads and ones a human unassigned).
  autoAssignOnReopen Boolean @default(false)

  // Move work off an agent who goes offline. `reassignOfflineAfterMinutes` is
  // the grace period (a browser refresh must not trigger a stampede) and
  // `reassignOfflineOnlyPending` limits it to threads with no agent reply yet,
  // so an in-flight conversation isn't yanked mid-sentence.
  reassignOnOffline           Boolean @default(false)
  reassignOfflineAfterMinutes Int     @default(15)
  reassignOfflineOnlyPending  Boolean @default(true)

  // Reassign an agent's open conversations when they're DEACTIVATED. Separate
  // from the offline sweep: deactivation is permanent, so this defaults ON.
  reassignOnDeactivate Boolean @default(true)

  // Which policy the built-in AI uses when it escalates to a human. Null = the
  // team's default policy. Plain id (no FK) — a deleted policy degrades to the
  // default rather than breaking the handoff.
  aiHandoffPolicyId String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// How a broadcast pre-assigns the conversations it touches. Resolved ONCE per
// recipient at materialize time (stored on BroadcastRecipient.assignedUserId),
// never at send time — so an exact "50 to Ali, 10 to Sara" split is guaranteed
// and a resumed/retried run can't double-count.
enum BroadcastAssignmentMode {
  // Don't touch assignment (today's behavior).
  none
  // Every recipient to one member.
  fixed
  // Literal counts per member: first 50 → Ali, next 10 → Sara, remainder per
  // `assignmentOverflow`.
  split_counts
  // Proportional split of the WHOLE audience by weight, distributed with the
  // largest-remainder method so the totals add up exactly.
  split_percent
  // Run each recipient through an AssignmentPolicy (respects capacity,
  // presence and weights at materialize time).
  policy
}
