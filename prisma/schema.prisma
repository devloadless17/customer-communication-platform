// Schema for the WhatsApp Multi-Agent Shared Inbox.
//
// Mirrors lib/types.ts exactly so the UI and the DB stay in lockstep.
// Multi-tenancy is baked in: every domain row carries teamId.

generator client {
  provider        = "prisma-client-js"
  // `postgresqlExtensions` lets us declare the pg_trgm GIN indexes + the
  // JSONB jsonb_path_ops index that the search-heavy contact / conversation /
  // team-chat queries depend on. Without these declarations `prisma migrate
  // dev` treats the hand-written indexes as drift and silently generates a
  // migration that DROPS them. The partial trgm indexes on Contact.email /
  // Contact.phoneNumber and the expression index on Contact.customFields
  // stay hand-written — Prisma's DSL can't model partial or expression
  // indexes — but those don't trigger the drift detector.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  // `plpgsql` is the default extension every Postgres install ships with; it
  // must be listed once `extensions = [...]` is non-empty so the introspector
  // doesn't flag it as drift.
  extensions = [pg_trgm, plpgsql]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  // Platform-level. One per deployment for now (set via seed).
  superAdmin
  // Per-team owner: full team management.
  admin
  // Conversation-level lead: same conversation powers as agent, plus
  // read-only visibility into /settings/team. No user management.
  manager
  agent
}

// Subscription tier per team. Scaffolding only — every team is set to
// `starter` today and no features are gated yet. The feature → plan matrix
// will be wired in packages/shared/src/auth/plans.ts when ready. UI is
// intentionally hidden until that matrix exists.
enum Plan {
  free
  starter
  advanced
  enterprise
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  in
  out
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

// The messaging CHANNEL (the medium a conversation lives on). This is the
// single "where is this conversation from" discriminator — there is NO separate
// "provider/vendor" concept in the data model (a Meta-vs-Twilio distinction is
// an implementation detail of the MessagingProvider impl, not stored). Adding a
// channel = a new value here + a registered MessagingProvider + a
// ChannelConnection row. Meta Cloud serves both `whatsapp` and (future)
// `instagram` — they are DISTINCT channels even though one API delivers them.
enum Channel {
  whatsapp
}

// Mirrors Meta's template review states. We cache every status so admins can
// see "pending" rows and understand why a template they just submitted isn't
// sendable yet — only `approved` rows are actually allowed through to send.
enum TemplateStatus {
  approved
  pending
  rejected
  paused
  disabled
}

enum TemplateCategory {
  marketing
  utility
  authentication
}

// Lifecycle of a template broadcast.
//   queued    — created but the runner hasn't started yet (rare; created+started
//               are usually back-to-back inside the same POST).
//   running   — runner is iterating recipients.
//   completed — runner finished. `failedCount > 0` is possible (per-recipient
//               failures don't fail the whole job).
//   failed    — runner errored fatally (e.g. config disappeared mid-flight).
//   paused    — process was draining gracefully (deploy, restart) and stopped
//               the runner mid-flight. Boot reconciler auto-resumes by
//               flipping back to `queued` and calling startBroadcast(); the
//               CAS `queued→running` claim then takes over. Recipients
//               already `sent` stay `sent`; remaining `queued` rows get
//               picked up where the old runner left off.
enum BroadcastStatus {
  queued
  running
  completed
  failed
  // Operator-initiated stop while queued or running. Recipients already
  // sent stay sent; remaining queued rows are skipped by the runner on
  // its next status check. Distinct from `failed` so the UI can show
  // "you canceled this" instead of "this broke."
  canceled
  paused
}

enum BroadcastRecipientStatus {
  queued
  sent
  failed
}

// Why a contact exists in our DB.
//   - inbound: created by a webhook ingest (a customer messaged us).
//   - manual: created by an agent — through the New Contact dialog or a CSV
//             import. Used to differentiate "people who reached out" vs
//             "people we added on our end" in the contacts list.
enum ContactSource {
  inbound
  manual
}

// What a ConversationEvent row records. The audit timeline reads these to
// show "Agent X assigned the conversation to Y at 10:14" etc. Adding a new
// value here is half the work — the write site (assign/status/tags route)
// needs to call recordConversationEvent with the matching `before`/`after`
// shape, documented per-kind in lib/inbox/events.ts.
enum ConversationEventKind {
  assigned
  status_changed
  tag_added
  tag_removed
  note_added
  note_deleted
}

// Domain events workflows can subscribe to. Adding a new value is half the
// work — the dispatcher (lib/workflows/dispatcher.ts) needs the matching
// call site, and lib/workflows/conditions.ts needs to know which fields
// the payload carries for trigger-time filtering.
enum WorkflowTriggerEvent {
  // Inbox events
  message_received
  conversation_created
  conversation_opened
  conversation_closed
  conversation_assigned
  conversation_status_changed
  // Contact events
  contact_field_updated
  contact_tag_updated
  contact_lifecycle_updated
  // External / on-demand triggers
  manual_trigger
  incoming_webhook
}

// What a workflow step does when it runs. Steps are registered in
// lib/workflows/steps/index.ts — adding a value without a registered
// handler causes the runner to mark the step as failed. Control-flow
// steps (branch / wait / jump_to_step) are special-cased in the runner;
// everything else is a plain "do the thing, advance to next."
enum WorkflowStepType {
  // Messaging
  send_message
  send_template
  add_comment
  // Conversation state
  assign_to
  set_status
  open_conversation
  close_conversation
  // Contact mutations
  add_tag
  remove_tag
  update_field
  update_lifecycle
  // Control flow
  branch
  wait
  jump_to_step
  noop
  ask_question
  // External
  http_request
  trigger_workflow
}

// Lifecycle of a single workflow execution.
//   queued     — enqueued in BullMQ, not yet picked up by a worker
//   running    — worker is currently executing a step
//   waiting    — paused at a `wait` step (resume job scheduled)
//   completed  — reached a terminal step or end-of-graph
//   failed     — exhausted retries on a non-recoverable step error
//   skipped    — workflow was disabled / deleted between dispatch and run,
//                or conditions later flipped
enum WorkflowRunStatus {
  queued
  running
  waiting
  completed
  failed
  skipped
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Subscription tier. Default `starter` for every team — feature gating
  // is not wired up yet. See packages/shared/src/auth/plans.ts. UI hidden.
  plan      Plan     @default(starter)

  // Per-team channel credentials moved OFF this model into `ChannelConnection`
  // (one row per provider, keyed by (teamId, provider)) so adding a channel is
  // a new row, not a new column-set. CLAUDE.md rule #6. The old `meta*` columns
  // were dropped in migration 20260521..._drop_team_meta_columns; the encrypted
  // secrets relocated verbatim into `ChannelConnection.secrets`.

  // Contact panel built-in field visibility. JSON map of built-in field key →
  // boolean. Missing key = visible (preserves backwards compat: existing teams
  // see all built-ins until an admin explicitly hides one). Phone is never
  // hideable — it's the WhatsApp identity and always renders. Custom fields
  // have their own per-row `isVisible` on ContactFieldDefinition.
  //
  // Supported keys: "email" | "location" | "firstContacted". Adding more
  // built-ins later (firstName / lastName / language / countryCode) just
  // means adding the key and rendering — no schema bump.
  contactPanelBuiltins   Json    @default("{}")

  users                   User[]
  contacts                Contact[]
  conversations           Conversation[]
  messages                Message[]
  invites                 Invite[]
  contactFieldDefinitions ContactFieldDefinition[]
  contactStages           ContactStage[]
  messageTemplates        MessageTemplate[]
  broadcasts              Broadcast[]
  tags                    Tag[]
  audienceGroups          AudienceGroup[]
  workflows               Workflow[]
  workflowRuns            WorkflowRun[]
  workflowContactStates   WorkflowContactState[]
  workflowAwaitingReplies WorkflowAwaitingReply[]
  apiKeys                 TeamApiKey[]
  outboundWebhooks        OutboundWebhook[]
  snippets                Snippet[]
  conversationEvents      ConversationEvent[]
  internalNotes           InternalNote[]
  teamChannels            TeamChannel[]
  teamChannelMessages     TeamChannelMessage[]
  outboundEvents          OutboundEvent[]
  outboundSendAttempts    OutboundSendAttempt[]
  channelConnections      ChannelConnection[]
}

// Per-(team, channel) connection: credentials + settings for one provider.
// Replaces the flat `Team.meta*` columns so adding a channel = insert a row,
// not add a column-set. `config` holds non-secret values (phone number id,
// waba id, app id, verify token, display number); `secrets` holds the
// envelope-encrypted ciphertext per field (access token, app secret) — same
// crypto boundary as before, just relocated. One row per channel per team.
model ChannelConnection {
  id        String       @id @default(cuid())
  teamId    String
  channel   Channel
  config    Json         @default("{}")
  secrets   Json         @default("{}")
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, channel])
}

model User {
  id            String    @id @default(cuid())
  teamId        String
  role          Role      @default(agent)
  name          String
  email         String    @unique
  // Better Auth requires this column. Default true: existing users were
  // verified via the invite flow; new sign-ups get true on creation since
  // we don't run an email-confirmation step yet.
  emailVerified Boolean   @default(true)
  // Mapped to Better Auth's `image` field via lib/auth/better-auth.ts so the
  // column name stays domain-meaningful while Better Auth sees the standard
  // field name in session payloads.
  avatarUrl     String?
  // Soft-disable: keeps FK history intact (authored messages, assignments).
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team                    Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authoredMsgs            Message[]                 @relation("AuthoredMessages")
  authoredNotes           InternalNote[]
  assignedConvos          Conversation[]            @relation("AssignedConversations")
  createdInvites          Invite[]                  @relation("InvitedBy")
  createdBroadcasts       Broadcast[]               @relation("CreatedBroadcasts")
  createdAudienceGroups   AudienceGroup[]           @relation("CreatedAudienceGroups")
  createdSnippets         Snippet[]                 @relation("CreatedSnippets")
  // Audit-log authorship. Nullable on the event row + SetNull so deleting a
  // user keeps the audit trail; the timeline just renders "Removed user".
  authoredEvents          ConversationEvent[]
  // Team-chat (internal messaging between agents). All SetNull on user delete
  // so deactivating a teammate leaves their messages, reactions, pins, and
  // mentions in place with a "Removed user" actor label — same audit-trail
  // discipline as customer conversations.
  createdChannels         TeamChannel[]             @relation("CreatedChannels")
  authoredChannelMessages TeamChannelMessage[]      @relation("AuthoredChannelMessages")
  channelReactions        TeamChannelReaction[]     @relation("ChannelReactions")
  channelMentions         TeamChannelMention[]      @relation("ChannelMentions")
  pinnedChannelMessages   TeamChannelPin[]          @relation("PinnedMessages")
  channelReadReceipts     TeamChannelReadReceipt[]
  channelMemberships      TeamChannelMember[]       @relation("ChannelMemberships")
  addedChannelMembers     TeamChannelMember[]       @relation("AddedChannelMembers")
  sessions                Session[]
  accounts                Account[]

  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Better Auth tables. Names + columns match the framework's expected schema
// (see @better-auth/core/db/get-tables.ts). DO NOT rename columns without
// also configuring the matching `fields` map in lib/auth/better-auth.ts —
// the adapter reads/writes by these exact names.
// ---------------------------------------------------------------------------

// One row per active sign-in. Cookie holds `token`; everything else is
// looked up server-side. Deleting a row signs the user out from that device.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Credential / OAuth account record. For our email+password users the row
// has providerId="credential", accountId=email, and password=<bcrypt hash>.
// OAuth providers (future) populate access/refresh/idToken instead.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived tokens for email verification, password reset, etc. Not used
// by our current invite flow (that's the separate Invite model) but Better
// Auth requires the table to exist for any verification-style endpoints.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Saved canned response. Agents trigger one in the reply box by typing
// `/<name>` — the picker filters by prefix, then the chosen snippet's body
// replaces the trigger text with `$var.contact.*` tokens already resolved
// against the active conversation's contact.
//
// Team-wide for v1: anyone can create / use / edit. Per-user (private)
// snippets are a later add-on; we'd add a nullable `ownerUserId` field then.
model Snippet {
  id          String   @id @default(cuid())
  teamId      String
  // Lowercase, digits, underscores. Becomes the slash trigger:
  //   name = "welcome_new_user" → `/welcome_new_user` in the reply box.
  // Unique per-team so two snippets can't fight for the same trigger.
  name        String
  // Friendly title shown in the picker ("Welcome new customer"). Searchable.
  label       String
  // The text inserted into the reply. May contain `$var.contact.<field>`
  // tokens which the picker resolves at insertion time against the active
  // conversation's contact.
  body        String
  // Nullable + SetNull so deleting a teammate preserves the snippet they
  // authored (just shows "Removed user" in the UI). Cascading would delete
  // team-wide snippets just because their creator left, which is destroying
  // shared content.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CreatedSnippets", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([teamId, name])
  @@index([teamId, label])
}

model Contact {
  id                String        @id @default(cuid())
  teamId            String
  // Nullable so non-phone channels (Instagram, Telegram) can land contacts
  // without a phone number. WhatsApp contacts always populate it; the
  // existing webhook + manual-create + CSV-import paths still set it
  // explicitly. The compound unique below stays valid since Postgres treats
  // multiple NULLs as distinct.
  phoneNumber       String?
  // Multi-channel identity. Used when phoneNumber isn't the natural key
  // (Instagram scoped-user-id, Telegram chat-id). For WhatsApp these are
  // null and phoneNumber is the identity. The compound unique below allows
  // future Instagram/Telegram ingest to dedupe contacts by their native id.
  identityChannel   Channel?
  externalContactId String?
  // Canonical display name. Derived from `firstName + lastName` when both
  // are populated; otherwise whatever the create path stored (inbound
  // webhook profile name, manual UI, /v1 POST). Source of truth for inbox
  // rendering — first/last are split-offs maintained alongside on writes.
  name              String
  // First/last names split from `name` at migration time. Webhook payloads
  // expose these as `first_name`/`last_name` for respond.io/n8n parity.
  // Updating `name` via PATCH does NOT auto-resplit (avoids clobbering an
  // agent's manual edit); updating `firstName`/`lastName` recomputes `name`.
  firstName         String?
  lastName          String?
  // BCP-47 tag (e.g. "ar", "en"). Drives WhatsApp template language selection.
  language          String?
  // ISO 3166-1 alpha-2 (e.g. "LB"). Derived from `phoneNumber` via libphonenumber
  // at inbound time. Optional — non-WhatsApp / unparseable numbers leave null.
  countryCode       String?
  avatarUrl         String?
  // Optional profile fields surfaced in the right-rail contact panel.
  email             String?
  location          String?
  // Bag of contact-level custom field values, keyed by field key.
  // - Keys defined in ContactFieldDefinition are the team-wide schema (always
  //   shown on every contact, even when blank).
  // - Keys NOT in the team schema are per-contact extras (one-offs added on
  //   a single contact). Both kinds are string-valued for now.
  customFields      Json          @default("{}")
  // Customer-lifecycle stage. Per-team configurable list (managed in
  // /settings/stages). Defaulted to the team's `isDefault` stage at create
  // time — see ensureDefaultStage in lib/queries.ts. SetNull on delete so
  // removing a stage doesn't take its contacts with it; the bulk-move flow
  // in /api/team/stages/[id] DELETE empties this manually first.
  stageId           String?
  // How this row got into the DB. Defaulted to inbound because the webhook
  // ingest path uses the bare default; the manual create + CSV import paths
  // explicitly set 'manual'.
  source            ContactSource @default(inbound)
  createdAt         DateTime      @default(now())
  // Denormalized "most recent inbound message timestamp" for this contact.
  // Maintained on every inbound-message commit (see lib/providers/ingest.ts).
  // Used by:
  //   - getConversationWithRefs to render the 24h window chip without
  //     scanning the contact's full message history
  //   - the contacts-list "by-recency" sort
  // Nullable because contacts created via /contacts/new (manual or CSV)
  // have no inbound yet.
  lastInboundAt     DateTime?
  // Optimistic concurrency token. Every Contact write CAS-bumps this from
  // the value it just read; concurrent writers on the same row race to the
  // bump and exactly one wins, the other gets P2025 → 409 Conflict. Without
  // this, two simultaneous PATCHes editing different fields (or a workflow
  // step running while an agent is mid-edit) would do read-modify-write
  // races where one set of changes is silently lost. The conflict-park UI
  // in contact-panel surfaces 409s as a "teammate just edited this" banner
  // so the agent can choose to reload or overwrite.
  version           Int           @default(0)
  // Soft-delete tombstone. Deleting a contact is NON-destructive: the row + its
  // conversations/messages are PRESERVED (a contact delete must NOT take the
  // conversation with it). Set = hidden from the contacts DIRECTORY (list /
  // search / count / audience targeting / forward) but the conversation stays
  // in the inbox and by-id lookups still resolve. Cleared (re-activated) by the
  // ingest upsert when a tombstoned contact messages again. A true hard purge
  // (GDPR) is a separate explicit action that cascades.
  deletedAt         DateTime?

  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stage               ContactStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  conversations       Conversation[]
  broadcastRecipients BroadcastRecipient[]
  workflowAwaitingReplies WorkflowAwaitingReply[]
  // Many-to-many: an agent tags a contact with one or more labels for
  // segmentation. Implicit join table — Prisma manages the link rows.
  // Tags live on Contact (NOT Conversation): one contact = one conversation
  // in this app's invariant (closed threads reopen rather than fragment),
  // so per-thread tagging would be dead complexity. See the
  // 20260516160000_revert_conversation_tags migration for the history of
  // why this lives here and not on Conversation.
  tags                Tag[]
  // M2M with saved audience groups via manual membership. Dynamic membership
  // (by tag) doesn't materialize here — it's resolved at send time.
  audienceGroups      AudienceGroup[]      @relation("AudienceGroupContacts")

  // A phone number is unique within a team, but the same number can exist across tenants.
  @@unique([teamId, phoneNumber])
  // Compound identity for non-phone channels. Only enforced when both fields
  // are set — Postgres treats NULL as distinct in unique constraints, so
  // WhatsApp-only contacts (both nulls) coexist freely.
  @@unique([teamId, identityChannel, externalContactId])
  @@index([teamId])
  @@index([teamId, source])
  @@index([teamId, stageId])
  // Directory reads filter `deletedAt IS NULL`; index it so the common
  // "active contacts" scan stays cheap as tombstones accumulate.
  @@index([teamId, deletedAt])
  // "Contacts by recency of last inbound" — inbox-sidebar surfaces.
  @@index([teamId, lastInboundAt(sort: Desc)], map: "Contact_teamId_lastInboundAt_idx")
  // pg_trgm GIN index for substring ILIKE search on contact name.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm_idx")
  // NOTE: the JSONB GIN index `Contact_customFields_gin_idx` (USING GIN
  // ("customFields" jsonb_path_ops)) is hand-written in the init migration's
  // raw-SQL section. It's NOT declared here because Prisma's
  // `raw("jsonb_path_ops")` emitter appends a redundant `ASC` that its own
  // diff tool then flags as drift on every `migrate dev`, producing a no-op
  // DROP+CREATE migration every time. Hand-managed sidesteps that.
}

// Customer-lifecycle stage. A team configures an ordered list ("New",
// "Qualified", "Customer", "Churned", …) and each Contact sits in exactly one
// at a time. Used for grouping in the contacts list and for stage-targeted
// broadcasts later. Per-team — names + colors are not platform-global.
//
// `isDefault` is the stage new contacts land in (manual creates, webhook
// ingest, CSV import all consult it). At-most-one-default-per-team is
// enforced by a partial unique index (`ContactStage_teamId_isDefault_key`
// in the init migration's raw-SQL section). Prisma doesn't model partial
// indexes, so the index is raw-SQL only; the app code's pre-check still
// exists as a friendlier error path but is no longer load-bearing for
// correctness.
//
// `color` mirrors the Tag color slot system (lib/tag-colors.ts) so the same
// safelist of Tailwind classes covers both surfaces.
model ContactStage {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  color     String   @default("slate")
  // Sort order in the stages list — lower first. New stages get the next
  // available slot at create time; reorder is a bulk PATCH.
  position  Int      @default(0)
  // Exactly one row per team should carry isDefault = true. The partial
  // unique index `ContactStage_teamId_isDefault_key` (raw SQL in the init
  // migration) is the backstop; the app-code pre-check in
  // /api/team/stages POST + PATCH still runs as a friendlier 4xx.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([teamId, name])
  @@index([teamId, position])
}

// Team-wide contact field definitions: an admin/manager defines a key+label
// once, and every contact in the team renders that field in the panel. The
// value still lives in Contact.customFields[key] so we don't need a separate
// values table for MVP. Renaming a field here is a metadata-only change;
// deleting it strips the key from every contact's customFields in the same
// transaction (see /api/team/contact-fields/[id] DELETE).
model ContactFieldDefinition {
  id        String   @id @default(cuid())
  teamId    String
  // Stable identifier used in Contact.customFields. Lowercased + underscored
  // at create time; immutable once set so existing data keeps mapping cleanly.
  key       String
  label     String
  // Sort order within the panel — lower first. Tracked so the UI can reorder
  // later without us needing alphabetical-only sorting.
  order     Int      @default(0)
  // Admin-controlled visibility for the inbox contact panel. Hidden fields
  // are dropped from the panel for ALL agents (including admins — they can
  // still toggle them back on from /settings/contact-fields). Default true
  // so existing definitions stay visible after the migration.
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, key])
  @@index([teamId, order])
}

model Conversation {
  id                 String             @id @default(cuid())
  teamId             String
  contactId          String
  // Channel this thread lives on, and the SOURCE OF TRUTH for "which channel"
  // — NOT the contact (contacts are siloed per channel today, but channel
  // ownership belongs to the thread). A conversation is bound to ONE channel
  // for its lifetime. Needed even with zero messages (a thread created on
  // first outbound), to route sends and list/filter threads. Stamped at
  // creation: inbound = the ingesting provider; outbound-initiated threads
  // default to the team's WhatsApp channel. `Message.provider` always equals
  // this but exists for a different reason (the dedup key — see its comment);
  // the equality is a consistency invariant, not duplicated data.
  channel            Channel            @default(whatsapp)
  assignedUserId     String?
  // New chats land in `pending` so they sit in the triage column until an
  // agent claims them (→ open) or closes them out. The webhook ingest, the
  // broadcast runner, and the message-forward path all rely on this
  // default; existing conversations are untouched by the migration.
  status             ConversationStatus @default(pending)
  unreadCount        Int                @default(0)
  lastMessageAt      DateTime           @default(now())
  lastMessagePreview String             @default("")
  createdAt          DateTime           @default(now())

  // ---- Workflow analytics ----
  // Populated incrementally by lib/conversations/analytics.ts on assign /
  // status-change / message-create. All nullable until the first qualifying
  // event happens. Exposed to the workflow trigger payload as
  // $conversation.first_response_time etc.
  firstAssignedAt       DateTime?
  firstAssignedUserId   String?
  lastAssignedAt        DateTime?
  // First outbound message timestamp, regardless of channel — used for
  // first_response_time and the assignment→response variants.
  firstResponseAt       DateTime?
  firstResponseByUserId String?
  // When the conversation moved into `closed`. Reopens (status going from
  // closed back to anything else) zero this out so the closed-conv analytics
  // refer to the most-recent close.
  closedAt              DateTime?
  closedByUserId        String?
  // Free-text fields populated by the close_conversation step + the manual
  // "Close" action in the inbox (round 2b adds the inbox surface).
  closedCategory        String?
  closedSummary         String?
  // Lightweight counters — denormalized so the closed-conv analytics
  // payload doesn't run aggregates against Message on every workflow run.
  assignmentsCount      Int       @default(0)
  incomingMessagesCount Int       @default(0)
  outgoingMessagesCount Int       @default(0)
  responsesCount        Int       @default(0)

  team         Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contact      Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?                     @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]
  notes        InternalNote[]
  // Audit timeline rows for this conversation. Cascade with the parent —
  // a deleted conversation drops its history. Team-level audit (if we want
  // a global "show me everything" feed) lives on the ConversationEvent.teamId
  // index, independent of cascade.
  events       ConversationEvent[]

  @@index([teamId, status, lastMessageAt(sort: Desc)])
  @@index([teamId, assignedUserId])
  // Keyset-paginated inbox listing: WHERE teamId = $1 ORDER BY lastMessageAt
  // DESC, id DESC. The status-leading index above stays for filtered views
  // (open / pending / closed) but doesn't help the unfiltered list — the
  // planner needs status to participate in WHERE for that one to be useful.
  @@index([teamId, lastMessageAt(sort: Desc), id(sort: Desc)])
  // ONE conversation per contact — the core invariant, DB-enforced (a Contact
  // is already channel-siloed, so this is "one conversation per channel per
  // contact"). Closed threads REOPEN (→ pending) rather than fragment. Code
  // upholds it too — ingest via a Serializable retry, the find-or-create sites
  // (forward / broadcast / external-v1 / workflow target) via catch-P2002→
  // refetch — but this constraint is the backstop that makes a fragmented
  // inbox structurally impossible. Doubles as the index the broadcast runner's
  // per-recipient `findFirst({ teamId, contactId })` + contact-detail pages use.
  @@unique([teamId, contactId])
  // pg_trgm GIN for the inbox-list search bar's ILIKE on lastMessagePreview.
  @@index([lastMessagePreview(ops: raw("gin_trgm_ops"))], type: Gin, map: "Conversation_lastMessagePreview_trgm_idx")
}

model Message {
  id             String           @id @default(cuid())
  teamId         String
  conversationId String
  // Provider-assigned id. Dedupe via the compound unique below — bare
  // `@unique` would collide across providers because Meta's WhatsApp wamid
  // and Instagram message-id share the same opaque-string shape and could
  // theoretically clash (Telegram numeric ids definitely will against
  // something). Compound on (teamId, provider, externalId) keeps each
  // channel's id space isolated.
  externalId     String
  // null on inbound — only outbound has an authoring agent.
  senderUserId   String?
  // For text-only messages this is the body. For media messages this holds
  // the caption (or empty) so search keeps matching across both kinds.
  body           String
  direction      MessageDirection
  // Half of the dedup key `@@unique([teamId, provider, externalId])` below —
  // that's its job, NOT to classify the channel. It is enforced at INSERT,
  // before any conversation link exists (dedupe runs first in ingest), and a
  // DB unique index can't span a JOIN, so provider must live on this row.
  // Channel OWNERSHIP is `Conversation.provider`; this always equals it
  // (a thread is single-channel) — a consistency invariant, not redundancy.
  // Don't "simplify" by dropping either: lose this and dedup breaks once a
  // 2nd channel exists; lose Conversation.provider and empty threads (no
  // messages yet) have no channel.
  channel        Channel
  status         MessageStatus    @default(sent)
  // Original webhook payload kept verbatim for debugging.
  rawPayload     Json
  timestamp      DateTime         @default(now())
  createdAt      DateTime         @default(now())

  // Media fields. All nullable — text-only rows leave them null. `mediaKind`
  // is the discriminator; when set, the binary lives in the active blob
  // storage provider (today UploadThing, see lib/blob-storage/).
  //
  //   mediaKey — provider's reference for the file. Used to call
  //              blobStorage.delete(). Provider-agnostic by design: today this
  //              is an UploadThing fileKey, tomorrow it could be an S3 object
  //              key. The shape is opaque to app code.
  //   mediaUrl — public CDN URL the browser fetches. /api/media/[id] does a
  //              team-ownership check then 302s to this.
  mediaKind       String?
  mediaKey        String?
  mediaUrl        String?
  mediaMimeType   String?
  mediaCaption    String?
  mediaFilename   String?
  mediaSizeBytes  Int?
  mediaDurationMs Int?

  // Optional first-frame thumbnail for video messages. Generated server-side
  // during inbound media ingest via @ffmpeg-installer/ffmpeg + fluent-ffmpeg;
  // stored as a separate blob (uploadthing key) so the <video> element can
  // render a poster frame instead of a black square until the user clicks
  // play. Outbound video sends don't generate one today (the file is already
  // on the agent's disk; their player picks its own frame); revisit if
  // outbound bubbles look inconsistent next to inbound.
  mediaThumbnailKey String?
  mediaThumbnailUrl String?

  // Quoted reply: the row this message is replying to. Self-FK with SetNull
  // so deleting the original (rare) doesn't take the reply with it. The
  // snapshot the UI renders comes from JOINing this row at read time, not
  // from a denormalized copy — we don't want stale quotes when bodies edit.
  replyToMessageId String?
  replyTo          Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReply")

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("AuthoredMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  // NOTE: a partial index on inbound-only messages also exists in the DB
  // (`Message_conversationId_timestamp_inbound_idx` in the init migration's
  // raw-SQL section). Prisma can't express `WHERE direction = 'in'` via
  // `@@index`. It powers the "what was the contact's last inbound?" lookups
  // (24h-window UI + lastInboundAt drift sweeper) without scanning outbound
  // rows.

  @@unique([teamId, channel, externalId])
  @@index([conversationId, timestamp])
  @@index([teamId])
  @@index([replyToMessageId])
  // Keyset for thread loads + "load older": WHERE conversationId = $1
  // ORDER BY timestamp DESC, id DESC. The ascending index above still
  // serves chronological/range scans; this one is purpose-built for the
  // backward keyset cursor with id as the same-millisecond tiebreaker.
  @@index([conversationId, timestamp(sort: Desc), id(sort: Desc)])
}

// One-row-per-attempt log for outbound text sends, written BEFORE the Meta
// fetch so a worker death mid-fetch can be detected on retry.
//
// Why this exists: BullMQ's send queue uses jobId = `msg-send-${clientTempId}`
// and retries the SAME jobId after `lockDuration=90s` if the worker dies
// without completing. Meta has no native idempotency key on POST /messages,
// so a process death between Meta receiving the request and the worker
// recording the response → BullMQ retry → Meta sends the message AGAIN.
// The DB-level unique on `(teamId, provider, externalId)` dedupes the
// resulting Message row, but the customer was already charged twice and
// saw two messages on WhatsApp.
//
// The fix: every send attempt insert-or-fail-on-conflict a row here keyed
// by jobId BEFORE calling Meta. If the insert succeeds, no prior attempt
// touched Meta — safe to proceed. If a P2002 fires:
//   - completedAt is set → the prior attempt succeeded; look up the
//     existing Message row by externalId and re-publish `message.sent`
//     so the originating client sees the bubble swap (idempotent reply).
//   - completedAt is null → Meta may or may not have received the request
//     in the prior attempt. We refuse to retry (UnrecoverableError) to
//     avoid the rare double-charge. The originating client's post-HTTP
//     watchdog (30s) will flip the optimistic bubble to `failed` and the
//     user can retry — with a fresh clientTempId, which is a new jobId,
//     and unblocked. Trade-off: a Meta-was-actually-down scenario means
//     one "lost" send the user must re-do; vs the alternative of
//     systematically double-charging on every deploy-induced retry.
//
// Cleanup: rows older than 7 days are purged by the outboundSendAttempt
// sweeper (see apps/api/src/lib/sweepers/). Completed + failed rows are
// expendable bookkeeping after the originating job has been ack'd by
// BullMQ's removeOnComplete window (24h).
model OutboundSendAttempt {
  id               String    @id @default(cuid())
  // Matches BullMQ's jobId for this send: `msg-send-${clientTempId}`. The
  // SAME jobId is used across all retry attempts of the same client-side
  // send action — that's the property we exploit to detect a retry.
  jobId            String    @unique
  teamId           String
  conversationId   String
  attemptStartedAt DateTime  @default(now())
  // Set when the Meta fetch returned successfully AND we recorded the
  // wamid. Until set, the attempt is considered in-flight or aborted.
  completedAt      DateTime?
  // Meta wamid from a successful send; used on retry to look up the
  // existing Message row and re-publish `message.sent`.
  externalId       String?
  // Set when Meta returned a non-retryable error (4xx). A retry will see
  // failedAt + a populated failureReason and proceed normally — the
  // original failure publish to the client already happened, so a
  // duplicate publish is harmless. (Failed-attempt rows still get
  // recycled by the sweeper.)
  failedAt         DateTime?
  failureReason    String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Sweeper picks rows by (completedAt || failedAt) older than the
  // retention window — index on attemptStartedAt for the scan.
  @@index([attemptStartedAt])
  @@index([teamId, completedAt])
}

// Pending team invite. Admin POSTs to /api/invites; the link contains a
// random token whose SHA-256 hash is stored here (never the raw token, same
// reasoning as a password). Accepting consumes the row by stamping
// acceptedAt — we don't delete so admins can audit who invited whom.
model Invite {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  role        Role      @default(agent)
  tokenHash   String    @unique
  // Nullable + SetNull so deleting the inviter leaves their pending invites
  // in place — the token still works, the "invited by" label just falls
  // back to "Removed user".
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation("InvitedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teamId, email])
}

// Cached snapshot of a WhatsApp message template registered on the team's
// WABA. We sync from Meta on demand (admin clicks "Refresh templates" in the
// settings page, or the picker opens with a stale-than-5-min cache) and store
// the full component tree as JSON so the picker can render the same preview
// the customer will see — header (text/media), body with {{n}} placeholders,
// footer, and buttons.
//
// `externalId` is Meta's template id; we keep `(teamId, name, language)` as
// the natural key since the same template can have multiple language variants
// under a single name. Updating a template in WhatsApp Manager bumps Meta's
// id — the sync upserts by the natural key so the cached row tracks the
// latest version.
model MessageTemplate {
  id               String           @id @default(cuid())
  teamId           String
  externalId       String?
  name             String
  language         String
  category         TemplateCategory
  status           TemplateStatus
  // Body text with `{{1}}, {{2}}, …` placeholders. Denormalized from components
  // for cheap previews / search; the canonical source is `components`.
  bodyText         String           @default("")
  // Full components array as Meta returned it. Schema:
  //   [{ type: "HEADER" | "BODY" | "FOOTER" | "BUTTONS", format?, text?, buttons? }]
  components       Json
  // Per-variable metadata layered on top of Meta's positional `{{n}}` model:
  // human-readable label + source (manual / contact field / custom field) +
  // optional fallback value used at send time when the contact's field is
  // empty. Owned by our app — Meta never sees this. Shape:
  //   { body: VariableBinding[], header?: VariableBinding }
  //   VariableBinding = {
  //     label: string,
  //     source:
  //       | { kind: "manual" }
  //       | { kind: "contact_field", field: "name"|"phoneNumber"|"email"|"location" }
  //       | { kind: "contact_custom_field", key: string },
  //     defaultValue?: string,
  //   }
  // Empty `{}` for templates synced from Meta before bindings existed — the
  // runner treats a missing binding the same as `manual`, so old broadcasts
  // keep working.
  variableBindings Json             @default("{}")
  syncedAt         DateTime         @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, name, language])
  @@index([teamId, status])
}

// Free-form label applied to contacts for segmentation ("VIP", "Ramadan
// buyers", "Women clients", …). Many-to-many with Contact — a contact can
// carry any number of tags, a tag is reused across many contacts.
//
// `color` is a named slot ("slate", "rose", "amber", …) NOT a hex, so the UI
// can map to a safelist of Tailwind classes without dynamic class strings.
model Tag {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  color     String   @default("slate")
  createdAt DateTime @default(now())

  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Tags live on Contact. Implicit M2M; join table is `_ContactToTag` (re-
  // created by the revert migration). One contact = one conversation in
  // this app, so per-thread tagging would be dead complexity.
  contacts       Contact[]
  // M2M with audience groups built off a tag-based filter. A group with
  // tags = "ramadan, women" includes the union of contacts carrying any
  // of them.
  audienceGroups AudienceGroup[] @relation("AudienceGroupTags")

  @@unique([teamId, name])
  @@index([teamId])
}

// Saved audience for broadcasts. Hybrid composition:
//   - `tags`     → dynamic: every contact with ANY of these tags is in the
//                  group at resolution time.
//   - `contacts` → manual: these specific contacts are always in the group,
//                  even if their tags change later.
// Members at send time = union of both. Empty `tags` + empty `contacts` is
// a valid but empty group (the broadcast wizard will reject it).
//
// Inspired by Front / Intercom segments. Static (snapshot-at-send) — when
// the agent triggers a broadcast that targets a group, the runner resolves
// the current member set ONCE and writes it into BroadcastRecipient. New
// contacts that match the criteria afterwards don't join the in-flight job.
model AudienceGroup {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  description String?
  // Nullable + SetNull — audience groups are team-shared and shouldn't be
  // destroyed when their creator is removed.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CreatedAudienceGroups", fields: [createdById], references: [id], onDelete: SetNull)
  tags      Tag[]     @relation("AudienceGroupTags")
  contacts  Contact[] @relation("AudienceGroupContacts")

  @@unique([teamId, name])
  @@index([teamId])
}

// A batch template send to many recipients in one go. Inspired by Front /
// Intercom broadcasts. Variables are SAME-FOR-ALL in v1 — per-recipient
// personalization (CSV upload) is a later add-on.
//
// `template*` fields are SNAPSHOTTED at creation, not foreign keys. If the
// admin re-syncs templates from Meta and the template gets renamed or its
// body changes mid-broadcast, this row keeps the version that was actually
// sent. We do keep `templateId` for ergonomic linkage in the UI.
model Broadcast {
  id                String          @id @default(cuid())
  teamId            String
  // Nullable + SetNull — broadcasts are audit history; we never want them
  // destroyed when the agent who launched them is removed.
  createdById       String?
  status            BroadcastStatus @default(queued)
  // Snapshot of the template at send time.
  templateId        String
  templateName      String
  templateLanguage  String
  // The values the agent filled into {{1}}, {{2}}, … (and optional header).
  // Schema: { body: string[], header?: string }
  variables         Json
  // Audience picker mode the agent chose at creation.
  //   "all"       — every team contact at the moment of creation.
  //   "selected"  — the recipient list was hand-picked.
  //   "by_tag"    — `audienceTagIds` were resolved to the recipient list at
  //                 the moment of creation (snapshot). A contact re-tagged
  //                 later does NOT get added to an in-flight broadcast.
  audienceMode      String
  // Tag ids the agent originally selected (mode = by_tag). Kept for the
  // detail page so the audit trail can show "Sent to VIP, Ramadan buyers"
  // even after the tag is renamed.
  audienceTagIds    String[]        @default([])
  // Group used when mode = "group". Held as a soft reference (just the id +
  // a denormalized name) — no FK because we never want to cascade-delete a
  // broadcast's audit trail when the group gets removed.
  audienceGroupId   String?
  audienceGroupName String?
  // Counters live on the parent for cheap progress reads — derived from
  // BroadcastRecipient.status, kept in sync by the runner.
  totalCount        Int             @default(0)
  sentCount         Int             @default(0)
  failedCount       Int             @default(0)
  // Free-form last-error captured if the whole runner crashed (not per-
  // recipient errors, those live on the BroadcastRecipient row).
  lastError         String?
  createdAt         DateTime        @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  team       Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User?                @relation("CreatedBroadcasts", fields: [createdById], references: [id], onDelete: SetNull)
  recipients BroadcastRecipient[]

  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, status])
}

model BroadcastRecipient {
  id             String                   @id @default(cuid())
  broadcastId    String
  contactId      String
  // Set after the runner picks/creates a conversation for this recipient so
  // the message lands in the existing thread (matches the inbox rules).
  conversationId String?
  status         BroadcastRecipientStatus @default(queued)
  // Meta wamid of the sent message — links back to the Message row.
  externalId     String?
  // Per-recipient error body, kept compact for the UI table.
  errorMessage   String?
  sentAt         DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Each contact appears at most once per broadcast — dedupe in the audience
  // picker, but enforce here too so the runner can re-run idempotently.
  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  @@index([contactId])
}

model InternalNote {
  id             String   @id @default(cuid())
  // Tenant scope, for rule-#2 consistency with every other table (notably its
  // sibling audit table ConversationEvent). A note's team always equals its
  // conversation's team (conversations never change team), so this is a stable
  // denorm — kept for direct team-scoped queries / future RLS, not for delete
  // cascades (those already flow Team -> Conversation -> InternalNote).
  teamId         String
  conversationId String
  // Nullable + SetNull — internal notes are critical audit trail. When the
  // author is removed, the note STAYS and the UI renders "Removed user".
  // Cascading would destroy customer-context the next agent needs.
  authorUserId   String?
  body           String
  timestamp      DateTime @default(now())

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, timestamp])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------
//
// Multi-step DAG workflows built on a React Flow canvas. Admins design them
// at /workflows. Each workflow has:
//   - one trigger (when does this fire?)
//   - optional trigger-time conditions (does it actually fire for THIS event?)
//   - optional once-per-contact dedupe (welcome flows don't want to fire twice)
//   - a graph of steps with edges, including branch / wait / jump control flow
//
// Dispatch path: a domain event calls `dispatch(teamId, event, payload)` in
// lib/workflows/dispatcher.ts. The dispatcher loads enabled workflows for
// this team+trigger, evaluates `triggerConditions`, optionally checks the
// once-per-contact ledger (`WorkflowContactState`), and enqueues a BullMQ
// job per match. The worker runs the DAG one step at a time, persisting
// state on WorkflowRun after each step so `wait` can resume cleanly and
// failures are debuggable per step.
//
// Round 1 (pre-canvas) used flat single-action Automation rows; those were
// migrated to single-step Workflow rows in the 20260516180000_workflows
// migration. Removed entirely: `Automation`, `AutomationRun`, and their
// enums.

model Workflow {
  id                    String               @id @default(cuid())
  teamId                String
  name                  String
  // `enabled` is the kill switch; `published` gates whether real triggers
  // actually fire the workflow (vs. test-only). A workflow can be enabled
  // but unpublished (still being edited) — the dispatcher requires BOTH to
  // match production triggers.
  enabled               Boolean              @default(true)
  published             Boolean              @default(false)
  trigger               WorkflowTriggerEvent
  // Trigger-specific config. Shape depends on trigger:
  //   incoming_webhook → { secret: string }  (HMAC for signature validation)
  //   manual_trigger   → { allowedRoles: ("admin"|"agent")[] }
  //   contact_tag_updated → { kind: "added" | "removed" | "any" }
  //   contact_field_updated → { fieldKey?: string }  (omit = any field)
  //   contact_lifecycle_updated → { toStageId?: string }  (omit = any stage)
  //   others → {}
  triggerConfig         Json                 @default("{}")
  // Same nested AND/OR group shape used by automations Round 1 — see
  // lib/workflows/conditions.ts.
  triggerConditions     Json                 @default("{\"op\":\"AND\",\"children\":[]}")
  triggerOncePerContact Boolean              @default(false)

  // DAG. Shape:
  //   {
  //     startNodeId: string,
  //     nodes: [{ id, type: WorkflowStepType, config: {...}, position?: {x,y} }],
  //     edges: [{ from, to, label?: "true" | "false" | string }],
  //   }
  // `position` is round-trip persistence for the canvas — runner ignores it.
  // Validated server-side in lib/workflows/graph.ts at write time.
  graph Json @default("{\"startNodeId\":\"\",\"nodes\":[],\"edges\":[]}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team          Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  runs          WorkflowRun[]
  contactStates WorkflowContactState[]
  awaitingReplies WorkflowAwaitingReply[]

  @@unique([teamId, name])
  // Hot path: dispatcher loads `WHERE teamId=? AND trigger=? AND enabled=true AND published=true`.
  @@index([teamId, trigger, enabled, published])
}

model WorkflowRun {
  id         String               @id @default(cuid())
  workflowId String
  teamId     String
  status     WorkflowRunStatus    @default(queued)
  trigger    WorkflowTriggerEvent

  // The contact this run is acting on. Nullable for triggers that aren't
  // contact-scoped (none today, but keeps the schema flexible if we add a
  // team-level "any time of day" cron trigger). Used by:
  //   - once-per-contact dedupe (combined with workflowId in WorkflowContactState)
  //   - Ask a Question step resume routing (Round 2c)
  contactId      String?
  conversationId String?

  // Snapshot of the event payload at dispatch time. Used by branch/condition
  // evaluation throughout the run AND by the runs UI to show "why did this fire."
  eventPayload Json

  // Immutable snapshot of Workflow.graph taken at run-creation time. The runner
  // executes THIS, never the live Workflow.graph — so editing a workflow while a
  // run is paused (wait / ask_question) can't corrupt the in-flight run
  // (orphaned currentStepId, wrong branch). Nullable only for runs created before
  // this column existed; the runner falls back to the live graph for those (see
  // runner.ts). The enabled/published kill switch is still read live — only the
  // graph is pinned.
  graphSnapshot Json?

  // DAG state. `currentStepId` is the step that will run NEXT (queued state),
  // or the step that's PAUSED (waiting state), or NULL (completed/failed).
  currentStepId String?
  // For waiting state: when the resume job is scheduled to fire. Lets the UI
  // show "resumes in 1h" without consulting BullMQ.
  waitUntil     DateTime?
  // Jump-to-step uses this to cap loops. Hard ceiling enforced in runner.ts.
  jumpsUsed     Int       @default(0)

  // Per-step audit log. Append-only array of:
  //   { stepId, type, status, startedAt, finishedAt?, responseStatus?,
  //     responseBody?, errorMessage?, nextStepId? }
  // Limited to ~100 entries by the runner's step ceiling.
  stepLog Json @default("[]")

  // Inbound answer dropped here by the message-ingest hook when a contact
  // replies to an `ask_question` step. The ask_question step handler reads
  // and clears it on resume; null means "still awaiting / timed out."
  // Shape: { body: string, messageId: string, timestamp: string } | null
  pendingAnswer Json?

  // Per-step structured outputs from this run. Map of stepId → JSON object
  // produced by the step's run() (parsed from StepResult.body). Drives the
  // `$var.previousStep.X` + `$var.steps.<id>.X` tokens so downstream steps
  // can route on what an earlier step produced (e.g. HTTP response body
  // fields, ask_question answer + optionId, branch selection). Capped at
  // ~32KB per step in the runner; cheap as long as `body` payloads stay
  // small. Empty for runs that don't reference per-step outputs.
  stepOutputs Json @default("{}")

  attempts     Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  awaitingReply WorkflowAwaitingReply?

  @@index([workflowId, startedAt(sort: Desc)])
  @@index([teamId, startedAt(sort: Desc)])
  // Status-leading index for the worker's "find runs to resume" sweep
  // (round 3 fallback if a wait job goes missing).
  @@index([status, waitUntil])
}

// One row per `ask_question` step that's currently paused waiting for the
// contact's next inbound message. The message-ingest hook does
// `findFirst({ where: { teamId, contactId } })` on each inbound and, if it
// finds a match, drops the message body onto `WorkflowRun.pendingAnswer`,
// deletes this row, and enqueues an immediate resume for the run. The
// runner's timeout job re-fires the same step independently — whoever wins
// the race deletes this row; the loser is a no-op.
//
// Separate from WorkflowContactState (the trigger-once-per-contact ledger)
// because the semantics + cardinality differ: that table is one row per
// (workflow, contact) for life-of-deployment; this table is one row per
// in-flight question with a near-term expiresAt.
model WorkflowAwaitingReply {
  id         String   @id @default(cuid())
  teamId     String
  contactId  String
  runId      String   @unique
  workflowId String
  stepId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  team     Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contact  Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  run      WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  workflow Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Inbound-resume lookup: every inbound message hits this index to ask
  // "is anyone awaiting from this contact?"
  @@index([teamId, contactId])
  // Timeout sweeper fallback (round 3): find awaiting rows past expiresAt
  // in case the BullMQ delayed job got lost.
  @@index([expiresAt])
}

// Per-(workflow, contact) ledger row for `triggerOncePerContact`. Existence
// of the row means "this workflow has fired for this contact." Cheap to
// look up via the compound unique; cleared when the workflow is deleted via
// cascade.
model WorkflowContactState {
  id         String   @id @default(cuid())
  workflowId String
  contactId  String
  teamId     String
  firedAt    DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([workflowId, contactId])
  @@index([teamId])
}

// API key for the external (n8n-facing) endpoints under /api/external/v1.
// n8n authenticates with `Authorization: Bearer <key>`. We store SHA-256 of
// the plaintext only — `tokenPrefix` (first 8 chars) is shown in the UI so
// admins can tell two keys apart without exposing the secret.
//
// Plaintext is shown EXACTLY ONCE at creation time. Lost keys are rotated,
// not recovered.
model TeamApiKey {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  createdById String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  /// Allow-listed capabilities for this key. `["*"]` = wildcard (every
  /// scope). Empty array = deny-by-default. See
  /// packages/shared/src/api-keys/scopes.ts for the canonical catalog.
  /// Backfilled to `["*"]` for pre-existing rows so partner integrations
  /// keep working — new keys ask for specific scopes from the settings UI.
  scopes      String[]  @default(["*"])

  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  idempotencyKeys    ApiIdempotencyKey[]
  conversationEvents ConversationEvent[]

  @@index([teamId, revokedAt])
}

/// Stores `Idempotency-Key` headers from external /v1 POSTs so a partner's
/// retry after a 5xx (or n8n's default retry-on-timeout) doesn't double-send
/// to WhatsApp. Keyed by (team, apiKey, key) so two partners using the same
/// short key can't collide. `responseBody` is the JSON we returned the first
/// time — replayed verbatim on retry within the TTL so the partner sees the
/// same shape they'd see if their first call had completed.
///
/// 24h TTL is the canonical retry window for HTTP semantics (Stripe-style);
/// after that a "retry" is logically a NEW operation. Sweeper job at the end
/// of the file purges expired rows.
model ApiIdempotencyKey {
  id             String   @id @default(cuid())
  teamId         String
  apiKeyId       String
  key            String
  responseBody   Json
  responseStatus Int
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  apiKey TeamApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([teamId, apiKeyId, key])
  @@index([expiresAt])
}

/// Outbound webhook subscription. Partners create one of these per "I want
/// to know when X happens" — `eventTypes` is the allowlist of public event
/// names the subscriber wants. `secret` is envelope-encrypted (same helper
/// Meta credentials use) and signs each delivery with HMAC-SHA256 over the
/// raw body via the `X-CCP-Signature` header.
///
/// Plaintext secret is shown EXACTLY ONCE at creation; rotation is explicit.
/// Auto-disabled after a sustained run of failures so a dead URL doesn't
/// keep our queue busy forever.
model OutboundWebhook {
  id                String   @id @default(cuid())
  teamId            String
  name              String
  url               String
  /// HMAC-SHA256 signing secret. Stored as `enc:v1:<base64>` (envelope encryption).
  secret            String
  /// Allowlisted public event type names (e.g. ["message.received", "contact.updated"]).
  eventTypes        String[]
  enabled           Boolean  @default(true)
  createdById       String
  createdAt         DateTime @default(now())
  /// Last successful delivery (2xx response) — surfaced in the UI as "Last delivered".
  lastDeliveredAt   DateTime?
  /// Last failure — last error message + when. Reset after a successful delivery.
  lastErrorAt       DateTime?
  lastErrorMessage  String?
  /// Rolling failure count for the auto-disable circuit breaker. Reset to 0 on
  /// every 2xx. When it crosses the threshold, `enabled` flips to false.
  consecutiveFailures Int    @default(0)
  /// Set when `enabled` flips to false from automatic action (circuit breaker
  /// vs. an explicit admin toggle). Together with `disabledReason` they're
  /// the audit trail the UI surfaces as "auto-disabled at … because …".
  /// Manual toggles via the settings UI clear both back to null.
  disabledAt        DateTime?
  disabledReason    String?

  team       Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deliveries OutboundWebhookDelivery[]

  @@index([teamId, enabled])
}

/// One row per delivery attempt. Powers the "delivery log" UI so partners can
/// debug receiver-side failures without us needing to surface internal logs.
/// `responseBody` is truncated to ~4KB on insert (receivers sometimes echo
/// huge payloads). Nightly sweeper
/// (apps/api/src/lib/sweepers/outbound-webhook-delivery-cleanup.ts) drops
/// rows older than 30 days; override via WEBHOOK_DELIVERY_RETENTION_DAYS.
model OutboundWebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  eventType      String
  /// Public-shape payload the receiver was sent. Stored verbatim so a retry
  /// from the UI can re-POST the same JSON.
  payload        Json
  /// HTTP status code from the receiver. null when fetch itself failed (DNS,
  /// timeout, TLS) — `errorMessage` carries the reason in that case.
  responseStatus Int?
  responseBody   String?
  attemptCount   Int      @default(0)
  deliveredAt    DateTime?
  failedAt       DateTime?
  errorMessage   String?
  createdAt      DateTime @default(now())

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Inbox unread = team-wide ONLY
// ---------------------------------------------------------------------------
//
// There is exactly ONE unread tier for the inbox: Conversation.unreadCount
// (team-wide INT counter). Written by ingest (+1 per inbound), markRead (→0),
// markUnread (→1); read by the conversation-list badges, document.title total,
// outbound-webhook payloads, and the workflow envelope. Any member opening a
// thread zeroes it for EVERYONE — "read" means read for the whole team.
//
// There is deliberately NO per-agent inbox read state. A prior iteration
// added a `ConversationReadReceipt` table + an `unreadForMe` derived field,
// but no UI ever consumed it (the list item always rendered against
// unreadCount) — it was computed, shipped to the client, and dropped. Both
// the table and the field were removed. Do NOT re-introduce per-agent inbox
// unread without a real per-agent inbox UX to justify it. Team chat already
// has its own per-user receipts (TeamChannelReadReceipt) for the cases where
// personal read state genuinely matters.

// ---------------------------------------------------------------------------
// Conversation audit log
// ---------------------------------------------------------------------------
//
// Append-only timeline of state changes on a conversation. Powers the right-
// rail "history" panel (future) and answers the "who closed this 3 days ago"
// question that always comes up after pilot launch.
//
// Schema by `kind`:
//   assigned         — `before` = { assignedUserId: string | null }
//                      `after`  = { assignedUserId: string | null }
//   status_changed   — `before` = { status: ConversationStatus }
//                      `after`  = { status: ConversationStatus }
//   tag_added        — `after`  = { tagId: string, tagName: string }
//   tag_removed      — `before` = { tagId: string, tagName: string }
//
// `userId` is the agent who performed the action. Nullable + SetNull so
// removing an agent doesn't take their audit trail with them (the UI
// renders "Removed user" for the actor label). For system actions (e.g.
// a webhook auto-assignment, an automation closing a thread), `userId` is
// null and the actor is "System."
model ConversationEvent {
  id             String                @id @default(cuid())
  conversationId String
  teamId         String
  userId         String?
  /// Set when the mutation came from an external /v1 API call instead of a
  /// human session. Mutually exclusive with userId in practice — partner
  /// integrations have no human author. SetNull on key revoke so audit
  /// history survives key rotation.
  apiKeyId       String?
  kind           ConversationEventKind
  before         Json?
  after          Json?
  at             DateTime              @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey       TeamApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([conversationId, at(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Team chat (internal channels)
// ---------------------------------------------------------------------------
//
// Slack-style group chat between agents on the same team. Distinct from
// customer-facing Conversation/Message because the surfaces don't overlap:
// - No provider, no externalId, no direction, no status, no rawPayload
// - Different read-receipt cadence and indexes
// - Different permission model (every team member is implicitly in every
//   channel for v0; per-channel membership is the future hook)
//
// Keeping the two graphs apart means a query against `Message` (the customer
// surface) cannot accidentally leak into team-chat results, and vice versa.
// Cost: some duplicated media columns. Worth it.

model TeamChannel {
  id                 String   @id @default(cuid())
  teamId             String
  // Lowercase slug, unique per team. Becomes the URL: /team/<slug>.
  // The default channel "general" is auto-created at team setup time and
  // protected — the DELETE and rename routes refuse to touch it.
  name               String
  description        String?
  // The first channel created with name="general" per team is the default.
  // Used to (a) redirect /team to the default channel, (b) protect from
  // deletion/rename. At-most-one-default-per-team is enforced in app code,
  // not by a partial unique (Prisma can't model those).
  isDefault          Boolean  @default(false)
  // Nullable + SetNull — channels are team-shared and shouldn't be destroyed
  // when their creator leaves. The audit label degrades to "Removed user."
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // Denormalized for cheap list rendering. Kept in sync by the message-send
  // route; reads never have to join through TeamChannelMessage to render the
  // sidebar. Best-effort consistency — a race that leaves these slightly
  // stale is fine; the next message corrects them.
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String   @default("")

  team      Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User?                    @relation("CreatedChannels", fields: [createdById], references: [id], onDelete: SetNull)
  messages  TeamChannelMessage[]
  receipts  TeamChannelReadReceipt[]
  pins      TeamChannelPin[]
  members   TeamChannelMember[]

  @@unique([teamId, name])
  @@index([teamId, lastMessageAt(sort: Desc)])
}

// Per-channel membership. The default channel ("general") implicitly includes
// every team member — the service layer auto-inserts on team-join and refuses
// removals. Non-default channels are members-only: listChannelsForUser filters
// through this table, so a user only sees channels they're in.
//
// Cascade on both sides: deleting a channel or a user purges the rows; no
// orphan memberships. `addedById` is SetNull so removing an admin doesn't
// destroy attribution on the rows they added.
model TeamChannelMember {
  channelId String
  userId    String
  addedAt   DateTime @default(now())
  addedById String?

  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation("ChannelMemberships", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?       @relation("AddedChannelMembers", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([channelId, userId])
  @@index([userId])
}

// One row per top-level channel message OR thread reply. The discriminator is
// `threadRootId`:
//   - NULL  → top-level channel message. Surfaces in the channel scroller.
//   - SET   → reply to a root message; appears in the thread side panel only.
//
// Slack-style: replies never appear in the main channel feed by default. A
// future "also send to channel" toggle would post a sibling top-level message
// instead of changing this row.
//
// Hover toolbar wires up author-only edits (PATCH within 24h), author-or-
// admin deletes, anyone-can-react, admin/manager pins. The route handlers
// own those checks; the model just stores the data.
model TeamChannelMessage {
  id           String  @id @default(cuid())
  channelId    String
  // Denormalized for cheap tenant guards. The channel obviously already
  // carries teamId, but every read site otherwise has to JOIN — and the
  // socket-emit path wants teamId without a lookup.
  teamId       String
  // Null when the original author was deactivated/removed. UI renders
  // "Removed user" — same pattern as InternalNote.authorUserId.
  authorUserId String?
  body         String

  // ---- Media columns: mirror Message.media* exactly ----
  // The agent attaches a file in the composer; we run it through the same
  // UploadThing pipeline as customer media and store the result here. No
  // background-download phase — there's no provider to fetch from.
  mediaKind       String?
  mediaKey        String?
  mediaUrl        String?
  mediaMimeType   String?
  mediaCaption    String?
  mediaFilename   String?
  mediaSizeBytes  Int?
  mediaDurationMs Int?

  // ---- Edit history ----
  // Null = never edited. Edit window is enforced at the PATCH route (24h);
  // edited messages render an "(edited)" label sourced from this column.
  // Edit history (prior bodies) is not stored — add TeamChannelMessageRevision
  // later if anyone asks.
  editedAt DateTime?

  // ---- Thread linkage ----
  // Null = top-level channel message (the "thread root"). When set, this row
  // is a reply living in the side panel for that root. We don't allow
  // sub-threads (no nesting): a reply's threadRootId always points at a
  // top-level message, never at another reply. The POST route enforces this.
  threadRootId String?

  // ---- Thread denormalization (lives on the ROOT row only) ----
  // Always null/0 on reply rows. The reply route increments threadReplyCount
  // and updates threadLastReplyAt on the parent in the same transaction as
  // the insert, so the channel feed can render "12 replies · 2m ago" without
  // a COUNT().
  threadReplyCount  Int       @default(0)
  threadLastReplyAt DateTime?

  createdAt DateTime @default(now())

  channel       TeamChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  team          Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author        User?                 @relation("AuthoredChannelMessages", fields: [authorUserId], references: [id], onDelete: SetNull)
  threadRoot    TeamChannelMessage?   @relation("ChannelThread", fields: [threadRootId], references: [id], onDelete: Cascade)
  threadReplies TeamChannelMessage[]  @relation("ChannelThread")
  mentions      TeamChannelMention[]
  reactions     TeamChannelReaction[]
  pin           TeamChannelPin?

  // Keyset on the main feed: WHERE channelId = ? AND threadRootId IS NULL
  // ORDER BY createdAt DESC, id DESC. The partial index for top-level rows
  // (`TeamChannelMessage_channel_toplevel_keyset_idx` in the init migration's
  // raw-SQL section) covers that read; Prisma can't model partial indexes.
  // The full (threadRootId, createdAt) index below covers the thread-panel
  // read: WHERE threadRootId = ? ORDER BY createdAt ASC.
  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([threadRootId, createdAt])
  @@index([teamId])
  // pg_trgm GIN for substring ILIKE on channel-message body.
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "TeamChannelMessage_body_trgm_idx")
}

// @user mention. One row per (message, mentionedUser) so the "show me my
// mentions" query is a single indexed lookup, not a JSONB scan. The mention
// is also encoded inline in the body as `@[Display Name](userId)` so plain-
// text previews keep working — these rows are the structured index, not the
// source of truth for the display string.
model TeamChannelMention {
  id              String @id @default(cuid())
  messageId       String
  mentionedUserId String

  message       TeamChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User               @relation("ChannelMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, mentionedUserId])
  @@index([mentionedUserId])
}

// Emoji reaction on a channel message. `emoji` is the raw Unicode codepoint
// (e.g. "👍"), NOT a shortcode — simpler render path, no shortcode→unicode
// map to maintain. Each user can apply each emoji at most once per message.
model TeamChannelReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message TeamChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User               @relation("ChannelReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Pinned message bar. Separate table (not a boolean on the message) so we
// retain who pinned, when. A message can be pinned at most once per channel;
// pin permission is admin/manager — enforced at the route, not by the model.
model TeamChannelPin {
  id         String   @id @default(cuid())
  channelId  String
  messageId  String   @unique
  // SetNull — keep the pin even when the pinner leaves the team.
  pinnedById String?
  pinnedAt   DateTime @default(now())

  channel  TeamChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message  TeamChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User?              @relation("PinnedMessages", fields: [pinnedById], references: [id], onDelete: SetNull)

  @@index([channelId, pinnedAt(sort: Desc)])
}

// Per-(user, channel) read state. `lastReadAt` vs `channel.lastMessageAt`
// yields "unread for me" without a per-message receipt row. Mention-with-
// unread is a JOIN against TeamChannelMention. Team chat is the ONLY surface
// with per-user read state — the customer inbox is team-wide (see the
// "Inbox unread = team-wide ONLY" note above Conversation's audit log).
model TeamChannelReadReceipt {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// Persistent login-attempt counters. Replaces the in-process Map in
// apps/web/src/lib/rate-limit.ts so brute-force history survives process
// restarts (deploys, OOM, systemd Restart=on-failure). Keyed by lowercased
// email — login attempts happen before we know the team, so this lives at
// the platform layer, not team-scoped.
//
// Lifecycle: incremented on failed login, cleared (deleted) on success.
// `lockedUntil` is set when failedCount crosses the threshold; the gate
// reads `lockedUntil > now()` to refuse without consulting the counter,
// so a successful guess after lockout doesn't quietly let the attacker in.
model LoginAttempt {
  email        String    @id
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  lastFailedAt DateTime  @default(now())

  @@index([lockedUntil])
}

// ---------------------------------------------------------------------------
// Transactional outbox
// ---------------------------------------------------------------------------
//
// Closes the DB-commit → bus.publish window. Two flow patterns:
//
//   1. publish(event)            — fire-and-forget. Writes a row here AND
//      runs in-process subscribers immediately. The row is the durable
//      audit trail; subscribers ran already, so a process crash mid-publish
//      leaves a row marked `publishedAt = null AND failedAt IS NOT NULL`
//      (or `lastError IS NOT NULL`) that the operator can investigate.
//
//   2. publishInTx(tx, event)    — durable. Caller writes this row INSIDE
//      their own $transaction so the outbox INSERT commits atomically with
//      the entity write. The drainer (apps/api/src/events/outbox-drainer.service.ts)
//      polls every poll-interval ms, picks oldest pending rows, marks them
//      `publishedAt` BEFORE dispatching subscribers (at-most-once), and
//      records `lastError` if dispatch throws. Subscribers see the event
//      only AFTER the originating tx commits.
//
// At-most-once on purpose: re-dispatching events would double-fire audit
// rows, duplicate workflow runs, and resend outbound webhooks. The trade-
// off is "lost dispatch on crash is detectable; duplicates are not allowed."
// To go at-least-once, every non-idempotent subscriber would need to track
// `(dispatch_id, side_effect_id)` — deferred.
//
// Retention: published rows accumulate indefinitely for forensic queries.
// A cleanup sweep should DELETE rows where `publishedAt < NOW() - INTERVAL
// '30 days'` once the table gets large; not wired yet (no scale pressure).
model OutboundEvent {
  id     String @id @default(cuid())
  teamId String

  // Domain-event type — e.g. "contact.updated", "conversation.assigned".
  // Stored as a plain string (not enum) so adding a new event type is a
  // code-only change; the table stays stable.
  type    String
  // The full DomainEvent envelope minus the `type` field. Subscribers
  // reconstruct the typed event by combining `type` + `payload`.
  payload Json

  createdAt   DateTime  @default(now())
  // Set when the drainer (or the synchronous publish path) successfully
  // ran all subscribers. Null = pending OR failed (see `failedAt`).
  publishedAt DateTime?
  // Set when dispatch threw. The row is NOT retried — the operator queries
  // failed rows and decides what to do (manual re-publish, drop, or fix
  // the subscriber + bulk re-publish).
  failedAt    DateTime?
  // Truncated error message from the throwing subscriber. NULL when the
  // dispatch succeeded.
  lastError   String?
  // Reserved for future at-least-once mode. Today the drainer increments
  // once on pickup and never retries — so this is always 0 or 1.
  attempts    Int       @default(0)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Drainer hot-path is served by the partial index
  // `OutboundEvent_drainer_pending_idx` (WHERE publishedAt IS NULL AND
  // failedAt IS NULL) added in the init migration's raw-SQL section.
  // No team-id-keyed index here on purpose: the drainer never filters by
  // teamId, and that index was a non-trivial write tax on every publish.
}
